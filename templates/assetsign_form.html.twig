<div class="card">
  <div class="card-body">
    <h2>{{ _n('Attribution', 'Attributions', 1, 'assetsign') }} #{{ item.fields.id }} — {{ types[item.fields.type] }}</h2>

    {# Issue #170 : brouillon pas encore envoye (attribution confirmee plus tard) #}
    {% if item.fields.status == 0 and can_edit_accessories %}
      <div class="alert alert-warning d-flex align-items-center gap-2">
        <i class="ti ti-mail-pause"></i>
        <div class="flex-fill">{{ __('Brouillon : cette feuille n\'a pas encore été envoyée au bénéficiaire. Complétez-la si besoin, puis envoyez-la.', 'assetsign') }}</div>
        <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php" class="d-inline">
          <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="id" value="{{ item.fields.id }}">
          <button type="submit" name="send_draft" class="btn btn-primary btn-sm"><i class="ti ti-send me-1"></i>{{ __('Envoyer pour signature', 'assetsign') }}</button>
          <button type="submit" name="discard_draft" class="btn btn-outline-danger btn-sm">{{ __('Ne pas faire signer', 'assetsign') }}</button>
        </form>
      </div>

      {# Issue #163 : modifier la feuille avant l'envoi #}
      <div class="card mb-3">
        <div class="card-header"><h3 class="card-title"><i class="ti ti-pencil me-1"></i>{{ __('Préparer la feuille avant l\'envoi', 'assetsign') }}</h3></div>
        <div class="card-body">
          <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php" class="row g-3 align-items-end">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="id" value="{{ item.fields.id }}">
            {% if item.fields.beneficiary_type|default(0) == 0 %}
              <div class="col-auto">
                <label class="form-label">{{ __('Bénéficiaire', 'assetsign') }}</label>
                {% do call('User::dropdown', [{'name': 'users_id', 'value': item.fields.users_id, 'right': 'all', 'entity': item.fields.entities_id, 'entity_sons': true, 'display_emptychoice': false}]) %}
              </div>
            {% endif %}
            <div class="col-auto">
              <label class="form-label">{{ __('Modèle de document', 'assetsign') }}</label>
              {% do call('Dropdown::show', ['GlpiPlugin\\Assetsign\\Template', {'name': 'plugin_assetsign_templates_id', 'value': item.fields.plugin_assetsign_templates_id, 'condition': draft_template_condition|default({}), 'entity': item.fields.entities_id, 'entity_sons': true}]) %}
            </div>
            <div class="col-auto">
              <button type="submit" name="update_draft" class="btn btn-secondary">{{ __('Enregistrer', 'assetsign') }}</button>
            </div>
            <div class="col-auto">
              <a class="btn btn-outline-primary" target="_blank" href="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php?id={{ item.fields.id }}&preview_draft=1"><i class="ti ti-eye me-1"></i>{{ __('Aperçu du document', 'assetsign') }}</a>
            </div>
          </form>
          <p class="form-text mb-0 mt-2">{{ __('Le matériel remis avec, les accessoires, les observations, le kit et l\'état des lieux se complètent plus bas sur cette page. Rien n\'est envoyé tant que vous n\'avez pas cliqué sur « Envoyer pour signature ».', 'assetsign') }}</p>
        </div>
      </div>
    {% endif %}

    {# Issue #183 : ticket a l'origine de la remise #}
    {% if linked_ticket|default(null) %}
      <p class="mb-2"><i class="ti ti-ticket me-1"></i>{{ __('Ticket lié :', 'assetsign') }}
        <a href="{{ 'Ticket'|itemtype_form_path(linked_ticket.id) }}">{{ linked_ticket.label }}</a>
      </p>
    {% elseif can_edit_accessories and open_tickets|default({})|length %}
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php" class="row g-2 align-items-end mb-3">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="id" value="{{ item.fields.id }}">
        <div class="col-auto">
          <label class="form-label"><i class="ti ti-ticket me-1"></i>{{ __('Rattacher à un ticket ouvert du bénéficiaire', 'assetsign') }}</label>
          <select name="tickets_id" class="form-select form-select-sm">
            {% for id, label in open_tickets %}<option value="{{ id }}">{{ label }}</option>{% endfor %}
          </select>
        </div>
        <div class="col-auto">
          <button type="submit" name="link_ticket" class="btn btn-sm btn-outline-secondary">{{ __('Rattacher', 'assetsign') }}</button>
        </div>
      </form>
    {% endif %}

    <table class="table table-striped">
      <tr>
        <th>{{ __('Statut', 'assetsign') }}</th>
        <td>{{ statuses[item.fields.status] }}</td>
      </tr>
      <tr>
        <th>{{ __('Matériel', 'assetsign') }}</th>
        <td>{{ item.fields.itemtype }} — {{ target_item.name|default('') }}</td>
      </tr>
      <tr>
        <th>{{ __('Bénéficiaire', 'assetsign') }}</th>
        <td>
          {% set beneficiary_name = (beneficiary.firstname|default('') ~ ' ' ~ beneficiary.realname|default(''))|trim %}
          {{ beneficiary_name is empty ? beneficiary.name|default('') : beneficiary_name }}
          {% if beneficiary.email|default('') is not empty %}({{ beneficiary.email }}){% endif %}
          {% if item.fields.beneficiary_type == 1 %}
            <span class="badge bg-secondary">{{ __('Externe', 'assetsign') }}</span>
          {% endif %}
        </td>
      </tr>
      <tr>
        <th>{{ __('Envoyé le', 'assetsign') }}</th>
        <td>{{ item.fields.date_sent|default('') }}</td>
      </tr>
      <tr>
        <th>{{ __('Consulté le', 'assetsign') }}</th>
        <td>{{ item.fields.date_viewed|default('') }}</td>
      </tr>
      <tr>
        <th>{{ __('Signé le', 'assetsign') }}</th>
        <td>{{ item.fields.date_signed|default('') }}</td>
      </tr>
      <tr>
        <th>{{ __('Nombre de relances', 'assetsign') }}</th>
        <td>{{ reminders }}</td>
      </tr>
      {% if item.fields.document_id_unsigned or item.fields.document_id_signed or item.fields.document_id_cosigned %}
      <tr>
        <th>{{ __('PDF', 'assetsign') }}</th>
        <td>
          {% if item.fields.document_id_cosigned %}
            {# Signatures multiples (issue #143) : PDF final a deux signatures,
               prioritaire sur document_id_signed ci-dessous (qui ne reste alors
               que le PDF intermediaire signe par le seul beneficiaire). #}
            <a href="{{ config('root_doc') }}/front/document.send.php?docid={{ item.fields.document_id_cosigned }}" target="_blank">{{ __('Télécharger (signé et contre-signé)', 'assetsign') }}</a>
          {% elseif item.fields.document_id_signed %}
            <a href="{{ config('root_doc') }}/front/document.send.php?docid={{ item.fields.document_id_signed }}" target="_blank">{{ __('Télécharger (signé)', 'assetsign') }}{{ cosigner_pending ? ' ' ~ __('(bénéficiaire uniquement)', 'assetsign') : '' }}</a>
          {% endif %}
          {% if item.fields.document_id_unsigned %}
            {% if item.fields.document_id_signed or item.fields.document_id_cosigned %} — {% endif %}
            <a href="{{ config('root_doc') }}/front/document.send.php?docid={{ item.fields.document_id_unsigned }}" target="_blank">{{ __('Télécharger (non signé)', 'assetsign') }}</a>
          {% endif %}
        </td>
      </tr>
      {% endif %}
    </table>

    <div class="d-flex gap-2">
      {% if can_remind %}
        <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php">
          <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="id" value="{{ item.fields.id }}">
          <button type="submit" name="relance" class="btn btn-primary">{{ __('Relancer maintenant', 'assetsign') }}</button>
        </form>
      {% endif %}
      {% if can_sign_in_person|default(false) %}
        {# Signature sur place (issue #152) : ouvre la page de signature sur cet ecran, a remettre
           a la personne qui signe (beneficiaire ou son delegue). #}
        <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php">
          <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="id" value="{{ item.fields.id }}">
          <button type="submit" name="sign_in_person" class="btn btn-outline-primary" title="{{ __('Pour une personne qui ne peut pas se connecter à GLPI : elle signe sur cet écran, en votre présence.', 'assetsign') }}">
            <i class="ti ti-device-tablet me-1"></i>{{ __('Faire signer sur place', 'assetsign') }}
          </button>
        </form>
      {% endif %}
      {% if can_edit_accessories %}
        <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php">
          <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="id" value="{{ item.fields.id }}">
          <button type="submit" name="cancel_request" class="btn btn-outline-danger" onclick="return confirm('{{ __('Annuler cette demande de signature ?', 'assetsign')|e('js') }}');">{{ __('Annuler la demande', 'assetsign') }}</button>
        </form>
      {% endif %}
    </div>

    {% if delegate|default(null) %}
      <div class="alert alert-warning mt-4">
        <i class="ti ti-user-share"></i>
        {% set delegate_name = (delegate.firstname|default('') ~ ' ' ~ delegate.realname|default(''))|trim %}
        {{ __('Signature déléguée à', 'assetsign') }} <strong>{{ delegate_name is empty ? delegate.name|default('') : delegate_name }}</strong>
        {{ __('le', 'assetsign') }} {{ item.fields.delegation_date|default('') }}
        {% if item.fields.delegation_reason is defined and item.fields.delegation_reason %}
          — {{ __('motif', 'assetsign') }} : {{ item.fields.delegation_reason }}
        {% endif %}
        {% if can_delegate|default(false) %}
          <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php" class="d-inline">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="id" value="{{ item.fields.id }}">
            <button type="submit" name="revoke_delegation" class="btn btn-sm btn-outline-danger ms-2" onclick="return confirm('{{ __('Révoquer la délégation et rendre la main au bénéficiaire d\'origine ?', 'assetsign')|e('js') }}');">{{ __('Révoquer', 'assetsign') }}</button>
          </form>
        {% endif %}
      </div>
    {% endif %}

    {% if delegation_enabled|default(false) and can_delegate|default(false) %}
      <h3 class="mt-4">{{ __('Déléguer la signature', 'assetsign') }}</h3>
      <p class="text-muted small">{{ __('Désigne un autre compte GLPI pour signer à la place du bénéficiaire d\'origine (absence prolongée, congés, départ...). Le lien de signature envoyé au bénéficiaire d\'origine devient invalide dès la délégation.', 'assetsign') }}</p>
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php" class="row g-2 align-items-end">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="id" value="{{ item.fields.id }}">
        <div class="col-auto">
          <label class="form-label">{{ __('Déléguer à', 'assetsign') }}</label>
          {# cf. sign_page.html.twig : 'right'='all' (pas le defaut 'id',
             limite a l'utilisateur courant) + 'entity' scope au dossier. #}
          {% do call('User::dropdown', [{'name': 'delegate_users_id', 'right': 'all', 'entity': item.fields.entities_id}]) %}
        </div>
        <div class="col-auto">
          <label class="form-label">{{ __('Motif', 'assetsign') }}</label>
          <input type="text" name="delegation_reason" class="form-control">
        </div>
        <div class="col-auto">
          <button type="submit" name="delegate_signature" class="btn btn-secondary">{{ __('Déléguer', 'assetsign') }}</button>
        </div>
      </form>
    {% endif %}

    {% if cosigner %}
      {# Signatures multiples (issue #143) : statut de la contre-signature du
         responsable hierarchique, meme emplacement/style que le bloc
         delegation ci-dessus. #}
      <div class="alert {{ cosigner_pending ? 'alert-info' : 'alert-success' }} mt-4">
        <i class="ti ti-user-check"></i>
        {% set cosigner_name = (cosigner.firstname|default('') ~ ' ' ~ cosigner.realname|default(''))|trim %}
        {% if cosigner_pending %}
          {{ __('En attente de la contre-signature de', 'assetsign') }} <strong>{{ cosigner_name is empty ? cosigner.name|default('') : cosigner_name }}</strong> ({{ __('responsable hiérarchique', 'assetsign') }})
        {% else %}
          {{ __('Contre-signé par', 'assetsign') }} <strong>{{ cosigner_name is empty ? cosigner.name|default('') : cosigner_name }}</strong> ({{ __('responsable hiérarchique', 'assetsign') }})
        {% endif %}
      </div>
    {% endif %}

    {% if signature_proofs|length %}
      <h3 class="mt-4">{{ __('Preuve de signature', 'assetsign') }}</h3>
      {% for proof in signature_proofs %}
        {# Signatures multiples (issue #143) : plusieurs preuves possibles
           (beneficiaire puis responsable) — libelle uniquement affiche quand
           il y en a plus d'une, pour ne rien changer visuellement au cas
           mono-signataire habituel. #}
        {% if signature_proofs|length > 1 %}
          <h4 class="mt-3">{{ loop.first ? __('Bénéficiaire', 'assetsign') : __('Responsable hiérarchique', 'assetsign') }}</h4>
        {% endif %}
        <table class="table table-striped">
          <tr>
            <th>{{ __('Signataire', 'assetsign') }}</th>
            <td>{{ proof.signer_name|default('') }}{% if proof.signer_email|default('') is not empty %} ({{ proof.signer_email }}){% endif %}</td>
          </tr>
          {% if proof.witness_name|default('') is not empty %}
          {# Signature sur place (issue #152) : technicien temoin. #}
          <tr>
            <th>{{ __('Recueillie sur place, en présence de', 'assetsign') }}</th>
            <td><i class="ti ti-device-tablet me-1"></i>{{ proof.witness_name }}</td>
          </tr>
          {% endif %}
          <tr>
            <th>{{ __('Adresse IP', 'assetsign') }}</th>
            <td>{{ proof.ip_address|default('') }}</td>
          </tr>
          <tr>
            <th>{{ __('Navigateur / appareil', 'assetsign') }}</th>
            <td>{{ proof.user_agent|default('') }}</td>
          </tr>
          <tr>
            <th>{{ __('Empreinte du document (SHA-256)', 'assetsign') }}</th>
            <td><code>{{ proof.document_hash|default('') }}</code></td>
          </tr>
          <tr>
            <th>{{ __('Horodatage', 'assetsign') }}</th>
            <td>{{ proof.signed_at|default('') }}</td>
          </tr>
        </table>
      {% endfor %}
      <p class="text-muted small">{{ __('Ces informations sont enregistrées au moment de la signature et permettent, en cas de litige, de vérifier que le PDF signé n\'a pas été modifié depuis (l\'empreinte ci-dessus doit correspondre à celle du fichier).', 'assetsign') }}</p>
    {% endif %}

    {% if item.fields.type == type_vente %}
      <h3 class="mt-4">{{ __('Détails de la vente', 'assetsign') }}</h3>
      {% if vente_details is null %}
        <p class="text-muted small">{{ __('Aucun prix renseigné pour le moment (fiche créée automatiquement) : le PDF ne mentionne pas encore la vente tant que ce prix n\'est pas saisi.', 'assetsign') }}</p>
      {% endif %}
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php" class="row g-2 align-items-end">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="id" value="{{ item.fields.id }}">
        <div class="col-auto">
          <label class="form-label">{{ __('Prix', 'assetsign') }}</label>
          <input type="number" name="price" step="0.01" min="0" class="form-control" style="width: 110px;" value="{{ vente_details.fields.price|default('') }}" {{ can_edit_vente_details ? '' : 'readonly' }}>
        </div>
        <div class="col-auto">
          <label class="form-label">{{ __('Date de vente', 'assetsign') }}</label>
          <input type="date" name="sale_date" class="form-control" value="{{ vente_details.fields.sale_date|default('') }}" {{ can_edit_vente_details ? '' : 'readonly' }}>
        </div>
        {% if can_edit_vente_details %}
          <div class="col-auto">
            <button type="submit" name="update_vente_details" class="btn btn-secondary btn-sm">{{ __('Enregistrer', 'assetsign') }}</button>
          </div>
        {% endif %}
      </form>
    {% endif %}

    {% if item.fields.type == type_don %}
      <h3 class="mt-4">{{ __('Détails du don', 'assetsign') }}</h3>
      {% if don_details is null %}
        <p class="text-muted small">{{ __('Aucun organisme bénéficiaire renseigné pour le moment (fiche créée automatiquement) : le PDF ne le mentionne pas encore tant qu\'il n\'est pas saisi.', 'assetsign') }}</p>
      {% endif %}
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php" class="row g-2 align-items-end">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="id" value="{{ item.fields.id }}">
        <div class="col-auto">
          <label class="form-label">{{ __('Organisme bénéficiaire', 'assetsign') }}</label>
          <input type="text" name="organization_name" class="form-control" value="{{ don_details.fields.organization_name|default('') }}" {{ can_edit_don_details ? '' : 'readonly' }}>
        </div>
        {% if can_edit_don_details %}
          <div class="col-auto">
            <button type="submit" name="update_don_details" class="btn btn-secondary btn-sm">{{ __('Enregistrer', 'assetsign') }}</button>
          </div>
        {% endif %}
      </form>
    {% endif %}

    {% if item.fields.type == type_destruction %}
      <h3 class="mt-4">{{ __('Détails de la destruction', 'assetsign') }}</h3>
      {% if destruction_details is null %}
        <p class="text-muted small">{{ __('Aucun prestataire renseigné pour le moment (fiche créée automatiquement) : le PDF ne le mentionne pas encore tant qu\'il n\'est pas saisi.', 'assetsign') }}</p>
      {% endif %}
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php" class="row g-2 align-items-end">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="id" value="{{ item.fields.id }}">
        <div class="col-auto">
          <label class="form-label">{{ __('Prestataire', 'assetsign') }}</label>
          <input type="text" name="provider_name" class="form-control" value="{{ destruction_details.fields.provider_name|default('') }}" {{ can_edit_destruction_details ? '' : 'readonly' }}>
        </div>
        {% if can_edit_destruction_details %}
          <div class="col-auto">
            <button type="submit" name="update_destruction_details" class="btn btn-secondary btn-sm">{{ __('Enregistrer', 'assetsign') }}</button>
          </div>
        {% endif %}
      </form>
    {% endif %}

    {% if attached_documents|length %}
      <h3 class="mt-4">{{ __('Documents joints', 'assetsign') }}</h3>
      <ul>
        {% for doc in attached_documents %}
          <li><a href="{{ config('root_doc') }}/front/document.send.php?docid={{ doc.id }}" target="_blank">{{ doc.name }}</a></li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if observations_enabled %}
      <h3 class="mt-4">{{ __('Observations', 'assetsign') }}</h3>
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="id" value="{{ item.fields.id }}">
        <div class="mb-2">
          <textarea name="observations" class="form-control" rows="3" {{ can_edit_accessories ? '' : 'readonly' }}>{{ item.fields.observations|default('') }}</textarea>
        </div>
        {% if can_edit_accessories %}
          <button type="submit" name="update_observations" class="btn btn-secondary btn-sm">{{ __('Enregistrer', 'assetsign') }}</button>
        {% endif %}
      </form>
    {% endif %}

    {% if item.fields.beneficiary_comment is defined and item.fields.beneficiary_comment %}
      <h3 class="mt-4">{{ __('Remarque du bénéficiaire', 'assetsign') }}</h3>
      <p class="text-muted" style="white-space: pre-line;">{{ item.fields.beneficiary_comment }}</p>
    {% endif %}

    {% if damage_annotation_enabled %}
      <h3 class="mt-4">{{ __('État des lieux visuel', 'assetsign') }}</h3>
      <p class="text-muted small">{{ __('Cliquez sur une vue pour y déposer un repère de dommage ; cliquez sur un repère existant pour le décrire ou le supprimer, glissez-le pour le repositionner.', 'assetsign') }}</p>
      <div class="damage-view-grid">
        {% for index, label in damage_views %}
          <div>
            <div class="damage-view" data-assetsign-id="{{ item.fields.id }}" data-view-index="{{ index }}" data-editable="{{ can_edit_damage_markers ? '1' : '0' }}">
              <img class="damage-view-img" src="{{ config('root_doc') }}/plugins/assetsign/images/damage-views/{{ damage_images[index] }}" alt="{{ label }}">
              {% for marker in damage_markers_by_view[index]|default([]) %}
                <div class="damage-marker{{ marker.severity == 1 ? ' damage-marker-major' : '' }}"
                     data-id="{{ marker.id }}"
                     style="left: {{ marker.x_percent }}%; top: {{ marker.y_percent }}%;"
                     title="{{ marker.description|default('') }}"></div>
              {% endfor %}
            </div>
            <div class="damage-view-label">{{ label }}</div>
          </div>
        {% endfor %}
      </div>
      {% if can_edit_damage_markers %}
        <script>
          window.ASSETSIGN_ROOT_DOC = {{ config('root_doc')|json_encode|raw }};
          window.ASSETSIGN_DAMAGE_CSRF = {{ csrf_token|json_encode|raw }};
          window.ASSETSIGN_DAMAGE_I18N = {
            description: {{ __('Description', 'assetsign')|json_encode|raw }},
            severity: {{ __('Gravité', 'assetsign')|json_encode|raw }},
            minor: {{ __('Mineure', 'assetsign')|json_encode|raw }},
            major: {{ __('Majeure', 'assetsign')|json_encode|raw }},
            save: {{ __('Enregistrer', 'assetsign')|json_encode|raw }},
            deleteLabel: {{ __('Supprimer', 'assetsign')|json_encode|raw }},
            errorPrefix: {{ __('Erreur', 'assetsign')|json_encode|raw }},
            networkError: {{ __('Erreur réseau, merci de réessayer.', 'assetsign')|json_encode|raw }}
          };
        </script>
        <script src="{{ config('root_doc') }}/plugins/assetsign/js/sign/csrf-queue.js?v={{ constant('PLUGIN_ASSETSIGN_VERSION') }}"></script>
        <script src="{{ config('root_doc') }}/plugins/assetsign/js/sign/damage-annotation.js?v={{ constant('PLUGIN_ASSETSIGN_VERSION') }}"></script>
      {% endif %}
    {% endif %}

    {% if checklist_results|length or checklist_items|length %}
      <h3 class="mt-4">{{ __('Contrôle qualité', 'assetsign') }}</h3>
      {% if checklist_results|length %}
        <ul>
          {% for result in checklist_results %}
            <li>
              <i class="ti ti-circle-check text-success"></i>
              {{ result.name }}{% if result.value is not null and result.value != '' %} : {{ result.value }}{% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if can_edit_checklist and checklist_items|length %}
        <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php">
          <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="id" value="{{ item.fields.id }}">
          {% for id, checklistItem in checklist_items %}
            <div class="mb-2">
              {% if checklistItem.type == 0 %}
                <div class="form-check">
                  <input type="checkbox" name="checklist[{{ id }}]" value="1" class="form-check-input" id="assetsign_checklist_{{ id }}" {{ checklist_values[id] is defined ? 'checked' : '' }}>
                  <label class="form-check-label" for="assetsign_checklist_{{ id }}">{{ checklistItem.name }}</label>
                </div>
              {% elseif checklistItem.type == 1 %}
                <label class="form-label" for="assetsign_checklist_{{ id }}">{{ checklistItem.name }}</label>
                <input type="text" name="checklist[{{ id }}]" class="form-control" id="assetsign_checklist_{{ id }}" value="{{ checklist_values[id]|default('') }}">
              {% elseif checklistItem.type == 2 %}
                <label class="form-label" for="assetsign_checklist_{{ id }}">{{ checklistItem.name }}</label>
                <select name="checklist[{{ id }}]" class="form-select" id="assetsign_checklist_{{ id }}">
                  <option value="">-----</option>
                  {% for opt in checklistItem.options %}
                    <option value="{{ opt }}" {{ checklist_values[id]|default('') == opt ? 'selected' : '' }}>{{ opt }}</option>
                  {% endfor %}
                </select>
              {% endif %}
            </div>
          {% endfor %}
          <button type="submit" name="submit_checklist" class="btn btn-secondary btn-sm">{{ __('Enregistrer', 'assetsign') }}</button>
        </form>
      {% elseif checklist_results|length == 0 %}
        <p class="text-muted">{{ __('Aucun point de contrôle configuré pour ce type de mouvement (Configuration > Intitulés > Points de contrôle qualité).', 'assetsign') }}</p>
      {% endif %}
    {% endif %}

    {% if item.fields.type == type_handover or item.fields.type == type_return %}
      <h3 class="mt-4">{{ __('Kit d\'accessoires', 'assetsign') }}</h3>
      <p>
        {% if kit is not null %}
          {{ __('Kit assigné :', 'assetsign') }} <strong>{{ kit.fields.name }}</strong>
        {% else %}
          <span class="text-muted">{{ __('Aucun kit assigné pour le moment.', 'assetsign') }}</span>
        {% endif %}
      </p>
      {% if kit_completeness is not null %}
        <div class="mb-2">
          <span class="badge" style="background-color: {{ kit_completeness.color }}; color: #fff;">
            <i class="ti ti-package"></i> {{ kit_completeness.returned_count }}/{{ kit_completeness.expected_total }} {{ __('accessoires du kit restitués', 'assetsign') }}
          </span>
          {% if kit_completeness.missing_names|length %}
            <div class="text-muted small">{{ __('Accessoire(s) manquant(s) :', 'assetsign') }} {{ kit_completeness.missing_names|join(', ') }}</div>
          {% endif %}
        </div>
      {% endif %}
      {{ include('@assetsign/_kit_item_lines.html.twig', {'can_edit': can_edit_accessories, 'reopen': false}) }}
      {% if can_edit_accessories %}
        <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php" class="row g-2 align-items-end">
          <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="id" value="{{ item.fields.id }}">
          <div class="col-auto">
            <label class="form-label">{{ __('Assigner / changer le kit', 'assetsign') }}</label>
            {% do call('GlpiPlugin\\Assetsign\\Kit::dropdown', [{'name': 'plugin_assetsign_kits_id', 'value': item.fields.plugin_assetsign_kits_id, 'display_emptychoice': true}]) %}
          </div>
          <div class="col-auto">
            <button type="submit" name="update_kit" class="btn btn-secondary btn-sm">{{ __('Enregistrer', 'assetsign') }}</button>
          </div>
        </form>
      {% endif %}
    {% endif %}

    <h3 class="mt-4">{{ __('Accessoires remis', 'assetsign') }}</h3>
    {% if accessories|length %}
      <table class="table table-sm">
        <thead>
          <tr>
            <th>{{ __('Accessoire', 'assetsign') }}</th>
            <th>{{ __('Quantité', 'assetsign') }}</th>
            <th>{{ __('Commentaire', 'assetsign') }}</th>
            {% if can_edit_accessories %}<th></th>{% endif %}
          </tr>
        </thead>
        <tbody>
          {% for a in accessories %}
            <tr>
              <td>{{ a.name }}</td>
              <td>{{ a.quantity }}</td>
              <td>{{ a.comment|default('') }}</td>
              {% if can_edit_accessories %}
                <td>
                  <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php" class="d-inline">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="id" value="{{ item.fields.id }}">
                    <input type="hidden" name="plugin_assetsign_accessories_id" value="{{ a.accessories_id }}">
                    <button type="submit" name="remove_accessory" class="btn btn-sm btn-outline-danger">{{ __('Retirer', 'assetsign') }}</button>
                  </form>
                </td>
              {% endif %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p class="text-muted">{{ __('Aucun accessoire remis pour le moment.', 'assetsign') }}</p>
    {% endif %}

    {% if can_edit_accessories %}
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php" class="row g-2 align-items-end">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="id" value="{{ item.fields.id }}">
        <div class="col-auto">
          <label class="form-label">{{ __('Ajouter un accessoire', 'assetsign') }}</label>
          {% do call('GlpiPlugin\\Assetsign\\Accessory::dropdown', [{'name': 'plugin_assetsign_accessories_id'}]) %}
        </div>
        <div class="col-auto">
          <label class="form-label">{{ __('Quantité', 'assetsign') }}</label>
          <input type="number" name="quantity" value="1" min="1" class="form-control" style="width: 90px;">
        </div>
        <div class="col-auto">
          <label class="form-label">{{ __('Commentaire', 'assetsign') }}</label>
          <input type="text" name="comment" class="form-control">
        </div>
        <div class="col-auto">
          <button type="submit" name="add_accessory" class="btn btn-secondary">{{ __('Ajouter', 'assetsign') }}</button>
        </div>
      </form>
    {% endif %}

    {# Issue #166 : objets du parc GLPI remis avec le materiel, n° de serie et modele repris sur le PDF #}
    <h3 class="mt-4"><i class="ti ti-devices me-1"></i>{{ __('Matériel inventorié remis avec', 'assetsign') }}</h3>
    <p class="text-muted small">{{ __('Écrans, stations d\'accueil, téléphones… déjà inventoriés dans GLPI : leur modèle, leur n° de série et leur n° d\'inventaire sont repris sur le document, sans ressaisie.', 'assetsign') }}</p>
    {% if inventoried_items|default([])|length %}
      <table class="table table-sm">
        <thead>
          <tr>
            <th>{{ __('Type', 'assetsign') }}</th>
            <th>{{ __('Nom', 'assetsign') }}</th>
            <th>{{ __('Marque / modèle', 'assetsign') }}</th>
            <th>{{ __('N° de série', 'assetsign') }}</th>
            <th>{{ __('N° d\'inventaire', 'assetsign') }}</th>
            {% if can_edit_accessories %}<th></th>{% endif %}
          </tr>
        </thead>
        <tbody>
          {% for i in inventoried_items %}
            <tr>
              <td>{{ i.type_label }}</td>
              <td>
                <a href="{{ i.itemtype|itemtype_form_path(i.items_id) }}">{{ i.name|default('#' ~ i.items_id) }}</a>
                {% if i.is_automatic %}
                  <span class="badge bg-blue-lt ms-1" title="{{ __('Ajouté automatiquement : connecté au matériel dans GLPI', 'assetsign') }}"><i class="ti ti-plug-connected"></i> {{ __('Connecté', 'assetsign') }}</span>
                {% endif %}
                {% if i.assigned_to_other %}
                  <span class="badge bg-orange-lt ms-1" title="{{ __('Dans GLPI, cet élément est affecté à une autre personne que le bénéficiaire.', 'assetsign') }}"><i class="ti ti-alert-triangle"></i> {{ __('Affecté à %s', 'assetsign')|format(i.assigned_to_other) }}</span>
                {% endif %}
              </td>
              <td>{{ [i.manufacturer, i.model]|filter(v => v)|join(' ')|default('-') }}</td>
              <td>{{ i.serial|default('-') }}</td>
              <td>{{ i.otherserial|default('-') }}</td>
              {% if can_edit_accessories %}
                <td>
                  <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php" class="d-inline">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="id" value="{{ item.fields.id }}">
                    <input type="hidden" name="assetsignitems_id" value="{{ i.id }}">
                    <button type="submit" name="remove_inventoried_item" class="btn btn-sm btn-outline-danger">{{ __('Retirer', 'assetsign') }}</button>
                  </form>
                </td>
              {% endif %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p class="text-muted">{{ __('Aucun matériel inventorié ajouté pour le moment.', 'assetsign') }}</p>
    {% endif %}

    {# Issue #178 : controle du retour, element par element (feuilles de restitution) #}
    {% if is_return|default(false) and inventoried_items|default([])|length %}
      {% set state_badges = {0: 'bg-secondary-lt', 1: 'bg-green-lt', 2: 'bg-red-lt', 3: 'bg-orange-lt'} %}
      <div class="card mt-3 mb-3">
        <div class="card-header"><h4 class="card-title"><i class="ti ti-checklist me-1"></i>{{ __('Contrôle du retour', 'assetsign') }}</h4></div>
        <div class="card-body">
          <p class="text-muted small">{{ __('Indiquez pour chaque élément s\'il est rendu, manquant ou abîmé : l\'état figure sur le document, et GLPI est mis à jour à l\'enregistrement (élément rendu ou abîmé : plus d\'utilisateur et statut configuré ; élément manquant : ticket si l\'option est active).', 'assetsign') }}</p>
          <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="id" value="{{ item.fields.id }}">
            <table class="table table-sm table-vcenter">
              <thead>
                <tr>
                  <th>{{ __('Élément', 'assetsign') }}</th>
                  <th>{{ __('État au retour', 'assetsign') }}</th>
                  <th>{{ __('Commentaire', 'assetsign') }}</th>
                </tr>
              </thead>
              <tbody>
                {% for i in inventoried_items %}
                  <tr>
                    <td>{{ i.type_label }} — {{ i.name|default('#' ~ i.items_id) }}{% if i.serial %} <span class="text-muted small">({{ i.serial }})</span>{% endif %}</td>
                    <td>
                      {% if can_edit_accessories %}
                        <select name="return_state[{{ i.id }}]" class="form-select form-select-sm">
                          {% for value, label in return_states|default({}) %}
                            <option value="{{ value }}" {{ i.return_state|default(0) == value ? 'selected' : '' }}>{{ label }}</option>
                          {% endfor %}
                        </select>
                      {% else %}
                        <span class="badge {{ state_badges[i.return_state|default(0)] }}">{{ return_states[i.return_state|default(0)] }}</span>
                      {% endif %}
                    </td>
                    <td>
                      {% if can_edit_accessories %}
                        <input type="text" name="return_comment[{{ i.id }}]" class="form-control form-control-sm" value="{{ i.return_comment|default('') }}" maxlength="255">
                      {% else %}
                        {{ i.return_comment|default('') }}
                      {% endif %}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
            {% if can_edit_accessories %}
              <button type="submit" name="save_return_check" class="btn btn-primary btn-sm"><i class="ti ti-device-floppy me-1"></i>{{ __('Enregistrer le contrôle du retour', 'assetsign') }}</button>
            {% endif %}
          </form>
        </div>
      </div>
    {% endif %}

    {% if can_edit_accessories and suggested_items|default([])|length %}
      <div class="alert alert-info">
        <div class="d-flex align-items-start">
          <i class="ti ti-plug-connected me-2 mt-1"></i>
          <div class="flex-fill">
            <strong>{{ __('Connecté à ce matériel dans GLPI', 'assetsign') }}</strong>
            <ul class="mb-2">
              {% for s in suggested_items %}
                <li>{{ s.type_label }} — {{ s.name|default('#' ~ s.items_id) }}{% if s.serial %} ({{ __('N° de série', 'assetsign') }} {{ s.serial }}){% endif %}</li>
              {% endfor %}
            </ul>
            <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php" class="d-inline">
              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
              <input type="hidden" name="id" value="{{ item.fields.id }}">
              <button type="submit" name="add_connected_items" class="btn btn-sm btn-primary"><i class="ti ti-plus me-1"></i>{{ __('Ajouter les éléments connectés', 'assetsign') }}</button>
            </form>
          </div>
        </div>
      </div>
    {% endif %}

    {% if can_edit_accessories %}
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php" class="row g-2 align-items-end">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="id" value="{{ item.fields.id }}">
        <div class="col-12"><label class="form-label mb-0">{{ __('Ajouter un élément du parc', 'assetsign') }}</label></div>
        {{ include('@assetsign/_available_item_picker.html.twig') }}
        <div class="col-auto">
          <button type="submit" name="add_inventoried_item" class="btn btn-secondary">{{ __('Ajouter', 'assetsign') }}</button>
        </div>
      </form>
    {% endif %}
  </div>
</div>
