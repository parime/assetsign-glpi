<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ __('Étiquette QR code', 'assetsign') }} — {{ item_name }}</title>
<style>
  :root{ --ink:#16232f; --ink-soft:#5a6b78; --accent:#0d7a6e; --line:#d6dbd4; --paper:#f5f7f5; }
  *{box-sizing:border-box;}
  body{ margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; background:var(--paper); color:var(--ink); }
  .wrap{ max-width:420px; margin:0 auto; padding:24px 16px 48px; text-align:center; }
  .label-card{ background:#fff; border:1px solid var(--line); border-radius:8px; padding:24px; margin:0 auto 20px; }
  .label-card img{ max-width:220px; width:100%; height:auto; }
  .itemtype{ color:var(--ink-soft); font-size:.82rem; text-transform:uppercase; letter-spacing:.04em; margin:0 0 4px; }
  h1{ font-size:1.15rem; margin:0 0 4px; word-break:break-word; }
  p.serial{ color:var(--ink-soft); font-size:.9rem; margin:0 0 16px; }
  .qr-missing{ color:#b7472a; font-size:.9rem; padding:40px 8px; }
  .actions{ margin-top:4px; }
  button{ font:inherit; padding:10px 20px; border-radius:6px; border:1px solid var(--line); background:#fff; cursor:pointer; }
  button.primary{ background:var(--accent); color:#fff; border-color:var(--accent); }
  .debug-url{ margin-top:14px; font-size:.72rem; color:var(--ink-soft); word-break:break-all; }
  @media print {
    body{ background:#fff; }
    .no-print{ display:none !important; }
    .wrap{ padding:0; max-width:none; }
    .label-card{ border:none; padding:0; }
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="label-card">
    <p class="itemtype">{{ itemtype_label }}</p>
    <h1>{{ item_name|default(__('Matériel', 'assetsign')) }}</h1>
    {% if item_serial %}<p class="serial">{{ __('N° série', 'assetsign') }} : {{ item_serial }}</p>{% endif %}
    {% if qr_data_uri %}
      <img src="{{ qr_data_uri }}" alt="{{ __('QR code du matériel', 'assetsign') }}">
    {% else %}
      <p class="qr-missing">{{ __('QR code indisponible sur cet environnement.', 'assetsign') }}</p>
    {% endif %}
  </div>
  <div class="actions no-print">
    <button type="button" class="primary" onclick="window.print()">{{ __('Imprimer', 'assetsign') }}</button>
  </div>
  {# Non imprime : uniquement pour verifier/deboguer le lien reellement encode
     dans le QR code depuis cette page (ex: verification manuelle avant de coller
     l'etiquette), jamais destine a etre lu par la personne qui scanne. #}
  <p class="debug-url no-print">{{ target_url }}</p>
</div>
</body>
</html>
