{# Issue #322 : onglet « Effacement des données » du matériel : attestations et création. #}
<div class="card">
  <div class="card-body">
    {% if requirement_mode > 0 and required_types is not empty %}
      <div class="alert {{ valid_id ? 'alert-success' : (requirement_mode == 2 ? 'alert-danger' : 'alert-warning') }} d-flex gap-2 align-items-start">
        <i class="ti {{ valid_id ? 'ti-shield-check' : 'ti-alert-triangle' }} fs-2"></i>
        <div>
          <div class="fw-bold">
            {% if valid_id %}
              {{ __('Attestation valable : ce matériel peut sortir.', 'assetsign') }}
            {% elseif requirement_mode == 2 %}
              {{ __('Attestation exigée avant la sortie de ce matériel.', 'assetsign') }}
            {% else %}
              {{ __('Attestation recommandée avant la sortie de ce matériel.', 'assetsign') }}
            {% endif %}
          </div>
          <div class="small">{{ __('Concerne : %s.', 'assetsign')|format(required_types|join(', ')) }}</div>
        </div>
      </div>
    {% endif %}

    {% if attestations is empty %}
      <div class="empty py-3">
        <div class="empty-icon"><i class="ti ti-eraser fs-1 text-secondary"></i></div>
        <p class="empty-title">{{ __('Aucune attestation d\'effacement pour ce matériel.', 'assetsign') }}</p>
        <p class="empty-subtitle text-secondary">{{ __('Avant de donner, vendre, détruire ou réattribuer ce matériel, effacez ses données puis enregistrez ici comment cela a été fait.', 'assetsign') }}</p>
      </div>
    {% else %}
      <table class="table table-striped table-vcenter">
        <thead>
          <tr>
            <th>{{ __('Date de l\'effacement', 'assetsign') }}</th>
            <th>{{ __('Méthode', 'assetsign') }}</th>
            <th>{{ __('Vérification', 'assetsign') }}</th>
            <th>{{ __('Technicien', 'assetsign') }}</th>
            <th>{{ __('Statut', 'assetsign') }}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for a in attestations %}
            <tr>
              <td>{{ a.date_wipe|formatted_datetime }}</td>
              <td>{{ a.method_label }}{% if a.level_label %}<div class="text-secondary small">{{ a.level_label }}</div>{% endif %}</td>
              <td><span class="badge" style="background-color: {{ a.result_color }}; color: #fff;">{{ a.result_label }}</span></td>
              <td>{{ a.technician }}</td>
              <td>
                {% if a.is_cancelled %}
                  <span class="badge bg-secondary-lt"><i class="ti ti-ban me-1"></i>{{ __('Annulée', 'assetsign') }}</span>
                {% elseif a.id == valid_id %}
                  <span class="badge bg-green-lt"><i class="ti ti-shield-check me-1"></i>{{ __('Valable', 'assetsign') }}</span>
                {% else %}
                  <span class="badge bg-orange-lt">{{ __('Plus valable (matériel remis depuis, ou échec)', 'assetsign') }}</span>
                {% endif %}
              </td>
              <td class="text-nowrap">
                <a href="{{ config('root_doc') }}/plugins/assetsign/front/wipeattestation.form.php?id={{ a.id }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-eye me-1"></i>{{ __('Voir', 'assetsign') }}</a>
                {% if a.documents_id %}
                  <a href="{{ config('root_doc') }}/front/document.send.php?docid={{ a.documents_id }}" target="_blank" class="btn btn-sm btn-outline-primary"><i class="ti ti-file-type-pdf me-1"></i>PDF</a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}

    {% if can_create %}
      <hr>
      <h3><i class="ti ti-eraser me-2"></i>{{ __('Nouvelle attestation d\'effacement', 'assetsign') }}</h3>
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/wipeattestation.form.php" enctype="multipart/form-data" id="assetsign-wipe-new">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="itemtype" value="{{ item.getType() }}">
        <input type="hidden" name="items_id" value="{{ item.getID() }}">

        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label" for="assetsign-wipe-date">{{ __('Date de l\'effacement', 'assetsign') }}</label>
            <input type="datetime-local" name="date_wipe" id="assetsign-wipe-date" class="form-control" value="{{ now }}" max="{{ now }}" required>
          </div>
          <div class="col-md-8">
            <label class="form-label" for="assetsign-wipe-method">{{ __('Méthode', 'assetsign') }} <span class="text-danger">*</span></label>
            <select name="method" id="assetsign-wipe-method" class="form-select" required>
              <option value="">{{ __('Choisissez la méthode utilisée', 'assetsign') }}</option>
              {% for key, label in method_labels %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="assetsign-wipe-level">{{ __('Norme suivie', 'assetsign') }}</label>
            <select name="nist_level" id="assetsign-wipe-level" class="form-select">
              {% for key, label in level_labels %}<option value="{{ key }}">{{ label }}{% if level_help[key] is defined %} - {{ level_help[key] }}{% endif %}</option>{% endfor %}
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="assetsign-wipe-tool">{{ __('Outil utilisé', 'assetsign') }}</label>
            <input type="text" name="tool" id="assetsign-wipe-tool" class="form-control" maxlength="255" placeholder="{{ __('Ex. nom et version du logiciel d\'effacement', 'assetsign') }}">
          </div>
        </div>

        <div class="mt-3">
          <label class="form-label">{{ __('Supports effacés', 'assetsign') }} <span class="text-danger">*</span></label>
          {% if inventory_media is empty %}
            <p class="text-secondary small mb-1"><i class="ti ti-info-circle me-1"></i>{{ __('Aucun disque ni volume dans l\'inventaire de ce matériel : décrivez les supports ci-dessous.', 'assetsign') }}</p>
          {% else %}
            {% for m in inventory_media %}
              <label class="form-check">
                <input type="checkbox" class="form-check-input" name="media[]" value="{{ m.key }}" checked>
                <span class="form-check-label">
                  <i class="ti {{ m.kind == 'drive' ? 'ti-device-sd-card' : 'ti-folders' }} me-1"></i>{{ m.label }}
                  {% if m.serial %}<span class="text-secondary"> - {{ __('N° de série', 'assetsign') }} {{ m.serial }}</span>{% endif %}
                  {% if m.capacity %}<span class="text-secondary"> - {{ m.capacity }}</span>{% endif %}
                  {% if m.encryption %}<span class="badge bg-secondary-lt ms-1">{{ m.encryption }}</span>{% endif %}
                </span>
              </label>
            {% endfor %}
          {% endif %}
          <textarea name="media_other" class="form-control mt-1" rows="2" placeholder="{{ __('Autres supports, un par ligne (ex. mémoire interne du téléphone, clé USB n° de série...)', 'assetsign') }}"></textarea>
        </div>

        <div class="mt-3">
          <label class="form-label">{{ __('Résultat de la vérification', 'assetsign') }}</label>
          <div class="btn-group flex-wrap" role="group">
            {% for key, label in result_labels %}
              <input type="radio" class="btn-check" name="verification_result" value="{{ key }}" id="assetsign-wipe-result-{{ key }}" autocomplete="off" {{ key == 1 ? 'checked' : '' }}>
              <label class="btn btn-outline-{{ key == 1 ? 'success' : (key == 2 ? 'danger' : 'warning') }}" for="assetsign-wipe-result-{{ key }}">{{ label }}</label>
            {% endfor %}
          </div>
          <div class="form-hint">{{ __('Une attestation en échec est conservée mais ne permet pas la sortie du matériel.', 'assetsign') }}</div>
        </div>

        <div class="row g-3 mt-1">
          <div class="col-md-6">
            <label class="form-label" for="assetsign-wipe-report"><i class="ti ti-paperclip me-1"></i>{{ __('Rapport de l\'outil (facultatif)', 'assetsign') }}</label>
            <input type="file" name="report" id="assetsign-wipe-report" class="form-control" accept="{{ report_accept }}">
            <div class="form-hint">{{ __('Joint au matériel ; son empreinte SHA-256 figure sur l\'attestation.', 'assetsign') }}</div>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="assetsign-wipe-comment">{{ __('Commentaire', 'assetsign') }}</label>
            <textarea name="comment" id="assetsign-wipe-comment" class="form-control" rows="2"></textarea>
          </div>
        </div>

        <div class="mt-3">
          {% include '@assetsign/technician_signature_edit.html.twig' %}
        </div>

        <button type="submit" name="create" value="1" class="btn btn-primary"><i class="ti ti-writing-sign me-1"></i>{{ __('Signer et enregistrer l\'attestation', 'assetsign') }}</button>
      </form>
    {% endif %}
  </div>
</div>
