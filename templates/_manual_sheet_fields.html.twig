{# Champs de création d'une fiche à déclenchement manuel (don, vente, destruction) : bénéficiaire, puis
   champs propres au type, chacun taggé assetsign-manual-<type>-field et masqué tant que le type
   n'est pas choisi. Partagé par l'onglet du matériel et la page Nouvelle attribution (issue #282).
   Paramètre : entities_id (entité du matériel, pour la liste des destinataires). #}
<div class="col-12">
  <label class="form-label">{{ __('Bénéficiaire', 'assetsign') }}</label>
  <div class="btn-group" role="group">
    <input type="radio" class="btn-check" name="beneficiary_type" id="assetsign-beneficiary-internal" value="0" checked autocomplete="off">
    <label class="btn btn-outline-secondary" for="assetsign-beneficiary-internal">{{ __('Interne (compte GLPI)', 'assetsign') }}</label>
    <input type="radio" class="btn-check" name="beneficiary_type" id="assetsign-beneficiary-external" value="1" autocomplete="off">
    <label class="btn btn-outline-secondary" for="assetsign-beneficiary-external">{{ __('Externe', 'assetsign') }}</label>
  </div>
</div>

<div class="col-auto assetsign-manual-internal-field">
  <label class="form-label">{{ __('Destinataire', 'assetsign') }}</label>
  {# 'right': 'all' (pas le defaut 'id', qui ne liste QUE l'utilisateur
     courant - meme bug/correctif que la delegation de signature,
     cf. assetsign_form.html.twig/sign_page.html.twig et issue #115)
     + 'entity' scope au materiel concerne. #}
  {% do call('User::dropdown', [{'name': 'users_id', 'right': 'all', 'entity': entities_id}]) %}
</div>
<div class="col-auto assetsign-manual-external-field" style="display: none;">
  <label class="form-label" for="assetsign-manual-sheet-fields-external-name">{{ __('Nom du bénéficiaire externe', 'assetsign') }}</label>
  <input id="assetsign-manual-sheet-fields-external-name" type="text" name="external_name" class="form-control" placeholder="{{ __('Ex. Association Locale, Jean Dupont...', 'assetsign') }}">
</div>
<div class="col-auto assetsign-manual-external-field" style="display: none;">
  <label class="form-label" for="assetsign-manual-sheet-fields-external-contact">{{ __('Contact (facultatif)', 'assetsign') }}</label>
  <input id="assetsign-manual-sheet-fields-external-contact" type="text" name="external_contact" class="form-control" placeholder="{{ __('E-mail ou téléphone', 'assetsign') }}">
</div>

<div class="col-auto assetsign-manual-type-field assetsign-manual-vente-field" style="display: none;">
  <label class="form-label" for="assetsign-manual-sheet-fields-price">{{ __('Prix', 'assetsign') }}</label>
  <input id="assetsign-manual-sheet-fields-price" type="number" name="price" step="0.01" min="0" class="form-control" style="width: 110px;">
</div>
<div class="col-auto assetsign-manual-type-field assetsign-manual-vente-field" style="display: none;">
  <label class="form-label" for="assetsign-manual-sheet-fields-sale-date">{{ __('Date de vente', 'assetsign') }}</label>
  <input id="assetsign-manual-sheet-fields-sale-date" type="date" name="sale_date" class="form-control">
</div>

<div class="col-auto assetsign-manual-type-field assetsign-manual-don-field" style="display: none;">
  <label class="form-label" for="assetsign-manual-sheet-fields-organization-name">{{ __('Organisme bénéficiaire', 'assetsign') }}</label>
  <input id="assetsign-manual-sheet-fields-organization-name" type="text" name="organization_name" class="form-control" placeholder="{{ __('Ex. Association Locale...', 'assetsign') }}">
</div>
<div class="col-auto assetsign-manual-type-field assetsign-manual-don-field" style="display: none;">
  <label class="form-label" for="assetsign-manual-sheet-fields-justificatif">{{ __('Justificatif (facultatif)', 'assetsign') }}</label>
  <input id="assetsign-manual-sheet-fields-justificatif" type="file" name="justificatif" class="form-control">
</div>

<div class="col-auto assetsign-manual-type-field assetsign-manual-destruction-field" style="display: none;">
  <label class="form-label" for="assetsign-manual-sheet-fields-provider-name">{{ __('Prestataire', 'assetsign') }}</label>
  <input id="assetsign-manual-sheet-fields-provider-name" type="text" name="provider_name" class="form-control" placeholder="{{ __('Ex. Prestataire Exemple SAS...', 'assetsign') }}">
</div>
<div class="col-auto assetsign-manual-type-field assetsign-manual-destruction-field" style="display: none;">
  <label class="form-label" for="assetsign-manual-sheet-fields-certificat">{{ __('Certificat de destruction (facultatif)', 'assetsign') }}</label>
  <input id="assetsign-manual-sheet-fields-certificat" type="file" name="certificat" class="form-control">
</div>
