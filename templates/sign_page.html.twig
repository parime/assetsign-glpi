<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title|default('Signature de remise de matériel') }}</title>
<style>
  :root{ --ink:#16232f; --ink-soft:#5a6b78; --accent:#0d7a6e; --line:#d6dbd4; --paper:#f5f7f5; }
  *{box-sizing:border-box;}
  body{ margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; background:var(--paper); color:var(--ink); }
  .wrap{ max-width:820px; margin:0 auto; padding:24px 16px 64px; }
  header{ margin-bottom:20px; }
  header h1{ font-size:1.3rem; margin:0 0 4px; }
  header p{ color:var(--ink-soft); margin:0; font-size:.92rem; }
  .card{ background:#fff; border:1px solid var(--line); border-radius:8px; padding:20px; margin-bottom:20px; }
  .error{ border-color:#b7472a; color:#b7472a; }
  #pdf-container{ border:1px solid var(--line); border-radius:6px; overflow-y:auto; max-height:60vh; background:#eee; text-align:center; }
  #pdf-container canvas{ max-width:100%; margin:8px auto; display:block; box-shadow:0 1px 4px rgba(0,0,0,.15); }
  .sign-zone{ margin-top:16px; }
  #signature-pad{ border:1px dashed var(--ink-soft); border-radius:6px; width:100%; height:180px; touch-action:none; background:#fff; }
  .actions{ display:flex; gap:10px; margin-top:14px; flex-wrap:wrap; }
  button{ font:inherit; padding:10px 18px; border-radius:6px; border:1px solid var(--line); background:#fff; cursor:pointer; }
  button.primary{ background:var(--accent); color:#fff; border-color:var(--accent); }
  button.danger{ background:#fff; color:#b7472a; border-color:#b7472a; }
  button:disabled{ opacity:.5; cursor:not-allowed; }
  label.consent{ display:flex; gap:8px; align-items:flex-start; font-size:.88rem; color:var(--ink-soft); margin-top:14px; }
  #status-msg{ margin-top:14px; font-size:.9rem; }
  .card h2{ font-size:1rem; margin:0 0 6px; }
  .card p.hint{ color:var(--ink-soft); font-size:.85rem; margin:0 0 12px; }
  textarea.remise-comment{ width:100%; font:inherit; border:1px solid var(--line); border-radius:6px; padding:8px; resize:vertical; }
</style>
<link rel="stylesheet" href="{{ config('root_doc') }}/plugins/remise/css/remise.css">
</head>
<body>
<div class="wrap">
  <header>
    <h1>{{ page_title|default(__('Signature de remise de matériel', 'remise')) }}</h1>
    {% if not error %}<p>{{ __('Matériel', 'remise') }} : <strong>{{ item.name }}</strong> — {{ __('Bénéficiaire', 'remise') }} : <strong>{{ user.firstname }} {{ user.realname }}</strong></p>{% endif %}
  </header>

  {% if error %}
    <div class="card error">
      <p>{{ __('Impossible d\'afficher ce document', 'remise') }} : {{ error }}</p>
      <p><a href="{{ config('root_doc') }}/front/central.php">{{ __('Retour à l\'accueil GLPI', 'remise') }}</a></p>
    </div>
  {% else %}
    <div class="card">
      <div id="pdf-container" data-pdf-url="{{ pdf_url }}"></div>
    </div>

    {% if damage_annotation_enabled %}
      <div class="card">
        <h2>{{ __('État des lieux visuel', 'remise') }}</h2>
        <p class="hint">{{ __('Cliquez sur une vue pour y déposer un repère de dommage ; cliquez sur un repère existant pour le décrire ou le supprimer, glissez-le pour le repositionner.', 'remise') }}</p>
        <div class="damage-view-grid">
          {% for index, label in damage_views %}
            <div>
              <div class="damage-view" data-remise-id="{{ remise.id }}" data-view-index="{{ index }}" data-editable="{{ can_edit_damage_markers ? '1' : '0' }}">
                <img class="damage-view-img" src="{{ config('root_doc') }}/plugins/remise/images/damage-views/{{ damage_images[index] }}" alt="{{ label }}">
                {% for marker in damage_markers_by_view[index]|default([]) %}
                  <div class="damage-marker{{ marker.severity == 1 ? ' damage-marker-major' : '' }}"
                       data-id="{{ marker.id }}"
                       style="left: {{ marker.x_percent }}%; top: {{ marker.y_percent }}%;"
                       title="{{ marker.description|default('') }}"></div>
                {% endfor %}
              </div>
              <div class="damage-view-label">{{ label }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="card">
      <h2>{{ __('Remarque', 'remise') }}</h2>
      <p class="hint">{{ __('Une précision à ajouter avant de signer (optionnel).', 'remise') }}</p>
      <textarea id="beneficiary-comment" class="remise-comment" rows="3" {{ can_edit_comment ? '' : 'readonly' }}>{{ beneficiary_comment }}</textarea>
      {% if can_edit_comment %}
        <div class="actions">
          <button type="button" id="btn-save-comment">{{ __('Enregistrer', 'remise') }}</button>
        </div>
        <p id="comment-status-msg" style="font-size:.85rem;color:var(--ink-soft);"></p>
      {% endif %}
    </div>

    <div class="card sign-zone">
      <label class="consent">
        <input type="checkbox" id="consent-checkbox">
        <span>{{ __('J\'ai lu et j\'accepte les conditions générales et la charte informatique présentées dans le document ci-dessus.', 'remise') }}</span>
      </label>

      <p style="margin-top:14px;">{{ __('Signez ci-dessous à la souris, au doigt ou au stylet :', 'remise') }}</p>
      <canvas id="signature-pad"></canvas>

      <div class="actions">
        <button type="button" id="btn-clear">{{ __('Effacer', 'remise') }}</button>
        <button type="button" id="btn-submit" class="primary" disabled>{{ __('Valider ma signature', 'remise') }}</button>
      </div>
      <p id="status-msg"></p>
      <p style="font-size:.78rem;color:var(--ink-soft);margin-top:10px;">{{ __('Ce lien est valable jusqu\'au', 'remise') }} {{ expiry|date('d/m/Y H:i') }} {{ __('et deviendra invalide dès la signature.', 'remise') }}</p>
    </div>
  {% endif %}
</div>

<script src="{{ config('root_doc') }}/plugins/remise/js/sign/vendor/pdf.min.js"></script>
<script src="{{ config('root_doc') }}/plugins/remise/js/sign/vendor/signature_pad.umd.min.js"></script>
<script>
  window.REMISE_SIGN_TOKEN = {{ token|json_encode|raw }};
  window.REMISE_CSRF_TOKEN = {{ csrf_token|default('')|json_encode|raw }};
  window.REMISE_ROOT_DOC = {{ config('root_doc')|json_encode|raw }};
  window.REMISE_I18N = {
    loadError: {{ __('Impossible de charger le document', 'remise')|json_encode|raw }},
    sending: {{ __('Envoi en cours…', 'remise')|json_encode|raw }},
    errorPrefix: {{ __('Erreur', 'remise')|json_encode|raw }},
    signedOk: {{ __('Merci, votre signature a bien été enregistrée.', 'remise')|json_encode|raw }},
    networkError: {{ __('Erreur réseau, merci de réessayer.', 'remise')|json_encode|raw }},
    backToHome: {{ __('Retour à l\'accueil GLPI', 'remise')|json_encode|raw }}
  };
</script>
<script src="{{ config('root_doc') }}/plugins/remise/js/sign/sign.js"></script>

{% if damage_annotation_enabled and can_edit_damage_markers %}
  <script>
    // Reperes d'etat des lieux, geres par le beneficiaire lui-meme depuis cette
    // page : meme script que la fiche admin (damage-annotation.js), mais pointe
    // vers front/sign.php (authentification par jeton, pas par droit GLPI).
    window.REMISE_DAMAGE_CSRF = {{ csrf_token|default('')|json_encode|raw }};
    window.REMISE_DAMAGE_ENDPOINT = {{ config('root_doc')|json_encode|raw }} + '/plugins/remise/front/sign.php';
    window.REMISE_DAMAGE_EXTRA_PARAMS = { t: {{ token|json_encode|raw }} };
    window.REMISE_DAMAGE_I18N = {
      description: {{ __('Description', 'remise')|json_encode|raw }},
      severity: {{ __('Gravité', 'remise')|json_encode|raw }},
      minor: {{ __('Mineure', 'remise')|json_encode|raw }},
      major: {{ __('Majeure', 'remise')|json_encode|raw }},
      save: {{ __('Enregistrer', 'remise')|json_encode|raw }},
      deleteLabel: {{ __('Supprimer', 'remise')|json_encode|raw }}
    };
  </script>
  <script src="{{ config('root_doc') }}/plugins/remise/js/sign/damage-annotation.js"></script>
{% endif %}

{% if can_edit_comment %}
  <script>
    (function () {
      var btn = document.getElementById('btn-save-comment');
      var textarea = document.getElementById('beneficiary-comment');
      var status = document.getElementById('comment-status-msg');

      btn.addEventListener('click', function () {
        btn.disabled = true;
        var body = new URLSearchParams({
          t: window.REMISE_SIGN_TOKEN,
          update_comment: '1',
          comment: textarea.value,
          // window.REMISE_CSRF_TOKEN (pas une copie locale) : ce jeton a usage
          // unique est aussi utilise/rote par damage-annotation.js et sign.js
          // sur cette meme page — une copie locale ici manquerait leurs
          // rotations et echouerait en 403 des que l'un d'eux a deja tourne.
          _glpi_csrf_token: window.REMISE_CSRF_TOKEN
        });
        fetch(window.location.pathname, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString()
        }).then(function (res) {
          var rotated = res.headers.get('X-Remise-Csrf-Token');
          if (rotated) {
            window.REMISE_CSRF_TOKEN = rotated;
          }
          return res.json();
        }).then(function (data) {
          status.textContent = data.success
            ? {{ __('Remarque enregistrée.', 'remise')|json_encode|raw }}
            : ({{ __('Erreur', 'remise')|json_encode|raw }} + ' : ' + data.error);
          btn.disabled = false;
        }).catch(function () {
          status.textContent = window.REMISE_I18N.networkError;
          btn.disabled = false;
        });
      });
    })();
  </script>
{% endif %}
</body>
</html>
