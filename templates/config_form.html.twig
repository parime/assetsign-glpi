{# Edition directe du gabarit par defaut de ce type, dans l'onglet lui-meme —
   remplace l'ancien simple lien de renvoi vers front/template.form.php (cf.
   ROADMAP.md, "Rapprocher la gestion des gabarits de l'experience du
   plugin"). Chaque champ est rattache via l'attribut HTML5 form="..." a la
   forme cachee "assetsign-template-form-{type}" declaree plus haut (jamais de
   <form> imbrique dans le formulaire principal, invalide en HTML) : la
   sauvegarde reste entierement geree par Template::showForm()/CommonDBTM,
   ce bloc ne fait que rapatrier l'affichage. #}
{% macro template_editor(type, template, entity_id) %}
  {% set form_id = 'assetsign-template-form-' ~ type %}
  <div class="card card-sm mb-3">
    <div class="card-body">
      {% if template.fields.entities_id is defined and template.fields.entities_id != entity_id %}
        <div class="alert alert-info py-2 px-3 mb-3">
          {{ __('Ce gabarit est hérité d\'une entité parente : l\'enregistrer ici le modifie pour toutes les entités qui en héritent, pas seulement celle-ci.', 'assetsign') }}
        </div>
      {% endif %}

      <div class="mb-3">
        <label class="form-label">{{ __('Nom du gabarit', 'assetsign') }}</label>
        <input type="text" name="name" form="{{ form_id }}" class="form-control" value="{{ template.fields.name|default('') }}" required>
      </div>

      <div class="mb-3 form-check">
        <input type="hidden" name="include_content" form="{{ form_id }}" value="0">
        <input type="checkbox" name="include_content" form="{{ form_id }}" value="1" class="form-check-input" id="include_content_{{ type }}" {{ template.fields.include_content|default(1) ? 'checked' : '' }}>
        <label class="form-check-label" for="include_content_{{ type }}">{{ __('Inclure les conditions générales dans le PDF', 'assetsign') }}</label>
      </div>
      <div class="mb-3">
        {{ fields.textareaField('content', template.fields.content|default(''), __('Conditions générales (contrat)', 'assetsign'), {'enable_richtext': true, 'enable_images': false, 'rows': 6, 'additional_attributes': {'form': form_id}}) }}
        <div class="form-text">{{ __('Variables disponibles, remplacées automatiquement sur le PDF :', 'assetsign') }} <code>{beneficiaire}</code>, <code>{technicien}</code>, <code>{materiel}</code>, <code>{date}</code>, <code>{entite}</code>.</div>
      </div>

      <div class="mb-3 form-check">
        <input type="hidden" name="include_charter" form="{{ form_id }}" value="0">
        <input type="checkbox" name="include_charter" form="{{ form_id }}" value="1" class="form-check-input" id="include_charter_{{ type }}" {{ template.fields.include_charter|default(1) ? 'checked' : '' }}>
        <label class="form-check-label" for="include_charter_{{ type }}">{{ __('Inclure la charte informatique dans le PDF', 'assetsign') }}</label>
      </div>
      <div class="mb-3">
        {{ fields.textareaField('charter_content', template.fields.charter_content|default(''), __('Charte informatique', 'assetsign'), {'enable_richtext': true, 'enable_images': false, 'rows': 6, 'additional_attributes': {'form': form_id}}) }}
      </div>

      <div class="d-flex gap-2 align-items-center">
        <button type="submit" form="{{ form_id }}" name="{{ template.fields.id|default(0) ? 'update' : 'add' }}" class="btn btn-primary btn-sm">{{ __('Enregistrer le gabarit', 'assetsign') }}</button>
        <a href="{{ config('root_doc') }}/plugins/assetsign/front/template.php?criteria[0][link]=AND&criteria[0][field]=2&criteria[0][searchtype]=equals&criteria[0][value]={{ type }}" class="btn btn-outline-secondary btn-sm">{{ __('Gérer tous les gabarits de ce type', 'assetsign') }}</a>
      </div>
    </div>
  </div>
{% endmacro %}

<script>
(function () {
  var fileInput = document.getElementById('assetsign-logo-file');
  var removeCheckbox = document.getElementById('remove_logo');
  var frame = document.getElementById('assetsign-preview-frame');

  function setPreviewLogo(dataUrl) {
    if (!frame.contentDocument) {
      return;
    }
    // .header-logo peut deja exister sans <img> (nom d'entreprise seul, sans
    // logo, cf. handover.html.twig/maintenance.html.twig) : ne jamais
    // supprimer tout le wrapper ni supposer que l'img existe deja, sous peine
    // de perdre le nom d'entreprise ou de planter sur un img.src null.
    var wrapper = frame.contentDocument.querySelector('.header-logo');
    var img = wrapper ? wrapper.querySelector('img') : null;
    if (dataUrl) {
      if (!wrapper) {
        wrapper = frame.contentDocument.createElement('div');
        wrapper.className = 'header-logo';
        frame.contentDocument.body.insertBefore(wrapper, frame.contentDocument.body.firstChild);
      }
      if (!img) {
        img = frame.contentDocument.createElement('img');
        img.alt = '';
        wrapper.insertBefore(img, wrapper.firstChild);
      }
      img.src = dataUrl;
    } else if (img) {
      img.remove();
    }
  }

  if (fileInput) {
    fileInput.addEventListener('change', function () {
      if (removeCheckbox) {
        removeCheckbox.checked = false;
      }
      var file = fileInput.files && fileInput.files[0];
      if (!file) {
        return;
      }
      var reader = new FileReader();
      reader.onload = function (e) {
        setPreviewLogo(e.target.result);
      };
      reader.readAsDataURL(file);
    });
  }

  if (removeCheckbox) {
    removeCheckbox.addEventListener('change', function () {
      if (removeCheckbox.checked) {
        fileInput.value = '';
        setPreviewLogo(null);
      }
    });
  }

  // live-preview.js remplace ENTIEREMENT frame.srcdoc a chaque apercu en
  // direct (case cochee, changement d'onglet...) — un logo pas encore
  // envoye au serveur (choisi via #assetsign-logo-file, jamais transmis a
  // front/preview.php, cf. son propre commentaire) disparaissait alors du
  // rendu a chaque rafraichissement suivant, quelques centaines de ms apres
  // l'avoir choisi : bug reel signale par l'utilisateur ("le logo fini par
  // disparaitre"). Reappliquee ici a chaque fin de rafraichissement
  // (callback expose par live-preview.js), tant qu'un fichier est toujours
  // selectionne et que "Retirer le logo actuel" n'est pas coche.
  window.ASSETSIGN_ON_PREVIEW_REFRESH = function () {
    if (removeCheckbox && removeCheckbox.checked) {
      return;
    }
    var file = fileInput && fileInput.files && fileInput.files[0];
    if (!file) {
      return;
    }
    var reader = new FileReader();
    reader.onload = function (e) {
      setPreviewLogo(e.target.result);
    };
    reader.readAsDataURL(file);
  };

  // Chaque onglet de type (Assetsign/Restitution/Don/Vente) a son propre apercu :
  // au changement d'onglet, met a jour le champ "type" cache et redeclenche un
  // apercu (memes evenements 'change' que live-preview.js ecoute deja).
  var typeInput = document.getElementById('assetsign-preview-type');
  document.querySelectorAll('[data-bs-toggle="tab"]').forEach(function (tabButton) {
    tabButton.addEventListener('shown.bs.tab', function () {
      typeInput.value = tabButton.dataset.assetsignPreviewType;
      typeInput.dispatchEvent(new Event('change', { bubbles: true }));
    });
  });
})();
</script>
<script>
  window.ASSETSIGN_ROOT_DOC = {{ config('root_doc')|json_encode|raw }};
  // Jeton DEDIE au canal d'apercu en direct, jamais partage avec celui du
  // formulaire (champ _glpi_csrf_token, reserve au vrai bouton Enregistrer) —
  // cf. commentaire de Config::showConfigForm().
  window.ASSETSIGN_PREVIEW_CSRF_TOKEN = {{ preview_csrf_token|json_encode|raw }};
</script>
