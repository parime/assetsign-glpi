{% import 'components/form/fields_macros.html.twig' as fields %}
<div class="row flex-nowrap align-items-start" style="gap: 1rem;">
<div class="col" style="min-width: 320px;">
<div class="card">
  <div class="card-body">
    {# Formulaire independant du principal (jamais imbrique) : seuls le jeton
       CSRF et l'entite lui sont necessaires, cf. bouton "Envoyer un e-mail de
       test" plus bas (associe via l'attribut HTML5 form="assetsign-test-email-form"). #}
    <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/config.php" id="assetsign-test-email-form" style="display:none;">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="entities_id" value="{{ entity_id }}">
    </form>
    {# Une forme cachee par type, portant les champs non visibles (jeton CSRF,
       id, type, entite, is_default/is_active) : les champs visibles de
       l'editeur de gabarit integre (macro template_editor plus bas) y sont
       rattaches via l'attribut HTML5 form="...", jamais imbriques dans le
       formulaire principal ci-dessous — meme motif que assetsign-test-email-form
       (un <form> ne peut pas en contenir un autre en HTML valide). #}
    {% for type, template in templates %}
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/template.form.php" id="assetsign-template-form-{{ type }}" style="display:none;">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="id" value="{{ template.fields.id|default(0) }}">
        <input type="hidden" name="type" value="{{ type }}">
        <input type="hidden" name="entities_id" value="{{ template.fields.entities_id|default(entity_id) }}">
        <input type="hidden" name="is_default" value="1">
        <input type="hidden" name="is_active" value="1">
      </form>
    {% endfor %}
    <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/config.php" enctype="multipart/form-data" id="assetsign-config-form" data-assetsign-preview-frame="assetsign-preview-frame">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="entities_id" value="{{ entity_id }}">
      <input type="hidden" name="type" id="assetsign-preview-type" value="0">

      <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-general" type="button" role="tab" data-assetsign-preview-type="0">{{ __('Général', 'assetsign') }}</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-handover" type="button" role="tab" data-assetsign-preview-type="0">{{ __('Attribution', 'assetsign') }}</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-return" type="button" role="tab" data-assetsign-preview-type="1">{{ __('Restitution', 'assetsign') }}</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-don" type="button" role="tab" data-assetsign-preview-type="3">{{ __('Don', 'assetsign') }}</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-vente" type="button" role="tab" data-assetsign-preview-type="4">{{ __('Vente', 'assetsign') }}</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-reforme" type="button" role="tab" data-assetsign-preview-type="0">{{ __('Réforme', 'assetsign') }}</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-complements" type="button" role="tab" data-assetsign-preview-type="0">{{ __('Compléments', 'assetsign') }}</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-maintenance" type="button" role="tab" data-assetsign-preview-type="0">{{ __('Maintenance', 'assetsign') }}</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-passport" type="button" role="tab" data-assetsign-preview-type="0">{{ __('Passeport matériel', 'assetsign') }}</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-health" type="button" role="tab" data-assetsign-preview-type="0">{{ __('Score de santé', 'assetsign') }}</button></li>
      </ul>

      <div class="tab-content">

        {# ---------------------------------------------------------------- Général #}
        <div class="tab-pane fade show active" id="tab-general" role="tabpanel">
          <div class="card card-sm mb-3">
            <div class="card-body d-flex align-items-center gap-3">
              <i class="ti ti-brand-github fs-1 text-muted"></i>
              <div>
                <div class="fw-bold">{{ __('Version du plugin', 'assetsign') }}</div>
                <div class="text-muted small">
                  {{ __('Version installée', 'assetsign') }}
                  <span class="badge bg-blue-lt">v{{ installed_version }}</span>
                  {% if latest_github_version %}
                    {{ __('Dernière version sur GitHub', 'assetsign') }}
                    <span class="badge {{ latest_github_version != installed_version ? 'bg-orange-lt' : 'bg-green-lt' }}">v{{ latest_github_version }}</span>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">{{ __('Nom de l\'expéditeur', 'assetsign') }}</label>
            <input type="text" name="sender_name" class="form-control" value="{{ config.sender_name|default('') }}">
          </div>
          <div class="mb-3">
            <label class="form-label">{{ __('E-mail de l\'expéditeur', 'assetsign') }}</label>
            <input type="email" name="sender_email" class="form-control" value="{{ config.sender_email|default('') }}">
          </div>

          <div class="mb-3">
            {# Bouton associe au formulaire independant "assetsign-test-email-form"
               (attribut HTML5 form="...", pas d'imbrication de <form>) : action
               separee de "update", envoyee a l'adresse du compte GLPI courant
               plutot qu'a un vrai beneficiaire, pour verifier isolement que le
               serveur SMTP configure dans GLPI accepte l'envoi avec l'expediteur
               ci-dessus, sans attendre une vraie assetsign. #}
            <button type="submit" form="assetsign-test-email-form" name="send_test_email" class="btn btn-outline-secondary btn-sm">{{ __('Envoyer un e-mail de test', 'assetsign') }}</button>
            <div class="form-text">{{ __('Envoie un e-mail à votre propre adresse GLPI, pour vérifier que l\'envoi fonctionne.', 'assetsign') }}</div>
          </div>

          <div class="mb-3">
            <label class="form-label">{{ __('Logo à afficher sur les fiches PDF', 'assetsign') }}</label>
            {% if logo_is_forced %}
              <div class="alert alert-info py-2 px-3 mb-2">
                {{ __('Le logo affiché ci-dessous est actuellement imposé par une entité parente (voir plus bas). Un logo envoyé ici ne sera utilisé que si cette imposition est retirée.', 'assetsign') }}
              </div>
            {% endif %}
            {% if logo_document %}
              <div class="d-flex align-items-center gap-3 mb-2">
                <img src="{{ config('root_doc') }}/front/document.send.php?docid={{ logo_document.fields.id }}" alt="" style="max-height: 60px; max-width: 220px; border: 1px solid #ddd; padding: 4px; border-radius: 4px;">
                {% if not logo_is_forced %}
                  <div class="form-check">
                    <input type="checkbox" name="remove_logo" value="1" class="form-check-input" id="remove_logo">
                    <label class="form-check-label" for="remove_logo">{{ __('Retirer le logo actuel', 'assetsign') }}</label>
                  </div>
                {% endif %}
              </div>
            {% endif %}
            <input type="file" name="logo_file" id="assetsign-logo-file" class="form-control" accept="image/png,image/jpeg,image/gif,image/webp">
            <div class="form-text">{{ __('Image PNG, JPG, GIF ou WEBP. Choisissez un fichier pour remplacer le logo actuel.', 'assetsign') }}</div>
          </div>

          <div class="mb-3 form-check">
            <input type="hidden" name="logo_force_children" value="0">
            <input type="checkbox" name="logo_force_children" value="1" class="form-check-input" id="logo_force_children" {{ config.logo_force_children|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="logo_force_children">{{ __('Imposer ce logo à toutes les entités enfants (et leurs propres sous-entités)', 'assetsign') }}</label>
            <div class="form-text">{{ __('Utile si plusieurs entités doivent afficher le même logo : cette entité impose alors le sien à toute sa descendance, même si une entité enfant a déjà envoyé son propre logo.', 'assetsign') }}</div>
          </div>

          <div class="mb-3">
            <label class="form-label">{{ __('Nom de l\'entreprise', 'assetsign') }}</label>
            <input type="text" name="company_name" class="form-control" value="{{ config.company_name|default('') }}">
            <div class="form-text">{{ __('Optionnel : affiché à côté du logo sur les fiches PDF, en complément (pas en remplacement) du logo.', 'assetsign') }}</div>
          </div>

          <div class="mb-3">
            <label class="form-label">{{ __('Lien vers la charte informatique complète', 'assetsign') }}</label>
            <input type="url" name="charter_url" class="form-control" placeholder="https://intranet.exemple.fr/charte-informatique.pdf" value="{{ config.charter_url|default('') }}">
            <div class="form-text">{{ __('Optionnel : URL vers un document ou une page existante (intranet, PDF déjà en ligne...). Si renseigné, un lien cliquable apparaît sur la fiche PDF, en plus du texte de la charte défini dans le gabarit — commun à tous les types.', 'assetsign') }}</div>
          </div>

          <div class="mb-3">
            <label class="form-label">{{ __('Fournisseur de signature', 'assetsign') }}</label>
            <select name="default_provider" class="form-select">
              {% for key, label in providers %}
                <option value="{{ key }}" {{ config.default_provider|default('canvas') == key ? 'selected' : '' }}>{{ label }}</option>
              {% endfor %}
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">{{ __('Délais de relance (jours, séparés par des virgules — ex: 3,7,7)', 'assetsign') }}</label>
            <input type="text" name="reminder_delays" class="form-control" value="{{ config.reminder_delays|default('3,7,7') }}">
          </div>
          <div class="mb-3">
            <label class="form-label">{{ __('Nombre maximum de relances (0 = illimité)', 'assetsign') }}</label>
            <input type="number" name="max_reminders" class="form-control" value="{{ config.max_reminders|default(0) }}" min="0">
          </div>
          <div class="mb-3">
            <label class="form-label">{{ __('Durée de validité du lien de signature (jours)', 'assetsign') }}</label>
            <input type="number" name="link_validity_days" class="form-control" value="{{ config.link_validity_days|default(30) }}" min="1">
          </div>
          <div class="mb-3">
            <label class="form-label">{{ __('Alerter le technicien avant expiration (jours avant, 0 = désactivé)', 'assetsign') }}</label>
            <input type="number" name="expiry_warning_days" class="form-control" value="{{ config.expiry_warning_days|default(3) }}" min="0">
            <div class="form-text">{{ __('Le technicien à l\'origine de la remise reçoit un e-mail quand il reste ce nombre de jours avant l\'expiration du lien, pour pouvoir relancer le bénéficiaire autrement (appel, passage sur place) avant qu\'il ne soit trop tard.', 'assetsign') }}</div>
          </div>

          <div class="mb-3 form-check">
            <input type="hidden" name="signature_required" value="0">
            <input type="checkbox" name="signature_required" value="1" class="form-check-input" id="signature_required" {{ config.signature_required|default(1) ? 'checked' : '' }}>
            <label class="form-check-label" for="signature_required">{{ __('Signature obligatoire', 'assetsign') }}</label>
          </div>

          <div class="mb-3 form-check">
            <input type="hidden" name="protect_pdf" value="0">
            <input type="checkbox" name="protect_pdf" value="1" class="form-check-input" id="protect_pdf" {{ config.protect_pdf|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="protect_pdf">{{ __('Protéger le PDF (restreindre la copie et l\'édition)', 'assetsign') }}</label>
            <div class="form-text">{{ __('Chiffre le PDF généré pour empêcher sa copie/modification dans un lecteur qui respecte cette restriction — n\'affecte jamais la possibilité de le consulter ou de l\'imprimer.', 'assetsign') }}</div>
          </div>

          <hr>
          <h4>{{ __('Types de matériel gérés par le plugin', 'assetsign') }}</h4>
          <p class="text-muted">{{ __('Décochez un type pour que le plugin n\'agisse jamais dessus, quelle que soit l\'affectation ou l\'État.', 'assetsign') }}</p>
          {% for itemtype, label in itemtype_labels %}
            <div class="mb-2 form-check">
              <input type="checkbox" name="manage_{{ itemtype }}" value="1" class="form-check-input" id="manage_{{ itemtype }}" {{ itemtype in managed ? 'checked' : '' }}>
              <label class="form-check-label" for="manage_{{ itemtype }}">{{ label }}</label>
            </div>
          {% endfor %}
        </div>

        {# ---------------------------------------------------------------- Assetsign #}
        <div class="tab-pane fade" id="tab-handover" role="tabpanel">
          {{ _self.template_editor(0, templates[0], entity_id) }}
          <h4>{{ __('Déclenchement par affectation d\'utilisateur', 'assetsign') }}</h4>
          <p class="text-muted">{{ __('Basé sur le champ "Utilisateur" du matériel — fonctionne dans la plupart des GLPI.', 'assetsign') }}</p>
          <div class="mb-3 form-check">
            <input type="hidden" name="sign_on_assignment" value="0">
            <input type="checkbox" name="sign_on_assignment" value="1" class="form-check-input" id="sign_on_assignment" {{ config.sign_on_assignment|default(1) ? 'checked' : '' }}>
            <label class="form-check-label" for="sign_on_assignment">{{ __('Signature à la première affectation', 'assetsign') }}</label>
          </div>
          <div class="mb-3 form-check">
            <input type="hidden" name="sign_on_reassignment" value="0">
            <input type="checkbox" name="sign_on_reassignment" value="1" class="form-check-input" id="sign_on_reassignment" {{ config.sign_on_reassignment|default(1) ? 'checked' : '' }}>
            <label class="form-check-label" for="sign_on_reassignment">{{ __('Signature à chaque changement d\'utilisateur', 'assetsign') }}</label>
          </div>

          {% if all_states|length %}
            <h4 class="mt-4">{{ __('Déclenchement par État du matériel (optionnel)', 'assetsign') }}</h4>
            <p class="text-muted">{{ __('Tous les GLPI n\'utilisent pas les mêmes États : choisissez parmi VOS États existants (Configuration > Listes déroulantes > États).', 'assetsign') }}</p>
            {% for id, name in all_states %}
              <div class="form-check">
                <input type="checkbox" name="handover_states[]" value="{{ id }}" class="form-check-input" id="handover_state_{{ id }}" {{ id in handover_states ? 'checked' : '' }}>
                <label class="form-check-label" for="handover_state_{{ id }}">{{ name }}</label>
              </div>
            {% endfor %}
          {% endif %}
        </div>

        {# ---------------------------------------------------------------- Restitution #}
        <div class="tab-pane fade" id="tab-return" role="tabpanel">
          {{ _self.template_editor(1, templates[1], entity_id) }}
          <div class="mb-3 form-check">
            <input type="hidden" name="sign_on_return" value="0">
            <input type="checkbox" name="sign_on_return" value="1" class="form-check-input" id="sign_on_return" {{ config.sign_on_return|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="sign_on_return">{{ __('Signature lors de la restitution (désaffectation)', 'assetsign') }}</label>
          </div>

          {% if all_states|length %}
            <h4 class="mt-4">{{ __('Déclenchement par État du matériel (optionnel)', 'assetsign') }}</h4>
            {% for id, name in all_states %}
              <div class="form-check">
                <input type="checkbox" name="return_states[]" value="{{ id }}" class="form-check-input" id="return_state_{{ id }}" {{ id in return_states ? 'checked' : '' }}>
                <label class="form-check-label" for="return_state_{{ id }}">{{ name }}</label>
              </div>
            {% endfor %}
          {% endif %}
        </div>

        {# ---------------------------------------------------------------- Don #}
        <div class="tab-pane fade" id="tab-don" role="tabpanel">
          {{ _self.template_editor(3, templates[3], entity_id) }}
          <div class="mb-3 form-check">
            <input type="hidden" name="enable_don" value="0">
            <input type="checkbox" name="enable_don" value="1" class="form-check-input" id="enable_don" {{ config.enable_don|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="enable_don">{{ __('Autoriser la création de fiches de don de matériel', 'assetsign') }}</label>
            <div class="form-text">{{ __('Ajoute un bouton « Créer une fiche de don » sur l\'onglet Attribution de chaque matériel géré par le plugin.', 'assetsign') }}</div>
          </div>

          {% if all_states|length %}
            <h4 class="mt-4">{{ __('Déclenchement par État du matériel (optionnel)', 'assetsign') }}</h4>
            {% for id, name in all_states %}
              <div class="form-check">
                <input type="checkbox" name="donation_states[]" value="{{ id }}" class="form-check-input" id="donation_state_{{ id }}" {{ id in donation_states ? 'checked' : '' }}>
                <label class="form-check-label" for="donation_state_{{ id }}">{{ name }}</label>
              </div>
            {% endfor %}
          {% endif %}
        </div>

        {# ---------------------------------------------------------------- Vente #}
        <div class="tab-pane fade" id="tab-vente" role="tabpanel">
          {{ _self.template_editor(4, templates[4], entity_id) }}
          <div class="mb-3 form-check">
            <input type="hidden" name="enable_vente" value="0">
            <input type="checkbox" name="enable_vente" value="1" class="form-check-input" id="enable_vente" {{ config.enable_vente|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="enable_vente">{{ __('Autoriser la création de fiches de vente de matériel', 'assetsign') }}</label>
            <div class="form-text">{{ __('Ajoute un bouton « Créer une fiche de vente » (avec prix et date) sur l\'onglet Attribution de chaque matériel géré par le plugin.', 'assetsign') }}</div>
          </div>

          <div class="mb-3">
            <label class="form-label">{{ __('Symbole monétaire', 'assetsign') }}</label>
            <input type="text" name="currency_symbol" class="form-control" style="width: 80px;" maxlength="8" value="{{ config.currency_symbol|default('€') }}">
            <div class="form-text">{{ __('Affiché après le prix sur la fiche PDF (ex: €, $, CHF).', 'assetsign') }}</div>
          </div>

          {% if all_states|length %}
            <h4 class="mt-4">{{ __('Déclenchement par État du matériel (optionnel)', 'assetsign') }}</h4>
            <p class="text-muted small">{{ __('Le prix et la date ne sont pas connus automatiquement : à compléter ensuite sur la fiche créée.', 'assetsign') }}</p>
            {% for id, name in all_states %}
              <div class="form-check">
                <input type="checkbox" name="vente_states[]" value="{{ id }}" class="form-check-input" id="vente_state_{{ id }}" {{ id in vente_states ? 'checked' : '' }}>
                <label class="form-check-label" for="vente_state_{{ id }}">{{ name }}</label>
              </div>
            {% endfor %}
          {% endif %}
        </div>

        {# ---------------------------------------------------------------- Réforme #}
        <div class="tab-pane fade" id="tab-reforme" role="tabpanel">
          <p class="text-muted">{{ __('Aucune fiche Attribution n\'est créée ici : ce réglage ne fait qu\'écrire automatiquement la date de réforme (champ natif GLPI « Réforme » de l\'onglet Infocom) quand le matériel passe dans l\'un des États ci-dessous, au lieu de la saisir à la main.', 'assetsign') }}</p>
          <p class="text-muted small">{{ __('Une date de réforme déjà renseignée (saisie manuelle ou déclenchement précédent) n\'est jamais écrasée.', 'assetsign') }}</p>

          {% if all_states|length %}
            <h4 class="mt-4">{{ __('Déclenchement par État du matériel', 'assetsign') }}</h4>
            <p class="text-muted">{{ __('Tous les GLPI n\'utilisent pas les mêmes États : choisissez parmi VOS États existants (Configuration > Listes déroulantes > États).', 'assetsign') }}</p>
            {% for id, name in all_states %}
              <div class="form-check">
                <input type="checkbox" name="reforme_states[]" value="{{ id }}" class="form-check-input" id="reforme_state_{{ id }}" {{ id in reforme_states ? 'checked' : '' }}>
                <label class="form-check-label" for="reforme_state_{{ id }}">{{ name }}</label>
              </div>
            {% endfor %}
          {% endif %}
        </div>

        {# ---------------------------------------------------------------- Compléments #}
        <div class="tab-pane fade" id="tab-complements" role="tabpanel">
          <p class="text-muted">{{ __('Réglages transverses, applicables à tous les types de fiche signée.', 'assetsign') }}</p>
          <div class="mb-3 form-check">
            <input type="hidden" name="enable_observations" value="0">
            <input type="checkbox" name="enable_observations" value="1" class="form-check-input" id="enable_observations" {{ config.enable_observations|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="enable_observations">{{ __('Champ « Observations » libre sur chaque fiche', 'assetsign') }}</label>
            <div class="form-text">{{ __('Si activé, un champ de texte libre devient disponible sur chaque fiche de remise (ex: état constaté du matériel) et apparaît sur le PDF tant que la fiche n\'est pas encore signée.', 'assetsign') }}</div>
          </div>
          <div class="mb-3 form-check">
            <input type="hidden" name="enable_damage_annotation" value="0">
            <input type="checkbox" name="enable_damage_annotation" value="1" class="form-check-input" id="enable_damage_annotation" {{ config.enable_damage_annotation|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="enable_damage_annotation">{{ __('État des lieux visuel (annotation de dommages)', 'assetsign') }}</label>
            <div class="form-text">{{ __('Permet de repérer des dommages sur 3 vues génériques (arrière, avant, dessous) : reportés sur le PDF pour les fiches signées, et affichés directement sur la fiche pour les fiches de maintenance.', 'assetsign') }}</div>
          </div>
          <div class="mb-3 form-check">
            <input type="hidden" name="show_qr_code" value="0">
            <input type="checkbox" name="show_qr_code" value="1" class="form-check-input" id="show_qr_code" {{ config.show_qr_code|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="show_qr_code">{{ __('Afficher un QR code sur les fiches PDF', 'assetsign') }}</label>
            <div class="form-text">{{ __('Le QR code renvoie vers la fiche correspondante dans GLPI — pratique pour la retrouver depuis un contrôle physique du matériel.', 'assetsign') }}</div>
          </div>
          <div class="row">
            <div class="col-auto mb-3">
              <label class="form-label">{{ __('Texte du filigrane sur l\'aperçu', 'assetsign') }}</label>
              <input type="text" name="preview_watermark_text" class="form-control" maxlength="32" value="{{ config.preview_watermark_text|default('APERÇU') }}">
            </div>
            <div class="col-auto mb-3">
              <label class="form-label">{{ __('Opacité du filigrane (%)', 'assetsign') }}</label>
              <input type="number" name="preview_watermark_opacity" min="5" max="100" class="form-control" style="width: 100px;" value="{{ config.preview_watermark_opacity|default(25) }}">
            </div>
          </div>
          <div class="form-text mb-3">{{ __('Affiché uniquement sur l\'aperçu en direct (jamais sur le vrai PDF), pour éviter toute confusion entre les deux.', 'assetsign') }}</div>
        </div>

        {# ---------------------------------------------------------------- Maintenance #}
        <div class="tab-pane fade" id="tab-maintenance" role="tabpanel">
