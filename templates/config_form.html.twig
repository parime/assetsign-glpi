<div class="row flex-nowrap align-items-start" style="gap: 1rem;">
<div class="col" style="min-width: 320px;">
<div class="card">
  <div class="card-body">
    <form method="post" action="{{ config('root_doc') }}/plugins/remise/front/config.php" enctype="multipart/form-data" id="remise-config-form" data-remise-preview-frame="remise-preview-frame">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="entities_id" value="{{ entity_id }}">
      <input type="hidden" name="type" id="remise-preview-type" value="0">

      <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-general" type="button" role="tab" data-remise-preview-type="0">{{ __('Général', 'remise') }}</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-handover" type="button" role="tab" data-remise-preview-type="0">{{ __('Remise', 'remise') }}</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-return" type="button" role="tab" data-remise-preview-type="1">{{ __('Restitution', 'remise') }}</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-don" type="button" role="tab" data-remise-preview-type="3">{{ __('Don', 'remise') }}</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-vente" type="button" role="tab" data-remise-preview-type="4">{{ __('Vente', 'remise') }}</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-complements" type="button" role="tab" data-remise-preview-type="0">{{ __('Compléments', 'remise') }}</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-maintenance" type="button" role="tab" data-remise-preview-type="0">{{ __('Maintenance', 'remise') }}</button></li>
      </ul>

      <div class="tab-content">

        {# ---------------------------------------------------------------- Général #}
        <div class="tab-pane fade show active" id="tab-general" role="tabpanel">
          <div class="mb-3">
            <label class="form-label">{{ __('Nom de l\'expéditeur', 'remise') }}</label>
            <input type="text" name="sender_name" class="form-control" value="{{ config.sender_name|default('') }}">
          </div>
          <div class="mb-3">
            <label class="form-label">{{ __('E-mail de l\'expéditeur', 'remise') }}</label>
            <input type="email" name="sender_email" class="form-control" value="{{ config.sender_email|default('') }}">
          </div>

          <div class="mb-3">
            <label class="form-label">{{ __('Logo à afficher sur les fiches PDF', 'remise') }}</label>
            {% if logo_is_forced %}
              <div class="alert alert-info py-2 px-3 mb-2">
                {{ __('Le logo affiché ci-dessous est actuellement imposé par une entité parente (voir plus bas). Un logo envoyé ici ne sera utilisé que si cette imposition est retirée.', 'remise') }}
              </div>
            {% endif %}
            {% if logo_document %}
              <div class="d-flex align-items-center gap-3 mb-2">
                <img src="{{ config('root_doc') }}/front/document.send.php?docid={{ logo_document.fields.id }}" alt="" style="max-height: 60px; max-width: 220px; border: 1px solid #ddd; padding: 4px; border-radius: 4px;">
                {% if not logo_is_forced %}
                  <div class="form-check">
                    <input type="checkbox" name="remove_logo" value="1" class="form-check-input" id="remove_logo">
                    <label class="form-check-label" for="remove_logo">{{ __('Retirer le logo actuel', 'remise') }}</label>
                  </div>
                {% endif %}
              </div>
            {% endif %}
            <input type="file" name="logo_file" id="remise-logo-file" class="form-control" accept="image/png,image/jpeg,image/gif,image/webp">
            <div class="form-text">{{ __('Image PNG, JPG, GIF ou WEBP. Choisissez un fichier pour remplacer le logo actuel.', 'remise') }}</div>
          </div>

          <div class="mb-3 form-check">
            <input type="hidden" name="logo_force_children" value="0">
            <input type="checkbox" name="logo_force_children" value="1" class="form-check-input" id="logo_force_children" {{ config.logo_force_children|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="logo_force_children">{{ __('Imposer ce logo à toutes les entités enfants (et leurs propres sous-entités)', 'remise') }}</label>
            <div class="form-text">{{ __('Utile si plusieurs entités doivent afficher le même logo : cette entité impose alors le sien à toute sa descendance, même si une entité enfant a déjà envoyé son propre logo.', 'remise') }}</div>
          </div>

          <div class="mb-3">
            <label class="form-label">{{ __('Lien vers la charte informatique complète', 'remise') }}</label>
            <input type="url" name="charter_url" class="form-control" placeholder="https://intranet.exemple.fr/charte-informatique.pdf" value="{{ config.charter_url|default('') }}">
            <div class="form-text">{{ __('Optionnel : URL vers un document ou une page existante (intranet, PDF déjà en ligne...). Si renseigné, un lien cliquable apparaît sur la fiche PDF, en plus du texte de la charte défini dans le gabarit — commun à tous les types.', 'remise') }}</div>
          </div>

          <div class="mb-3">
            <label class="form-label">{{ __('Fournisseur de signature', 'remise') }}</label>
            <select name="default_provider" class="form-select">
              {% for key, label in providers %}
                <option value="{{ key }}" {{ config.default_provider|default('canvas') == key ? 'selected' : '' }}>{{ label }}</option>
              {% endfor %}
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">{{ __('Délais de relance (jours, séparés par des virgules — ex: 3,7,7)', 'remise') }}</label>
            <input type="text" name="reminder_delays" class="form-control" value="{{ config.reminder_delays|default('3,7,7') }}">
          </div>
          <div class="mb-3">
            <label class="form-label">{{ __('Nombre maximum de relances (0 = illimité)', 'remise') }}</label>
            <input type="number" name="max_reminders" class="form-control" value="{{ config.max_reminders|default(0) }}" min="0">
          </div>
          <div class="mb-3">
            <label class="form-label">{{ __('Durée de validité du lien de signature (jours)', 'remise') }}</label>
            <input type="number" name="link_validity_days" class="form-control" value="{{ config.link_validity_days|default(30) }}" min="1">
          </div>
          <div class="mb-3">
            <label class="form-label">{{ __('Alerter le technicien avant expiration (jours avant, 0 = désactivé)', 'remise') }}</label>
            <input type="number" name="expiry_warning_days" class="form-control" value="{{ config.expiry_warning_days|default(3) }}" min="0">
            <div class="form-text">{{ __('Le technicien à l\'origine de la remise reçoit un e-mail quand il reste ce nombre de jours avant l\'expiration du lien, pour pouvoir relancer le bénéficiaire autrement (appel, passage sur place) avant qu\'il ne soit trop tard.', 'remise') }}</div>
          </div>

          <div class="mb-3 form-check">
            <input type="hidden" name="signature_required" value="0">
            <input type="checkbox" name="signature_required" value="1" class="form-check-input" id="signature_required" {{ config.signature_required|default(1) ? 'checked' : '' }}>
            <label class="form-check-label" for="signature_required">{{ __('Signature obligatoire', 'remise') }}</label>
          </div>

          <hr>
          <h4>{{ __('Types de matériel gérés par le plugin', 'remise') }}</h4>
          <p class="text-muted">{{ __('Décochez un type pour que le plugin n\'agisse jamais dessus, quelle que soit l\'affectation ou l\'État.', 'remise') }}</p>
          {% for itemtype, label in itemtype_labels %}
            <div class="mb-2 form-check">
              <input type="checkbox" name="manage_{{ itemtype }}" value="1" class="form-check-input" id="manage_{{ itemtype }}" {{ itemtype in managed ? 'checked' : '' }}>
              <label class="form-check-label" for="manage_{{ itemtype }}">{{ label }}</label>
            </div>
          {% endfor %}
        </div>

        {# ---------------------------------------------------------------- Remise #}
        <div class="tab-pane fade" id="tab-handover" role="tabpanel">
          {{ _self.template_link(0) }}
          <h4>{{ __('Déclenchement par affectation d\'utilisateur', 'remise') }}</h4>
          <p class="text-muted">{{ __('Basé sur le champ "Utilisateur" du matériel — fonctionne dans la plupart des GLPI.', 'remise') }}</p>
          <div class="mb-3 form-check">
            <input type="hidden" name="sign_on_assignment" value="0">
            <input type="checkbox" name="sign_on_assignment" value="1" class="form-check-input" id="sign_on_assignment" {{ config.sign_on_assignment|default(1) ? 'checked' : '' }}>
            <label class="form-check-label" for="sign_on_assignment">{{ __('Signature à la première affectation', 'remise') }}</label>
          </div>
          <div class="mb-3 form-check">
            <input type="hidden" name="sign_on_reassignment" value="0">
            <input type="checkbox" name="sign_on_reassignment" value="1" class="form-check-input" id="sign_on_reassignment" {{ config.sign_on_reassignment|default(1) ? 'checked' : '' }}>
            <label class="form-check-label" for="sign_on_reassignment">{{ __('Signature à chaque changement d\'utilisateur', 'remise') }}</label>
          </div>

          {% if all_states|length %}
            <h4 class="mt-4">{{ __('Déclenchement par État du matériel (optionnel)', 'remise') }}</h4>
            <p class="text-muted">{{ __('Tous les GLPI n\'utilisent pas les mêmes États : choisissez parmi VOS États existants (Configuration > Listes déroulantes > États).', 'remise') }}</p>
            {% for id, name in all_states %}
              <div class="form-check">
                <input type="checkbox" name="handover_states[]" value="{{ id }}" class="form-check-input" id="handover_state_{{ id }}" {{ id in handover_states ? 'checked' : '' }}>
                <label class="form-check-label" for="handover_state_{{ id }}">{{ name }}</label>
              </div>
            {% endfor %}
          {% endif %}
        </div>

        {# ---------------------------------------------------------------- Restitution #}
        <div class="tab-pane fade" id="tab-return" role="tabpanel">
          {{ _self.template_link(1) }}
          <div class="mb-3 form-check">
            <input type="hidden" name="sign_on_return" value="0">
            <input type="checkbox" name="sign_on_return" value="1" class="form-check-input" id="sign_on_return" {{ config.sign_on_return|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="sign_on_return">{{ __('Signature lors de la restitution (désaffectation)', 'remise') }}</label>
          </div>

          {% if all_states|length %}
            <h4 class="mt-4">{{ __('Déclenchement par État du matériel (optionnel)', 'remise') }}</h4>
            {% for id, name in all_states %}
              <div class="form-check">
                <input type="checkbox" name="return_states[]" value="{{ id }}" class="form-check-input" id="return_state_{{ id }}" {{ id in return_states ? 'checked' : '' }}>
                <label class="form-check-label" for="return_state_{{ id }}">{{ name }}</label>
              </div>
            {% endfor %}
          {% endif %}
        </div>

        {# ---------------------------------------------------------------- Don #}
        <div class="tab-pane fade" id="tab-don" role="tabpanel">
          {{ _self.template_link(3) }}
          <div class="mb-3 form-check">
            <input type="hidden" name="enable_don" value="0">
            <input type="checkbox" name="enable_don" value="1" class="form-check-input" id="enable_don" {{ config.enable_don|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="enable_don">{{ __('Autoriser la création de fiches de don de matériel', 'remise') }}</label>
            <div class="form-text">{{ __('Ajoute un bouton « Créer une fiche de don » sur l\'onglet Remise de chaque matériel géré par le plugin.', 'remise') }}</div>
          </div>

          {% if all_states|length %}
            <h4 class="mt-4">{{ __('Déclenchement par État du matériel (optionnel)', 'remise') }}</h4>
            {% for id, name in all_states %}
              <div class="form-check">
                <input type="checkbox" name="donation_states[]" value="{{ id }}" class="form-check-input" id="donation_state_{{ id }}" {{ id in donation_states ? 'checked' : '' }}>
                <label class="form-check-label" for="donation_state_{{ id }}">{{ name }}</label>
              </div>
            {% endfor %}
          {% endif %}
        </div>

        {# ---------------------------------------------------------------- Vente #}
        <div class="tab-pane fade" id="tab-vente" role="tabpanel">
          {{ _self.template_link(4) }}
          <div class="mb-3 form-check">
            <input type="hidden" name="enable_vente" value="0">
            <input type="checkbox" name="enable_vente" value="1" class="form-check-input" id="enable_vente" {{ config.enable_vente|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="enable_vente">{{ __('Autoriser la création de fiches de vente de matériel', 'remise') }}</label>
            <div class="form-text">{{ __('Ajoute un bouton « Créer une fiche de vente » (avec prix et date) sur l\'onglet Remise de chaque matériel géré par le plugin.', 'remise') }}</div>
          </div>

          {% if all_states|length %}
            <h4 class="mt-4">{{ __('Déclenchement par État du matériel (optionnel)', 'remise') }}</h4>
            <p class="text-muted small">{{ __('Le prix et la date ne sont pas connus automatiquement : à compléter ensuite sur la fiche créée.', 'remise') }}</p>
            {% for id, name in all_states %}
              <div class="form-check">
                <input type="checkbox" name="vente_states[]" value="{{ id }}" class="form-check-input" id="vente_state_{{ id }}" {{ id in vente_states ? 'checked' : '' }}>
                <label class="form-check-label" for="vente_state_{{ id }}">{{ name }}</label>
              </div>
            {% endfor %}
          {% endif %}
        </div>

        {# ---------------------------------------------------------------- Compléments #}
        <div class="tab-pane fade" id="tab-complements" role="tabpanel">
          <p class="text-muted">{{ __('Réglages transverses, applicables à tous les types de fiche signée.', 'remise') }}</p>
          <div class="mb-3 form-check">
            <input type="hidden" name="enable_observations" value="0">
            <input type="checkbox" name="enable_observations" value="1" class="form-check-input" id="enable_observations" {{ config.enable_observations|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="enable_observations">{{ __('Champ « Observations » libre sur chaque fiche', 'remise') }}</label>
            <div class="form-text">{{ __('Si activé, un champ de texte libre devient disponible sur chaque fiche de remise (ex: état constaté du matériel) et apparaît sur le PDF tant que la fiche n\'est pas encore signée.', 'remise') }}</div>
          </div>
          <div class="mb-3 form-check">
            <input type="hidden" name="enable_damage_annotation" value="0">
            <input type="checkbox" name="enable_damage_annotation" value="1" class="form-check-input" id="enable_damage_annotation" {{ config.enable_damage_annotation|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="enable_damage_annotation">{{ __('État des lieux visuel (annotation de dommages)', 'remise') }}</label>
            <div class="form-text">{{ __('Permet de repérer des dommages sur 3 vues génériques (arrière, avant, dessous) : reportés sur le PDF pour les fiches signées, et affichés directement sur la fiche pour les fiches de maintenance.', 'remise') }}</div>
          </div>
        </div>

        {# ---------------------------------------------------------------- Maintenance #}
        <div class="tab-pane fade" id="tab-maintenance" role="tabpanel">
          <p class="text-muted">{{ __('La fiche de maintenance est un sous-système séparé (pas de bénéficiaire, pas de gabarit) : l\'accès se gère par le droit dédié (Administration > Profils).', 'remise') }}</p>
          <div class="mb-3 form-check">
            <input type="hidden" name="maintenance_signature_required" value="0">
            <input type="checkbox" name="maintenance_signature_required" value="1" class="form-check-input" id="maintenance_signature_required" {{ config.maintenance_signature_required|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="maintenance_signature_required">{{ __('Signature du technicien obligatoire', 'remise') }}</label>
            <div class="form-text">{{ __('Si activé, le technicien doit signer la fiche (canvas tactile/souris) au moment de la création pour pouvoir la valider. Si désactivé, aucune signature n\'est demandée.', 'remise') }}</div>
          </div>
          <a href="{{ config('root_doc') }}/front/dropdown.php?itemtype=GlpiPlugin%5CRemise%5CMaintenanceChecklistItem" class="btn btn-outline-secondary">{{ __('Gérer les points de contrôle', 'remise') }}</a>
          <a href="{{ config('root_doc') }}/plugins/remise/front/maintenance.php" class="btn btn-outline-secondary">{{ __('Voir les fiches de maintenance', 'remise') }}</a>
        </div>

      </div>

      <button type="submit" name="update" class="btn btn-primary mt-3">{{ __('Enregistrer', 'remise') }}</button>
    </form>
  </div>
</div>
</div>

<div class="col" style="max-width: 420px; position: sticky; top: 1rem;">
  <div class="card">
    <div class="card-header">{{ __('Aperçu de la fiche générée', 'remise') }}</div>
    <div class="card-body p-2">
      <p class="text-muted small px-1">{{ __('Exemple avec des données fictives, mêmes gabarits Twig que le vrai PDF. L\'aperçu se met à jour automatiquement dès que vous modifiez un réglage ou changez d\'onglet, avant même d\'enregistrer.', 'remise') }}</p>
      <iframe id="remise-preview-frame" srcdoc="{{ preview_html|e('html_attr') }}" style="width: 100%; height: 640px; border: 1px solid #ddd; border-radius: 4px; background: #fff;"></iframe>
    </div>
  </div>
</div>
</div>

{% macro template_link(type) %}
  <div class="mb-3 d-flex gap-2">
    <a href="{{ config('root_doc') }}/plugins/remise/front/template.php?criteria[0][link]=AND&criteria[0][field]=2&criteria[0][searchtype]=equals&criteria[0][value]={{ type }}" class="btn btn-outline-secondary btn-sm">{{ __('Gérer les gabarits de ce type', 'remise') }}</a>
    <a href="{{ config('root_doc') }}/plugins/remise/front/template.form.php?id=0&type={{ type }}" class="btn btn-outline-secondary btn-sm">{{ __('+ Nouveau gabarit', 'remise') }}</a>
  </div>
{% endmacro %}

<script>
(function () {
  var fileInput = document.getElementById('remise-logo-file');
  var removeCheckbox = document.getElementById('remove_logo');
  var frame = document.getElementById('remise-preview-frame');

  function setPreviewLogo(dataUrl) {
    if (!frame.contentDocument) {
      return;
    }
    var img = frame.contentDocument.querySelector('.header-logo img');
    var wrapper = frame.contentDocument.querySelector('.header-logo');
    if (dataUrl) {
      if (!wrapper) {
        wrapper = frame.contentDocument.createElement('div');
        wrapper.className = 'header-logo';
        img = frame.contentDocument.createElement('img');
        img.alt = '';
        wrapper.appendChild(img);
        frame.contentDocument.body.insertBefore(wrapper, frame.contentDocument.body.firstChild);
      }
      img.src = dataUrl;
    } else if (wrapper) {
      wrapper.remove();
    }
  }

  if (fileInput) {
    fileInput.addEventListener('change', function () {
      if (removeCheckbox) {
        removeCheckbox.checked = false;
      }
      var file = fileInput.files && fileInput.files[0];
      if (!file) {
        return;
      }
      var reader = new FileReader();
      reader.onload = function (e) {
        setPreviewLogo(e.target.result);
      };
      reader.readAsDataURL(file);
    });
  }

  if (removeCheckbox) {
    removeCheckbox.addEventListener('change', function () {
      if (removeCheckbox.checked) {
        fileInput.value = '';
        setPreviewLogo(null);
      }
    });
  }

  // Chaque onglet de type (Remise/Restitution/Don/Vente) a son propre apercu :
  // au changement d'onglet, met a jour le champ "type" cache et redeclenche un
  // apercu (memes evenements 'change' que live-preview.js ecoute deja).
  var typeInput = document.getElementById('remise-preview-type');
  document.querySelectorAll('[data-bs-toggle="tab"]').forEach(function (tabButton) {
    tabButton.addEventListener('shown.bs.tab', function () {
      typeInput.value = tabButton.dataset.remisePreviewType;
      typeInput.dispatchEvent(new Event('change', { bubbles: true }));
    });
  });
})();
</script>
<script>
  window.REMISE_ROOT_DOC = {{ config('root_doc')|json_encode|raw }};
  // Jeton DEDIE a l'apercu en direct, independant de celui du formulaire
  // (champ _glpi_csrf_token, utilise par le vrai bouton Enregistrer) — cf.
  // commentaire de Config::showConfigForm().
  window.REMISE_PREVIEW_CSRF_TOKEN = {{ preview_csrf_token|json_encode|raw }};
</script>
<script src="{{ config('root_doc') }}/plugins/remise/js/sign/live-preview.js?v={{ constant('PLUGIN_REMISE_VERSION') }}"></script>
