<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ __('Étiquettes QR', 'assetsign') }}</title>
{# Issue #278 : planche A4 découpée en pages (une page imprimée = une planche d'étiquettes), mise
   en page selon les réglages de l'entité, ajustables pour cette impression. #}
<style>
  :root{ --ink:#16232f; --ink-soft:#5a6b78; --accent:#0d7a6e; --line:#d6dbd4; --paper:#eef1ee; }
  *{box-sizing:border-box;}
  @page{ size:A4; margin:0; }
  body{ margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; background:var(--paper); color:var(--ink); -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  .toolbar{ max-width:210mm; margin:0 auto; padding:16px 0; display:flex; flex-wrap:wrap; gap:12px; align-items:center; }
  .toolbar p{ margin:0; color:var(--ink-soft); font-size:.9rem; }
  button{ font:inherit; padding:8px 18px; border-radius:6px; border:1px solid var(--accent); background:var(--accent); color:#fff; cursor:pointer; }
  .toolbar .print{ margin-left:auto; }
  details.settings{ max-width:210mm; margin:0 auto 16px; background:#fff; border:1px solid var(--line); border-radius:8px; padding:12px 16px; font-size:.88rem; }
  details.settings summary{ cursor:pointer; font-weight:600; color:var(--accent); }
  details.settings form{ margin-top:12px; }
  .row{ display:flex; flex-wrap:wrap; gap:0 16px; }
  .mb-3{ margin-bottom:12px; }
  .align-self-end{ align-self:flex-end; }
  .form-label{ display:block; margin-bottom:4px; font-weight:500; }
  .form-control,.form-select{ font:inherit; padding:5px 8px; border:1px solid #c5ccc6; border-radius:4px; background:#fff; }
  textarea.form-control{ width:100%; font-family:ui-monospace,Consolas,monospace; }
  .form-text{ color:var(--ink-soft); font-size:.8rem; margin-top:4px; }
  .form-text code{ background:var(--paper); padding:0 3px; border-radius:3px; }
  .settings-actions{ display:flex; gap:12px; align-items:center; }
  .settings-actions a{ color:var(--ink-soft); }
  .page{ width:210mm; height:297mm; margin:0 auto 10mm; background:#fff; box-shadow:0 1px 6px rgba(0,0,0,.18); overflow:hidden; padding:{{ layout.margin_top }}mm 0 0 {{ layout.margin_left }}mm; }
  .grid{ display:grid; grid-template-columns:repeat({{ layout.columns }}, {{ layout.label_width }}mm); grid-auto-rows:{{ layout.label_height }}mm; column-gap:{{ layout.column_gap }}mm; row-gap:{{ layout.row_gap }}mm; }
{% include '@assetsign/_qr_label_styles.html.twig' %}
  .empty{ max-width:210mm; margin:0 auto; padding:16px; }
  @media print {
    body{ background:#fff; }
    .no-print{ display:none !important; }
    .page{ margin:0; box-shadow:none; break-after:page; page-break-after:always; }
    .page:last-child{ break-after:auto; page-break-after:auto; }
  }
</style>
</head>
<body>
<div class="toolbar no-print">
  <p>
    {{ _n('%d étiquette', '%d étiquettes', labels|length, 'assetsign')|format(labels|length) }}
    {% if labels is not empty %} · {{ _n('%d page', '%d pages', pages, 'assetsign')|format(pages) }}{% endif %}
    {% if skipped > 0 %} · {{ _n('%d matériel ignoré (non visible ou étiquette désactivée pour son entité)', '%d matériels ignorés (non visibles ou étiquette désactivée pour leur entité)', skipped, 'assetsign')|format(skipped) }}{% endif %}
  </p>
  {% if labels is not empty %}<button type="button" class="print" onclick="window.print()">{{ __('Imprimer', 'assetsign') }}</button>{% endif %}
</div>
{% if labels is empty %}
  <p class="empty">{{ __('Aucune étiquette à imprimer.', 'assetsign') }}</p>
{% else %}
  <details class="settings no-print"{{ customized ? ' open' : '' }}>
    <summary>{{ __('Réglages de la planche', 'assetsign') }}</summary>
    <form method="get" action="">
      <input type="hidden" name="batch" value="{{ batch_token }}">
      <input type="hidden" name="apply" value="1">
      {% include '@assetsign/_qr_label_settings_fields.html.twig' with {form: settings_form} %}
      <div class="settings-actions">
        <button type="submit">{{ __('Appliquer', 'assetsign') }}</button>
        {% if customized %}<a href="?batch={{ batch_token|url_encode }}">{{ __('Revenir aux réglages de l\'entité', 'assetsign') }}</a>{% endif %}
      </div>
      <p class="form-text">{{ __('Ces réglages ne valent que pour cette impression. Les réglages par défaut se changent dans la configuration du plugin (onglet Compléments).', 'assetsign') }}</p>
      <p class="form-text">{{ __('Dans la boîte d\'impression, choisissez la taille réelle (sans mise à l\'échelle) et aucune marge pour que les étiquettes tombent juste sur la planche.', 'assetsign') }}</p>
    </form>
  </details>
  {% for page in labels|batch(layout.per_page) %}
    <section class="page">
      <div class="grid">
        {% for label in page %}
          {% include '@assetsign/_qr_label_cell.html.twig' %}
        {% endfor %}
      </div>
    </section>
  {% endfor %}
{% endif %}
</body>
</html>
