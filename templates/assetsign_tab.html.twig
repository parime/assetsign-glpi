<div class="card">
  {# Issue #282 : bandeau recapitulatif du materiel (statut, utilisateur, numeros) : le technicien
     voit tout d'un coup d'oeil. Absent sur l'onglet d'un utilisateur (summary non fourni). #}
  {% if summary is defined %}
    <div class="card-header" style="border-left: 4px solid var(--tblr-primary);">
      {% include '@assetsign/_item_summary.html.twig' with {summary: summary, show_link: false} %}
    </div>
  {% endif %}
  <div class="card-body">
    {% if assetsigns|length == 0 %}
      <div class="empty py-4">
        <div class="empty-icon"><i class="ti ti-file-text fs-1 text-secondary"></i></div>
        <p class="empty-title">{{ __('Aucune attribution enregistrée pour ce matériel.', 'assetsign') }}</p>
        {% if summary is defined %}
          <p class="empty-subtitle text-secondary">{{ __('Les fiches de remise et de restitution sont créées automatiquement quand un utilisateur est affecté à ce matériel ou en est retiré.', 'assetsign') }}</p>
        {% endif %}
      </div>
    {% else %}
      <table class="table table-striped table-vcenter">
        <thead>
          <tr>
            {% if show_item_column %}<th>{{ __('Matériel', 'assetsign') }}</th>{% endif %}
            <th>{{ __('Référence', 'assetsign') }}</th>
            {% if types is defined %}<th>{{ __('Type', 'assetsign') }}</th>{% endif %}
            <th>{{ __('Statut', 'assetsign') }}</th>
            <th>{{ __('Créée le', 'assetsign') }}</th>
            <th>{{ __('Signée le', 'assetsign') }}</th>
            <th></th>
            <th>{{ __('PDF', 'assetsign') }}</th>
          </tr>
        </thead>
        <tbody>
          {% for r in assetsigns %}
          <tr>
            {% if show_item_column %}<td>{{ r.item_display|default('') }}</td>{% endif %}
            <td>{{ r.reference|default(r.id) }}</td>
            {% if types is defined %}
              <td><i class="{{ type_icons[r.type]|default('ti ti-file') }} me-1 text-secondary"></i>{{ types[r.type]|default('') }}</td>
            {% endif %}
            <td>
              {% if status_badges is defined %}
                <span class="badge {{ status_badges[r.status]|default('bg-secondary-lt') }}">{% if r.status == 10 %}<i class="ti ti-writing-sign me-1"></i>{% endif %}{{ statuses[r.status] }}</span>
              {% else %}
                {{ statuses[r.status] }}
              {% endif %}
            </td>
            <td>{{ r.date_creation }}</td>
            <td>{{ r.date_signed|default('-') }}</td>
            <td>
              <a href="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php?id={{ r.id }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-eye me-1"></i>{{ __('Voir', 'assetsign') }}</a>
              {# Issues #170 et #163 : brouillon pas encore envoye (tous types de fiche) #}
              {% if r.status == 0 and can_send_drafts|default(false) %}
                <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php" class="d-inline ms-2">
                  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                  <input type="hidden" name="id" value="{{ r.id }}">
                  <button type="submit" name="send_draft" class="btn btn-sm btn-primary"><i class="ti ti-send me-1"></i>{{ __('Envoyer pour signature', 'assetsign') }}</button>
                </form>
              {% endif %}
            </td>
            <td>
              {% if r.document_id_paper_scan|default(0) %}
                {# Issue #276 : scan du papier signé à la main. #}
                <a href="{{ config('root_doc') }}/front/document.send.php?docid={{ r.document_id_paper_scan }}" target="_blank"><i class="ti ti-writing-sign me-1"></i>{{ __('Télécharger (scan signé sur papier)', 'assetsign') }}</a>
              {% elseif r.document_id_signed %}
                <a href="{{ config('root_doc') }}/front/document.send.php?docid={{ r.document_id_signed }}" target="_blank">{{ __('Télécharger (signé)', 'assetsign') }}</a>
              {% elseif r.document_id_unsigned %}
                <a href="{{ config('root_doc') }}/front/document.send.php?docid={{ r.document_id_unsigned }}" target="_blank">{{ __('Télécharger (non signé)', 'assetsign') }}</a>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}

    {% if can_create_manual %}
      <hr>
      {# Issue #322 : attestation d'effacement exigée par l'entité et absente. #}
      {% if wipe_notice|default(null) %}
        <div class="alert {{ wipe_notice.blocking ? 'alert-danger' : 'alert-warning' }} d-flex align-items-center gap-2" id="assetsign-wipe-notice">
          <i class="ti ti-eraser fs-2"></i>
          <div class="flex-fill">{{ wipe_notice.message }}</div>
          <a href="{{ wipe_notice.url }}" class="btn btn-sm {{ wipe_notice.blocking ? 'btn-danger' : 'btn-warning' }}">{{ __('Enregistrer l\'attestation', 'assetsign') }}</a>
        </div>
      {% endif %}
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assetsign.form.php" enctype="multipart/form-data" class="row g-2 align-items-end" id="assetsign-manual-form">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="itemtype" value="{{ item.getType() }}">
        <input type="hidden" name="items_id" value="{{ item.getID() }}">
        <input type="hidden" name="create_manual" value="1">
        <input type="hidden" name="type" id="assetsign-manual-type" value="{{ manual_types|keys|first }}">

        {% include '@assetsign/_manual_sheet_fields.html.twig' with {entities_id: item.fields.entities_id} %}

        <div class="col-auto">
          {% for value, label in manual_types %}
            <button type="button" class="btn btn-outline-secondary assetsign-manual-type-btn" data-type="{{ value }}">
              <i class="{{ type_icons[value]|default('ti ti-file') }} me-1"></i>{{ __('Créer une fiche de %s', 'assetsign')|format(label|lower) }}
            </button>
          {% endfor %}
          <button type="submit" class="btn btn-primary assetsign-manual-submit-btn" style="display: none;">
            {{ __('Valider', 'assetsign') }}
          </button>
        </div>
      </form>
      <script>
        (function () {
          var form = document.getElementById('assetsign-manual-form');
          var typeInput = document.getElementById('assetsign-manual-type');
          // Un seul groupe generique (assetsign-manual-type-field), chacun taggé
          // EN PLUS avec la classe de son propre type (assetsign-manual-vente-field,
          // -don-field, -destruction-field...) : permet d'ajouter un futur type sans
          // reecrire cette logique de bascule, seulement son propre groupe de champs
          // dans le formulaire ci-dessus.
          var allTypeFields = form.querySelectorAll('.assetsign-manual-type-field');
          var typeFieldClasses = {
            '{{ type_vente }}': 'assetsign-manual-vente-field',
            '{{ type_don }}': 'assetsign-manual-don-field',
            '{{ type_destruction }}': 'assetsign-manual-destruction-field'
          };
          var internalFields = form.querySelectorAll('.assetsign-manual-internal-field');
          var externalFields = form.querySelectorAll('.assetsign-manual-external-field');
          var beneficiaryRadios = form.querySelectorAll('input[name="beneficiary_type"]');
          var typeButtons = form.querySelectorAll('.assetsign-manual-type-btn');
          var submitBtn = form.querySelector('.assetsign-manual-submit-btn');

          function toggleTypeFields() {
            var activeClass = typeFieldClasses[typeInput.value];
            allTypeFields.forEach(function (el) {
              el.style.display = (activeClass && el.classList.contains(activeClass)) ? '' : 'none';
            });
          }

          // Chaque bouton "Créer une fiche de X" fixe le type et révèle les
          // champs à compléter (prix, date, bénéficiaire externe...), SANS
          // soumettre le formulaire : type="button", pas "submit". Avant ce
          // correctif, le bouton était lui-même de type submit, ce qui créait
          // la fiche dès le premier clic, avant même que ces champs ne soient
          // visibles à l'écran - bug réel signalé par l'utilisateur (fiche de
          // vente enregistrée avec un prix à 0 et la date du jour, sans qu'il
          // ait pu saisir quoi que ce soit). Un unique bouton "Valider",
          // révélé seulement après le choix d'un type, soumet réellement.
          typeButtons.forEach(function (btn) {
            btn.addEventListener('click', function () {
              typeInput.value = btn.dataset.type;
              typeButtons.forEach(function (b) { b.classList.toggle('active', b === btn); });
              toggleTypeFields();
              submitBtn.style.display = '';
            });
          });

          function toggleBeneficiaryFields() {
            var isExternal = form.querySelector('input[name="beneficiary_type"]:checked').value === '1';
            internalFields.forEach(function (el) { el.style.display = isExternal ? 'none' : ''; });
            externalFields.forEach(function (el) { el.style.display = isExternal ? '' : 'none'; });
          }
          beneficiaryRadios.forEach(function (radio) {
            radio.addEventListener('change', toggleBeneficiaryFields);
          });

          toggleTypeFields();
          toggleBeneficiaryFields();

          {% if prefill_type|default(null) is not null %}
            // Arrivee via le lien "creez maintenant la fiche" (cf.
            // Assetsign::handleStateBasedTrigger()) : simule le clic sur le bon
            // bouton de type plutot que de laisser le technicien le rechercher.
            var prefillBtn = form.querySelector('.assetsign-manual-type-btn[data-type="{{ prefill_type }}"]');
            if (prefillBtn) {
              prefillBtn.click();
              form.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          {% endif %}
        })();
      </script>
    {% endif %}

    {% if can_assign_asset|default(false) %}
      <hr>
      <h3>{{ __('Assigner un matériel à cet utilisateur', 'assetsign') }}</h3>
      <p class="text-muted small">{{ __('L\'affectation déclenche automatiquement la création d\'une attribution, comme depuis la fiche du matériel.', 'assetsign') }}</p>
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assign_user_asset.php" class="row g-2 align-items-end">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="users_id" value="{{ target_user_id }}">
        <div class="col-auto">
          <label class="form-label">{{ __('Type de matériel', 'assetsign') }}</label>
          {{ itemtype_dropdown_html|raw }}
        </div>
        <div class="col-auto">
          <label class="form-label">{{ __('Matériel', 'assetsign') }}</label><br>
          {{ item_dropdown_html|raw }}
        </div>
        <div class="col-auto">
          <button type="submit" name="assign" class="btn btn-secondary">{{ __('Assigner', 'assetsign') }}</button>
        </div>
      </form>
    {% endif %}
  </div>
</div>
