{# Issue #282 : nouvelle attribution depuis la liste. Étape 1 : rechercher le matériel (nom, n° de
   série, n° d'inventaire). Étape 2 : bandeau récapitulatif du matériel et choix de l'action en
   cartes, puis le formulaire de l'action choisie. Seuls les matériels lisibles par l'utilisateur
   sont proposés (cf. Assetsign::searchItems()). #}
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <h2 class="mb-0 me-auto"><i class="ti ti-file-plus me-2"></i>{{ __('Nouvelle attribution', 'assetsign') }}</h2>
  <a href="{{ list_url }}" class="btn btn-outline-secondary"><i class="ti ti-list me-1"></i>{{ __('Retour à la liste', 'assetsign') }}</a>
</div>

{% if item is not defined %}
  <div class="card mb-3">
    <div class="card-header"><h3 class="card-title">{{ __('1. Choisir le matériel', 'assetsign') }}</h3></div>
    <div class="card-body">
      <form method="get" action="{{ form_url }}" class="row g-2 align-items-end" role="search">
        <div class="col-12 col-md">
          <label class="form-label" for="assetsign-new-search">{{ __('Rechercher le matériel', 'assetsign') }}</label>
          <input type="search" name="q" id="assetsign-new-search" class="form-control" value="{{ q }}" minlength="2" required autofocus
                 placeholder="{{ __('Nom, n° de série ou n° d\'inventaire', 'assetsign') }}">
        </div>
        <div class="col-12 col-md-auto">
          <button type="submit" class="btn btn-primary w-100"><i class="ti ti-search me-1"></i>{{ __('Rechercher', 'assetsign') }}</button>
        </div>
      </form>

      {% if q is not empty %}
        {% if results is empty %}
          <div class="empty py-4">
            <div class="empty-icon"><i class="ti ti-search-off fs-1 text-secondary"></i></div>
            <p class="empty-title">{{ __('Aucun matériel trouvé.', 'assetsign') }}</p>
            <p class="empty-subtitle text-secondary">{{ __('Saisissez au moins deux caractères du nom, du n° de série ou du n° d\'inventaire.', 'assetsign') }}</p>
          </div>
        {% else %}
          <div class="list-group mt-3">
            {% for r in results %}
              <a href="{{ form_url }}?{{ {itemtype: r.itemtype, items_id: r.id}|url_encode }}" class="list-group-item list-group-item-action">
                <div class="d-flex align-items-center gap-3">
                  <span class="avatar bg-primary-lt"><i class="{{ r.icon }}"></i></span>
                  <div class="flex-fill">
                    <div class="fw-bold">{{ r.name ?: '-' }} <span class="text-secondary fw-normal">· {{ r.type }}</span></div>
                    <div class="small text-secondary">
                      {{ __('N° de série', 'assetsign') }} : {{ r.serial ?: '-' }} · {{ __('N° d\'inventaire', 'assetsign') }} : {{ r.otherserial ?: '-' }}
                      {% if r.user %} · <i class="ti ti-user"></i> {{ r.user }}{% endif %}
                    </div>
                  </div>
                  <i class="ti ti-chevron-right text-secondary"></i>
                </div>
              </a>
            {% endfor %}
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="card mb-3" style="border-left: 4px solid var(--tblr-primary);">
    <div class="card-body">
      {% include '@assetsign/_item_summary.html.twig' with {summary: summary, show_link: true} %}
      <div class="mt-2"><a href="{{ form_url }}" class="small"><i class="ti ti-arrow-left me-1"></i>{{ __('Choisir un autre matériel', 'assetsign') }}</a></div>
    </div>
  </div>

  <div class="card mb-3" id="assetsign-new-actions">
    <div class="card-header"><h3 class="card-title">{{ __('2. Choisir l\'action', 'assetsign') }}</h3></div>
    <div class="card-body">
      <div class="row g-2" role="radiogroup" aria-label="{{ __('2. Choisir l\'action', 'assetsign') }}">
        {% for c in cards %}
          <div class="col-12 col-sm-6 col-lg">
            <input type="radio" class="btn-check" name="assetsign_action" id="assetsign-action-{{ c.type }}" value="{{ c.type }}"
                   data-action="{{ c.action }}" autocomplete="off" {{ c.reason ? 'disabled' : '' }}>
            <label class="card card-sm h-100 assetsign-action-card" for="assetsign-action-{{ c.type }}">
              <span class="card-body d-flex flex-column gap-1">
                <span class="d-flex align-items-center gap-2">
                  <span class="avatar avatar-sm bg-primary-lt"><i class="{{ c.icon }}"></i></span>
                  <span class="fw-bold">{{ c.label }}</span>
                </span>
                <span class="small text-secondary">{{ c.help }}</span>
                {% if c.reason %}<span class="small text-warning"><i class="ti ti-lock me-1"></i>{{ c.reason }}</span>{% endif %}
              </span>
            </label>
          </div>
        {% endfor %}
      </div>

      {# Remise : affecter le matériel à un utilisateur déclenche la feuille, comme depuis sa fiche. #}
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assign_user_asset.php" class="row g-2 align-items-end mt-3 assetsign-action-form" data-action="handover" hidden>
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="itemtype" value="{{ item.getType() }}">
        <input type="hidden" name="items_id" value="{{ item.getID() }}">
        <input type="hidden" name="open_sheet" value="1">
        <div class="col-12 col-md-auto">
          <label class="form-label">{{ __('Destinataire', 'assetsign') }}</label>
          {% do call('User::dropdown', [{'name': 'users_id', 'right': 'all', 'entity': item.fields.entities_id, 'display_emptychoice': false}]) %}
        </div>
        <div class="col-12 col-md-auto">
          <button type="submit" name="assign" class="btn btn-primary w-100"><i class="ti ti-user-check me-1"></i>{{ __('Préparer la feuille', 'assetsign') }}</button>
        </div>
      </form>

      {# Restitution : retirer l'utilisateur du matériel déclenche la feuille de restitution. #}
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assign_user_asset.php" class="mt-3 assetsign-action-form" data-action="return" hidden>
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="itemtype" value="{{ item.getType() }}">
        <input type="hidden" name="items_id" value="{{ item.getID() }}">
        <input type="hidden" name="users_id" value="0">
        <input type="hidden" name="open_sheet" value="1">
        {% if summary.user %}
          <p class="mb-2">{{ __('Le matériel est retiré à %s, qui signera la restitution.', 'assetsign')|format(summary.user) }}</p>
        {% endif %}
        <button type="submit" name="assign" class="btn btn-primary"><i class="ti ti-arrow-back-up me-1"></i>{{ __('Préparer la feuille', 'assetsign') }}</button>
      </form>

      {# Don, vente, destruction : création manuelle, mêmes champs que l'onglet du matériel. #}
      <form method="post" action="{{ form_url }}" enctype="multipart/form-data" class="row g-2 align-items-end mt-3 assetsign-action-form" data-action="manual" id="assetsign-manual-form" hidden>
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="itemtype" value="{{ item.getType() }}">
        <input type="hidden" name="items_id" value="{{ item.getID() }}">
        <input type="hidden" name="create_manual" value="1">
        <input type="hidden" name="open_sheet" value="1">
        <input type="hidden" name="type" id="assetsign-manual-type" value="">
        {% include '@assetsign/_manual_sheet_fields.html.twig' with {entities_id: item.fields.entities_id} %}
        <div class="col-12 col-md-auto">
          <button type="submit" class="btn btn-primary w-100"><i class="ti ti-check me-1"></i>{{ __('Préparer la feuille', 'assetsign') }}</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    (function () {
      var root = document.getElementById('assetsign-new-actions');
      var forms = root.querySelectorAll('.assetsign-action-form');
      var manualForm = document.getElementById('assetsign-manual-form');
      var typeInput = document.getElementById('assetsign-manual-type');
      var typeFieldClasses = {
        '{{ type_vente }}': 'assetsign-manual-vente-field',
        '{{ type_don }}': 'assetsign-manual-don-field',
        '{{ type_destruction }}': 'assetsign-manual-destruction-field'
      };

      function showAction(radio) {
        forms.forEach(function (f) { f.hidden = f.dataset.action !== radio.dataset.action; });
        if (radio.dataset.action === 'manual') {
          typeInput.value = radio.value;
          manualForm.querySelectorAll('.assetsign-manual-type-field').forEach(function (el) {
            el.style.display = el.classList.contains(typeFieldClasses[radio.value]) ? '' : 'none';
          });
        }
      }
      root.querySelectorAll('input[name="assetsign_action"]').forEach(function (radio) {
        radio.addEventListener('change', function () { showAction(radio); });
      });

      function toggleBeneficiaryFields() {
        var isExternal = manualForm.querySelector('input[name="beneficiary_type"]:checked').value === '1';
        manualForm.querySelectorAll('.assetsign-manual-internal-field').forEach(function (el) { el.style.display = isExternal ? 'none' : ''; });
        manualForm.querySelectorAll('.assetsign-manual-external-field').forEach(function (el) { el.style.display = isExternal ? '' : 'none'; });
      }
      manualForm.querySelectorAll('input[name="beneficiary_type"]').forEach(function (radio) {
        radio.addEventListener('change', toggleBeneficiaryFields);
      });
      toggleBeneficiaryFields();

      // Une seule action possible : choisie d'office.
      var enabled = root.querySelectorAll('input[name="assetsign_action"]:not(:disabled)');
      if (enabled.length === 1) {
        enabled[0].checked = true;
        showAction(enabled[0]);
      }
    })();
  </script>
{% endif %}
