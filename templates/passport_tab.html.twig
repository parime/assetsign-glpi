<div class="passport-identity-card mb-4">
  <div class="row g-2">
    {% if identity.model or identity.manufacturer %}
      <div class="col-auto"><strong>{{ __('Modèle', 'assetsign') }} :</strong> {{ identity.manufacturer }}{{ identity.manufacturer and identity.model ? ' — ' : '' }}{{ identity.model }}</div>
    {% endif %}
    {% if identity.serial %}
      <div class="col-auto"><strong>{{ __('N° série', 'assetsign') }} :</strong> {{ identity.serial }}</div>
    {% endif %}
    {% if identity.state %}
      <div class="col-auto"><strong>{{ __('État', 'assetsign') }} :</strong> {{ identity.state }}</div>
    {% endif %}
    {% if identity.user %}
      <div class="col-auto"><strong>{{ __('Utilisateur actuel', 'assetsign') }} :</strong> {{ identity.user }}</div>
    {% endif %}
    <div class="col-auto"><strong>{{ __('Entité', 'assetsign') }} :</strong> {{ identity.entity }}</div>
    {% if identity.buy_date %}
      <div class="col-auto"><strong>{{ __('Achat', 'assetsign') }} :</strong> {{ identity.buy_date|formatted_date }}</div>
    {% endif %}
    {% if identity.warranty_end %}
      <div class="col-auto"><strong>{{ __('Fin de garantie', 'assetsign') }} :</strong> {{ identity.warranty_end|formatted_date }}</div>
    {% endif %}
    {% if identity.age %}
      <div class="col-auto"><strong>{{ __('Âge', 'assetsign') }} :</strong> {{ identity.age }}</div>
    {% endif %}
    {% if identity.used_duration %}
      <div class="col-auto"><strong>{{ __('Temps utilisé', 'assetsign') }} :</strong> {{ identity.used_duration }}{{ identity.used_percent is not null ? ' (' ~ identity.used_percent ~ '%)' : '' }}</div>
    {% endif %}
    {% if identity.stock_duration %}
      <div class="col-auto"><strong>{{ __('Temps en stock', 'assetsign') }} :</strong> {{ identity.stock_duration }}</div>
    {% endif %}
    {% if identity.residual_value %}
      <div class="col-auto">
        <strong>{{ identity.residual_value_is_manual ? __('Valeur résiduelle (saisie manuelle)', 'assetsign') : __('Valeur résiduelle (estimée)', 'assetsign') }} :</strong>
        {{ identity.residual_value }}
      </div>
    {% endif %}
  </div>
</div>

{% if residual_value_enabled and can_backfill %}
  <div class="mb-4">
    <div class="d-flex align-items-end gap-2 flex-wrap">
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/residualvalue.form.php" class="d-flex align-items-end gap-2">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="itemtype" value="{{ itemtype }}">
        <input type="hidden" name="items_id" value="{{ items_id }}">
        <div>
          <label class="form-label mb-0" for="residual_value_manual">{{ __('Valeur résiduelle manuelle', 'assetsign') }}</label>
          <input type="number" step="0.01" min="0" name="manual_value" id="residual_value_manual" class="form-control" style="width: 140px;" value="{{ residual_value_manual_raw is not null ? residual_value_manual_raw : '' }}">
        </div>
        <button type="submit" class="btn btn-sm btn-outline-primary">{{ __('Enregistrer', 'assetsign') }}</button>
      </form>
      {% if residual_value_manual_raw is not null %}
        <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/residualvalue.form.php">
          <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="itemtype" value="{{ itemtype }}">
          <input type="hidden" name="items_id" value="{{ items_id }}">
          <input type="hidden" name="manual_value" value="">
          <button type="submit" class="btn btn-sm btn-outline-secondary">{{ __('Revenir au calcul automatique', 'assetsign') }}</button>
        </form>
      {% endif %}
    </div>
    <div class="form-text">{{ __('Une valeur saisie ici l\'emporte toujours sur le calcul automatique.', 'assetsign') }}</div>
  </div>
{% endif %}

{% if health %}
  <div class="mb-4">
    <strong>{{ __('Score de santé', 'assetsign') }} :</strong>
    <span class="badge" style="background-color: {{ health.color }}; color: #fff;">{{ health.score }}/100</span>
    <ul class="passport-health-breakdown text-muted small mb-0 mt-1">
      {% for factor in health.breakdown %}
        {% if factor.weight > 0 %}
          <li>{{ factor.label }} : {{ factor.degradation }}% {{ __('de dégradation', 'assetsign') }} ({{ __('poids', 'assetsign') }} {{ factor.weight }})</li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
{% endif %}

{% if can_backfill or qr_label_enabled %}
  <div class="d-flex flex-wrap gap-2 mb-2">
    {% if can_backfill %}
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/passport_backfill.php" class="m-0">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="itemtype" value="{{ itemtype }}">
        <input type="hidden" name="items_id" value="{{ items_id }}">
        <button type="submit" class="btn btn-sm btn-outline-secondary">
          <i class="ti ti-history"></i> {{ __('Forcer la recherche dans l\'historique', 'assetsign') }}
        </button>
      </form>
    {% endif %}
    {% if qr_label_enabled %}
      <a href="{{ qr_label_url }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">
        <i class="ti ti-qrcode"></i> {{ __('Imprimer une étiquette QR code', 'assetsign') }}
      </a>
    {% endif %}
  </div>
{% endif %}

<div class="passport-summary mb-4">
  <h4>{{ __('Vies du matériel', 'assetsign') }} <span class="badge bg-blue-lt">{{ lives|length }}</span></h4>
  {% if lives|length %}
    <ul class="passport-lives-list">
      {% for life in lives %}
        <li>
          <strong>{{ life.name }}</strong>
          {% if life.is_external %}<span class="badge bg-secondary-lt ms-1">{{ __('externe', 'assetsign') }}</span>{% endif %}
          <span class="text-muted small ms-2">
            {{ life.start|formatted_date }} → {{ life.end ? life.end|formatted_date : __('aujourd\'hui', 'assetsign') }}
            ({{ life.duration }})
          </span>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="text-muted">{{ __('Aucune attribution enregistrée pour le moment.', 'assetsign') }}</p>
  {% endif %}
</div>

<h4>{{ __('Historique', 'assetsign') }}</h4>
{% if events|length %}
  <div class="passport-timeline">
    {% for event in events %}
      <div class="passport-timeline-item">
        <div class="passport-timeline-marker">
          {% if loop.first %}
            <span class="passport-timeline-dot"></span>
          {% else %}
            <i class="ti ti-circle-check passport-timeline-check"></i>
          {% endif %}
        </div>
        <div class="passport-timeline-body">
          <div class="passport-timeline-date text-muted small">{{ event.date|relative_datetime }}</div>
          <div class="passport-timeline-content">
            <strong>{{ event.type_label }}</strong>
            {% if event.snapshot_name %}
              — {{ event.snapshot_name }}
              {% if event.snapshot_is_external %}<span class="badge bg-secondary-lt">{{ __('externe', 'assetsign') }}</span>{% endif %}
            {% elseif event.is_anonymized %}
              — <span class="text-muted">{{ __('bénéficiaire anonymisé', 'assetsign') }}</span>
            {% endif %}
            {% if event.comment %}
              <div class="text-muted small">{{ event.comment }}</div>
            {% endif %}
            {% if event.checklist_summary is defined %}
              <div class="mt-1">
                <span class="badge" style="background-color: {{ event.checklist_summary.color }}; color: #fff;">
                  <i class="ti ti-checklist"></i> {{ event.checklist_summary.done }}/{{ event.checklist_summary.total }} {{ __('contrôles qualité', 'assetsign') }}
                </span>
              </div>
            {% endif %}
            {% if event.movement_summary is defined %}
              <div class="mt-1">
                <span class="text-muted small">
                  {{ event.movement_summary.location_from|default(__('lieu inconnu', 'assetsign')) }}
                  <i class="ti ti-arrow-right"></i>
                  {{ event.movement_summary.location_to|default(__('lieu inconnu', 'assetsign')) }}
                </span>
                <span class="badge" style="background-color: {{ event.movement_summary.status_color }}; color: #fff;">{{ event.movement_summary.status_label }}</span>
              </div>
            {% endif %}
            {% if event.source_url %}
              <div><a href="{{ event.source_url }}">{{ __('Voir la fiche', 'assetsign') }}</a></div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
{% else %}
  <p class="text-muted">{{ __('Aucun événement enregistré pour le moment.', 'assetsign') }}</p>
{% endif %}
