{# Issue #158 : rapport PDF d'une campagne d'attestation, preuve d'audit (A.5.9). Généré à la
   demande par la personne qui consulte la campagne : textes traduits dans la langue de sa session
   (issue #208) ; les libellés de statut et d'écart viennent du contrôleur. #}
<!DOCTYPE html>
<html lang="{{ html_lang|default('fr') }}">
<head>
<meta charset="UTF-8">
<title>{{ __('Campagne d\'attestation — %s', 'assetsign')|format(campaign.name) }}</title>
{% include '@assetsign/pdf/_pdf_style.html.twig' %}
</head>
<body>

{% if company_name %}
<div class="header-logo"><div class="company-name">{{ company_name }}</div></div>
{% endif %}

<h1>{{ __('Campagne d\'attestation de détention', 'assetsign') }}</h1>
<p class="meta">{{ __('%1$s — rapport généré le %2$s', 'assetsign')|format(campaign.name, generated_at) }}</p>

<table class="info-table">
    <tr><th>{{ __('Lancée le', 'assetsign') }}</th><td>{{ campaign.date_creation|date('d/m/Y') }}</td></tr>
    <tr><th>{{ __('Date limite', 'assetsign') }}</th><td>{{ campaign.date_deadline ? campaign.date_deadline|date('d/m/Y') : '—' }}</td></tr>
    <tr><th>{{ __('Personnes concernées', 'assetsign') }}</th><td>{{ stats.total }}</td></tr>
    <tr><th>{{ __('Attestations confirmées', 'assetsign') }}</th><td>{{ stats.confirmed }}</td></tr>
    <tr><th>{{ __('Écarts signalés', 'assetsign') }}</th><td>{{ stats.discrepancy }}</td></tr>
    <tr><th>{{ __('Sans réponse', 'assetsign') }}</th><td>{{ stats.pending }}</td></tr>
    <tr><th>{{ __('Taux de réponse', 'assetsign') }}</th><td>{{ stats.response_rate }} %</td></tr>
</table>

<h2>{{ __('Détail', 'assetsign') }}</h2>
<table class="info-table">
    <tr><th>{{ __('Personne', 'assetsign') }}</th><th>{{ __('Matériels', 'assetsign') }}</th><th>{{ __('Statut', 'assetsign') }}</th><th>{{ __('Réponse', 'assetsign') }}</th><th>{{ __('Écart', 'assetsign') }}</th></tr>
    {% for line in lines %}
    <tr>
        <td>{{ line.user }}</td>
        <td>{{ line.items }}</td>
        <td>{{ status_labels[line.status] }}</td>
        <td>{{ line.date_answered ? line.date_answered|date('d/m/Y H:i') : '—' }}</td>
        <td>{% for gap in line.gaps %}{{ gap_labels[gap] }}<br>{% endfor %}{{ line.comment }}{% if line.tickets_id > 0 %} {{ __('(ticket n°%d)', 'assetsign')|format(line.tickets_id) }}{% endif %}</td>
    </tr>
    {% endfor %}
</table>

</body>
</html>
