<style>
    body { font-family: 'DejaVu Sans', sans-serif; font-size: 11px; color: #1c2b3a; }
    h1 { font-size: 18px; margin-bottom: 2px; }
    h2 { font-size: 13px; margin-top: 18px; margin-bottom: 6px; border-bottom: 1px solid #ccc; padding-bottom: 2px; }
    .meta { color: #555; margin-bottom: 14px; }
    table.info-table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
    table.info-table th { text-align: left; width: 35%; padding: 3px 6px; background: #f2f2f2; font-weight: normal; color: #555; }
    table.info-table td { padding: 3px 6px; }
    table.data-table { width: 100%; border-collapse: collapse; margin-bottom: 8px; font-size: 0.95em; }
    table.data-table th { text-align: left; padding: 3px 6px; background: #f2f2f2; font-weight: normal; color: #555; }
    table.data-table td { padding: 3px 6px; border-bottom: 1px solid #e5e5e5; }
    ul.accessories { margin: 4px 0; padding-left: 18px; }
    .legal-text { font-size: 9.5px; color: #333; line-height: 1.4; text-align: justify; }
    .signature-zone { margin-top: 24px; border-top: 1px solid #ccc; padding-top: 10px; }
    .signature-img { max-width: 220px; max-height: 90px; border-bottom: 1px solid #999; }
    .proof { font-size: 8px; color: #888; margin-top: 6px; }
    .footer { position: fixed; bottom: -20px; left: 0; right: 0; font-size: 8px; color: #999; text-align: center; }
    .header-logo { text-align: right; margin-bottom: 4px; }
    .header-logo img { max-height: 60px; max-width: 220px; }
    .header-logo .company-name { font-weight: bold; font-size: 12px; color: #1c2b3a; }
    .qr-block { text-align: center; margin-top: 14px; }
    .qr-block img { width: 26mm; height: 26mm; }
    .damage-pdf-views { margin-top: 6px; font-size: 0; }
    .damage-pdf-col { display: inline-block; vertical-align: top; width: 31%; margin: 0 3.5% 10px 0; page-break-inside: avoid; font-size: 11px; }
    .damage-pdf-col:last-child { margin-right: 0; }
    .damage-pdf-view { position: relative; height: 0; overflow: hidden; }
    .damage-pdf-img { position: absolute; top: 0; left: 0; width: 100%; display: block; }
    .damage-pdf-marker { position: absolute; width: 9px; height: 9px; margin-left: -5px; margin-top: -5px; border-radius: 50%; background: rgba(240, 180, 20, 0.9); border: 1px solid #fff; }
    .damage-pdf-marker-major { background: rgba(210, 40, 40, 0.9); }
    .damage-pdf-label { font-size: 9px; color: #555; text-align: center; margin: 4px 0 2px; }
    .damage-pdf-desc { font-size: 8.5px; color: #333; margin: 0; padding-left: 14px; }
    .checklist { margin: 4px 0; padding-left: 0; list-style: none; }
    .checklist li { padding: 3px 6px; border-bottom: 1px solid #eee; }
    .checklist li:last-child { border-bottom: none; }
    .checklist .value { color: #555; }
    {# Issue #274 : en-tete de maitrise documentaire (cf. _doc_header.html.twig). Dans le PDF, la
       marge haute de chaque page est agrandie pour l'accueillir ; dans l'apercu (navigateur), il
       s'affiche simplement en haut de la fiche. #}
    {% if doc_header|default(null) %}
    {% if not doc_header.preview %}
    @page { margin-top: 34mm; }
    .doc-header { position: fixed; top: -28mm; left: 0; right: 0; height: 24mm; overflow: hidden; }
    .dh-page-num:before { content: counter(page); }
    {% else %}
    .doc-header { margin-bottom: 12px; }
    {% endif %}
    table.doc-header-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    table.doc-header-table td { border: 1px solid #1c2b3a; padding: 3px 5px; vertical-align: middle; font-size: 8px; line-height: 1.3; }
    td.dh-org { width: 26%; font-weight: bold; font-size: 9px; text-align: center; }
    td.dh-title { width: 46%; text-align: center; }
    .dh-type { font-size: 7.5px; text-transform: uppercase; letter-spacing: 0.5px; color: #555; margin-bottom: 2px; }
    .dh-name { font-size: 11px; font-weight: bold; }
    td.dh-meta { width: 28%; }
    .dh-page { font-weight: bold; }
    {% endif %}
</style>
