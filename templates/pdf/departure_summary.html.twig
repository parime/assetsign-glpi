{# Issue #157 : PDF récapitulatif de la restitution groupée d'un départ. Textes traduits dans la
   langue de la personne qui part (issue #208, cf. Pdf\PdfLanguage), quelle que soit la session.
   Chaque matériel garde en plus sa propre fiche de restitution signée, dont l'empreinte SHA-256
   est rappelée ici. #}
<!DOCTYPE html>
<html lang="{{ html_lang|default('fr') }}">
<head>
<meta charset="UTF-8">
<title>{{ __('Restitution de départ — %s', 'assetsign')|format(user_name) }}</title>
{% include '@assetsign/pdf/_pdf_style.html.twig' %}
</head>
<body>

{% if company_name %}
<div class="header-logo"><div class="company-name">{{ company_name }}</div></div>
{% endif %}

<h1>{{ __('Restitution du matériel — départ', 'assetsign') }}</h1>
<p class="meta">{{ __('Signée le %s', 'assetsign')|format(signed_at) }}</p>

<h2>{{ __('Personne qui part', 'assetsign') }}</h2>
<table class="info-table">
    <tr><th>{{ __('Nom', 'assetsign') }}</th><td>{{ user_name }}</td></tr>
    <tr><th>{{ __('Date de départ', 'assetsign') }}</th><td>{{ departure_date ?: '—' }}</td></tr>
</table>

<h2>{{ __('Matériel restitué', 'assetsign') }}</h2>
<table class="info-table">
    <tr><th>{{ __('Type', 'assetsign') }}</th><th>{{ __('Matériel', 'assetsign') }}</th><th>{{ __('N° de série', 'assetsign') }}</th><th>{{ __('N° d\'inventaire', 'assetsign') }}</th><th>{{ __('Fiche n°', 'assetsign') }}</th></tr>
    {% for line in lines %}
    <tr>
        <td>{{ line.type_label }}</td>
        <td>{{ line.name }}</td>
        <td>{{ line.serial }}</td>
        <td>{{ line.otherserial }}</td>
        <td>{{ line.assetsign_id }}</td>
    </tr>
    {% endfor %}
</table>
<p style="font-size: 8px;">{{ __('Chaque matériel dispose de sa propre fiche de restitution signée (PDF joint à la fiche). Empreintes SHA-256 de ces PDF :', 'assetsign') }}
{% for line in lines %}<br>{{ __('Fiche n°%1$d : %2$s', 'assetsign')|format(line.assetsign_id, hashes[line.assetsign_id]|default('—')) }}{% endfor %}</p>

<h2>{{ __('Signature', 'assetsign') }}</h2>
<p>{{ __('Je confirme restituer l\'ensemble du matériel listé ci-dessus.', 'assetsign') }}</p>
<img src="{{ signature_image }}" alt="" style="max-height: 120px; border: 1px solid #ccc;">
<table class="info-table">
    <tr><th>{{ __('Signataire', 'assetsign') }}</th><td>{{ user_name }}</td></tr>
    <tr><th>{{ __('Date et heure', 'assetsign') }}</th><td>{{ signed_at }}</td></tr>
    {% if witness_name %}<tr><th>{{ __('Recueillie en présence de', 'assetsign') }}</th><td>{{ witness_name }}</td></tr>{% endif %}
    {% if ip_address %}<tr><th>{{ __('Adresse IP', 'assetsign') }}</th><td>{{ ip_address }}</td></tr>{% endif %}
</table>

</body>
</html>
