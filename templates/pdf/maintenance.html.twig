{% set _now = "now"|date('d/m/Y') %}
<!DOCTYPE html>
<html lang="{{ html_lang|default('fr') }}">
<head>
<meta charset="UTF-8">
<title>{{ document_title }}</title>
{% include '@assetsign/pdf/_pdf_style.html.twig' %}
</head>
<body>

{% set technician_name = (technician.firstname|default('') ~ ' ' ~ technician.realname|default(''))|trim %}
{% if technician_name is empty %}{% set technician_name = technician.name|default('-') %}{% endif %}

{% if logo_data_uri or company_name %}
<div class="header-logo">
  {% if logo_data_uri %}<img src="{{ logo_data_uri }}" alt="">{% endif %}
  {% if company_name %}<div class="company-name">{{ company_name }}</div>{% endif %}
</div>
{% endif %}

<h1>{{ __('Fiche de maintenance', 'assetsign') }}</h1>
<p class="meta">{{ __('Établie le %1$s — Référence fiche n°%2$d', 'assetsign')|format(maintenance.date_creation|date('d/m/Y'), maintenance.id) }}</p>

<h2>{{ __('Technicien', 'assetsign') }}</h2>
<table class="info-table">
    <tr><th>{{ __('Nom', 'assetsign') }}</th><td>{{ technician_name }}</td></tr>
</table>

<h2>{{ __('Matériel', 'assetsign') }}</h2>
<table class="info-table">
    <tr><th>{{ __('Type', 'assetsign') }}</th><td>{{ itemtype }}</td></tr>
    <tr><th>{{ __('Nom GLPI', 'assetsign') }}</th><td>{{ item.name }}</td></tr>
    {% if item.manufacturer_name is defined and item.manufacturer_name %}
    <tr><th>{{ __('Marque', 'assetsign') }}</th><td>{{ item.manufacturer_name }}</td></tr>
    {% endif %}
    {% if item.model_name is defined and item.model_name %}
    <tr><th>{{ __('Modèle', 'assetsign') }}</th><td>{{ item.model_name }}</td></tr>
    {% endif %}
    <tr><th>{{ __('N° de série', 'assetsign') }}</th><td>{{ item.serial|default('-') }}</td></tr>
    <tr><th>{{ __('N° d\'inventaire', 'assetsign') }}</th><td>{{ item.otherserial|default('-') }}</td></tr>
</table>

<h2>{{ __('Points de contrôle', 'assetsign') }}</h2>
{% if checklist_results|length %}
<ul class="checklist">
    {% for result in checklist_results %}
    <li>{{ result.name }}{% if result.value is not null and result.value != '' %} : <span class="value">{{ result.value }}</span>{% endif %}</li>
    {% endfor %}
</ul>
{% else %}
<p class="legal-text">{{ __('Aucun point de contrôle validé.', 'assetsign') }}</p>
{% endif %}

{% if comment %}
<h2>{{ __('Commentaire', 'assetsign') }}</h2>
{# Pas de |raw : saisi librement par le technicien, echappement automatique
   de Twig applique normalement (meme raison que beneficiary_comment dans
   handover.html.twig). #}
<p class="legal-text" style="white-space: pre-line;">{{ comment }}</p>
{% endif %}

{% include '@assetsign/pdf/_damage_views.html.twig' %}

{% if signature_required %}
<div class="signature-zone">
    {% if signature_image|default(false) %}
        <p>{{ __('Document signé électroniquement le %1$s à %2$s', 'assetsign')|format(signed_at|date('d/m/Y'), signed_at|date('H:i')) }}</p>
        <img src="{{ signature_image }}" class="signature-img">
        <p class="proof">
            {{ __('Signataire : %s', 'assetsign')|format(technician_name) }}
        </p>
    {% else %}
        <p>{{ __('Fait le %s', 'assetsign')|format(_now) }}</p>
        <p>{{ __('Signature du technicien :', 'assetsign') }} ______________________________</p>
    {% endif %}
</div>
{% endif %}

{% if qr_data_uri %}
<div class="qr-block"><img src="{{ qr_data_uri }}" alt=""></div>
{% endif %}

<div class="footer">{{ __('Fiche de maintenance #%d — Document généré par GLPI (plugin assetsign)', 'assetsign')|format(maintenance.id) }}</div>

</body>
</html>
