{% set _now = "now"|date('d/m/Y') %}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>{{ document_title }}</title>
<style>
    body { font-family: 'DejaVu Sans', sans-serif; font-size: 11px; color: #1c2b3a; }
    h1 { font-size: 18px; margin-bottom: 2px; }
    h2 { font-size: 13px; margin-top: 18px; margin-bottom: 6px; border-bottom: 1px solid #ccc; padding-bottom: 2px; }
    .meta { color: #555; margin-bottom: 14px; }
    table.info-table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
    table.info-table th { text-align: left; width: 35%; padding: 3px 6px; background: #f2f2f2; font-weight: normal; color: #555; }
    table.info-table td { padding: 3px 6px; }
    ul.accessories { margin: 4px 0; padding-left: 18px; }
    .legal-text { font-size: 9.5px; color: #333; line-height: 1.4; text-align: justify; }
    .signature-zone { margin-top: 24px; border-top: 1px solid #ccc; padding-top: 10px; }
    .signature-img { max-width: 220px; max-height: 90px; border-bottom: 1px solid #999; }
    .proof { font-size: 8px; color: #888; margin-top: 6px; }
    .footer { position: fixed; bottom: -20px; left: 0; right: 0; font-size: 8px; color: #999; text-align: center; }
    .header-logo { text-align: right; margin-bottom: 4px; }
    .header-logo img { max-height: 60px; max-width: 220px; }
    .damage-pdf-views { margin-top: 6px; font-size: 0; }
    .damage-pdf-col { display: inline-block; vertical-align: top; width: 31%; margin: 0 3.5% 10px 0; page-break-inside: avoid; font-size: 11px; }
    .damage-pdf-col:last-child { margin-right: 0; }
    .damage-pdf-view { position: relative; }
    .damage-pdf-img { width: 100%; display: block; }
    .damage-pdf-marker { position: absolute; width: 9px; height: 9px; margin-left: -5px; margin-top: -5px; border-radius: 50%; background: rgba(210, 40, 40, 0.85); border: 1px solid #fff; }
    .damage-pdf-marker-major { background: rgba(140, 0, 0, 0.9); }
    .damage-pdf-label { font-size: 9px; color: #555; text-align: center; margin: 4px 0 2px; }
    .damage-pdf-desc { font-size: 8.5px; color: #333; margin: 0; padding-left: 14px; }
</style>
</head>
<body>

{% if logo_data_uri %}
<div class="header-logo"><img src="{{ logo_data_uri }}" alt=""></div>
{% endif %}

<h1>{{ page_title }}</h1>
<p class="meta">Établie le {{ remise.date_creation|date('d/m/Y') }} — Référence remise n°{{ remise.id }}</p>

<h2>Bénéficiaire</h2>
<table class="info-table">
    <tr><th>Nom</th><td>{{ user.firstname }} {{ user.realname }}</td></tr>
    <tr><th>E-mail</th><td>{{ user.email }}</td></tr>
</table>

<h2>{{ material_heading }}</h2>
<table class="info-table">
    <tr><th>Type</th><td>{{ itemtype }}</td></tr>
    <tr><th>Nom GLPI</th><td>{{ item.name }}</td></tr>
    {% if item.manufacturer_name is defined and item.manufacturer_name %}
    <tr><th>Marque</th><td>{{ item.manufacturer_name }}</td></tr>
    {% endif %}
    {% if item.model_name is defined and item.model_name %}
    <tr><th>Modèle</th><td>{{ item.model_name }}</td></tr>
    {% endif %}
    <tr><th>N° de série</th><td>{{ item.serial|default('-') }}</td></tr>
    <tr><th>N° d'inventaire</th><td>{{ item.otherserial|default('-') }}</td></tr>
</table>

{% if accessories|length %}
<h2>Accessoires remis</h2>
<ul class="accessories">
    {% for a in accessories %}<li>{{ a.name }} &times; {{ a.quantity }}{% if a.comment %} — {{ a.comment }}{% endif %}</li>{% endfor %}
</ul>
{% endif %}

{% if vente_price is not null %}
<h2>Détails de la vente</h2>
<table class="info-table">
    <tr><th>Prix</th><td>{{ vente_price|number_format(2, ',', ' ') }} €</td></tr>
    <tr><th>Date de vente</th><td>{{ vente_sale_date|default('-') }}</td></tr>
</table>
{% endif %}

{% if damage_views|length %}
<h2>État des lieux visuel</h2>
<div class="damage-pdf-views">
{% for view in damage_views %}
<div class="damage-pdf-col">
    <div class="damage-pdf-view">
        <img src="{{ view.image_data_uri }}" class="damage-pdf-img">
        {% for marker in view.markers %}
        <div class="damage-pdf-marker{{ marker.severity == 1 ? ' damage-pdf-marker-major' : '' }}"
             style="left: {{ marker.x_percent }}%; top: {{ marker.y_percent }}%;"></div>
        {% endfor %}
    </div>
    <p class="damage-pdf-label">{{ view.label }}</p>
    {% set described = view.markers|filter(m => m.description) %}
    {% if described|length %}
    <ul class="damage-pdf-desc">
        {% for marker in described %}
        <li>{{ marker.description }}{% if marker.severity == 1 %} — majeure{% endif %}</li>
        {% endfor %}
    </ul>
    {% endif %}
</div>
{% endfor %}
</div>
{% endif %}

{% if include_content %}
<h2>Conditions générales</h2>
<div class="legal-text">{{ contract|raw }}</div>
{% endif %}

{% if include_charter and (charter or charter_url) %}
<h2>Charte informatique</h2>
{% if charter %}
<div class="legal-text">{{ charter|raw }}</div>
{% endif %}
{% if charter_url %}
<p class="legal-text">Charte informatique complète : <a href="{{ charter_url|e('html_attr') }}">{{ charter_url }}</a></p>
{% endif %}
{% endif %}

{% if enable_observations and observations %}
<h2>Observations</h2>
{# Pas de |raw ici volontairement : contrairement au contrat/charte (rediges par
   un administrateur de confiance via l'editeur riche du gabarit), ce champ est
   saisi librement par n'importe quel technicien ayant le droit de modification
   sur la fiche — une population moins maitrisee, l'echappement automatique de
   Twig s'applique donc normalement. "white-space: pre-line" (plutot qu'un
   filtre nl2br, absent de Twig par defaut) rend les sauts de ligne saisis par
   l'utilisateur sans avoir a produire du HTML depuis du texte brut. #}
<p class="legal-text" style="white-space: pre-line;">{{ observations }}</p>
{% endif %}

<div class="signature-zone">
    {% if signature_image %}
        <p>Document signé électroniquement le {{ signed_at|date('d/m/Y à H:i') }}</p>
        <img src="{{ signature_image }}" class="signature-img">
        <p class="proof">
            Signataire : {{ user.firstname }} {{ user.realname }} ({{ user.email }})<br>
            Adresse IP : {{ signer_ip }} — Horodatage : {{ signed_at }}
        </p>
    {% else %}
        <p>Fait le {{ _now }}</p>
        <p>Signature de l'utilisateur : ______________________________</p>
    {% endif %}
</div>

<div class="footer">Remise #{{ remise.id }} — Document généré par GLPI (plugin remise)</div>

</body>
</html>
