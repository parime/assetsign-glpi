{% set _now = "now"|date('d/m/Y') %}
<!DOCTYPE html>
<html lang="{{ html_lang|default('fr') }}">
<head>
<meta charset="UTF-8">
<title>{{ document_title }}</title>
{% include '@assetsign/pdf/_pdf_style.html.twig' %}
</head>
<body>

{% if watermark_text is defined and watermark_text %}
{# Uniquement rendu par renderPreview() (jamais renderHtml(), cf. HandoverPdfBuilder) :
   ce gabarit est partage entre l'apercu en direct (rendu par le NAVIGATEUR dans
   une iframe, via front/preview.php - support CSS complet) et le vrai PDF (rendu
   par Dompdf) - ce bloc n'est donc jamais soumis a Dompdf, qui n'a pas a supporter
   position:fixed/transform ici. #}
<div style="position:fixed;top:45%;left:50%;transform:translate(-50%,-50%) rotate(-30deg);font-size:64px;font-weight:bold;color:rgba(200,30,30,{{ (watermark_opacity|default(25)) / 100 }});pointer-events:none;z-index:9999;white-space:nowrap;">{{ watermark_text }}</div>
{% endif %}

{% set beneficiary_name = (user.firstname|default('') ~ ' ' ~ user.realname|default(''))|trim %}
{% if beneficiary_name is empty %}{% set beneficiary_name = user.name %}{% endif %}

{% if logo_data_uri or company_name %}
<div class="header-logo">
  {% if logo_data_uri %}<img src="{{ logo_data_uri }}" alt="">{% endif %}
  {% if company_name %}<div class="company-name">{{ company_name }}</div>{% endif %}
</div>
{% endif %}

<h1>{{ page_title }}</h1>
<p class="meta">{{ __('Établie le %1$s — Référence assetsign n°%2$d', 'assetsign')|format(assetsign.date_creation|date('d/m/Y'), assetsign.id) }}</p>

<h2>{{ beneficiary_is_external|default(false) ? __('Bénéficiaire (externe, sans compte GLPI)', 'assetsign') : __('Bénéficiaire', 'assetsign') }}</h2>
<table class="info-table">
    <tr><th>{{ __('Nom', 'assetsign') }}</th><td>{{ beneficiary_name }}</td></tr>
    <tr><th>{{ beneficiary_is_external|default(false) ? __('Contact', 'assetsign') : __('E-mail', 'assetsign') }}</th><td>{{ user.email|default('') }}</td></tr>
</table>

<h2>{{ material_heading }}</h2>
<table class="info-table">
    <tr><th>{{ __('Type', 'assetsign') }}</th><td>{{ itemtype }}</td></tr>
    <tr><th>{{ __('Nom GLPI', 'assetsign') }}</th><td>{{ item.name|default('') }}</td></tr>
    {% if item.manufacturer_name is defined and item.manufacturer_name %}
    <tr><th>{{ __('Marque', 'assetsign') }}</th><td>{{ item.manufacturer_name }}</td></tr>
    {% endif %}
    {% if item.model_name is defined and item.model_name %}
    <tr><th>{{ __('Modèle', 'assetsign') }}</th><td>{{ item.model_name }}</td></tr>
    {% endif %}
    <tr><th>{{ __('N° de série', 'assetsign') }}</th><td>{{ item.serial|default('-') }}</td></tr>
    <tr><th>{{ __('N° d\'inventaire', 'assetsign') }}</th><td>{{ item.otherserial|default('-') }}</td></tr>
</table>

{% if accessories|length %}
<h2>{{ __('Accessoires remis', 'assetsign') }}</h2>
<ul class="accessories">
    {% for a in accessories %}<li>{{ a.name }} &times; {{ a.quantity }}{% if a.comment %} — {{ a.comment }}{% endif %}</li>{% endfor %}
</ul>
{% endif %}

{% if inventoried_items|default([])|length %}
{# Issue #178 : sur une restitution, etat de chaque element au retour #}
{% set is_return_pdf = (assetsign.type|default(0)) == 1 %}
{% set return_labels = {0: __('À contrôler', 'assetsign'), 1: __('Rendu', 'assetsign'), 2: __('Manquant', 'assetsign'), 3: __('Abîmé', 'assetsign')} %}
<h2>{{ is_return_pdf ? __('Matériel rendu avec', 'assetsign') : __('Matériel inventorié remis avec', 'assetsign') }}</h2>
<table class="data-table">
    <tr><th>{{ __('Type', 'assetsign') }}</th><th>{{ __('Désignation', 'assetsign') }}</th><th>{{ __('Marque / modèle', 'assetsign') }}</th><th>{{ __('N° de série', 'assetsign') }}</th><th>{{ __('N° d\'inventaire', 'assetsign') }}</th>{% if is_return_pdf %}<th>{{ __('État au retour', 'assetsign') }}</th>{% endif %}</tr>
    {% for i in inventoried_items %}
    <tr>
        <td>{{ i.type_label }}</td>
        <td>{{ i.name|default('-') }}</td>
        <td>{{ [i.manufacturer, i.model]|filter(v => v)|join(' ')|default('-') }}</td>
        <td>{{ i.serial|default('-') }}</td>
        <td>{{ i.otherserial|default('-') }}</td>
        {% if is_return_pdf %}<td>{{ return_labels[i.return_state|default(0)] }}{% if i.return_comment|default('') %} — {{ i.return_comment }}{% endif %}</td>{% endif %}
    </tr>
    {% endfor %}
</table>
{% endif %}

{% if vente_price is not null %}
<h2>{{ __('Détails de la vente', 'assetsign') }}</h2>
<table class="info-table">
    <tr><th>{{ __('Prix', 'assetsign') }}</th><td>{{ vente_price|number_format(2, ',', ' ') }} {{ currency_symbol|default('€') }}</td></tr>
    <tr><th>{{ __('Date de vente', 'assetsign') }}</th><td>{{ vente_sale_date|default('-') }}</td></tr>
</table>
{% endif %}

{% if don_organization_name is not null and don_organization_name %}
<h2>{{ __('Détails du don', 'assetsign') }}</h2>
<table class="info-table">
    <tr><th>{{ __('Organisme bénéficiaire', 'assetsign') }}</th><td>{{ don_organization_name }}</td></tr>
</table>
{% endif %}

{% if destruction_provider_name is not null and destruction_provider_name %}
<h2>{{ __('Détails de la destruction', 'assetsign') }}</h2>
<table class="info-table">
    <tr><th>{{ __('Prestataire', 'assetsign') }}</th><td>{{ destruction_provider_name }}</td></tr>
</table>
{% endif %}

{# Issue #193 : pret temporaire #}
{% if loan_until|default(null) %}
<h2>{{ __('Prêt temporaire', 'assetsign') }}</h2>
<table class="info-table">
    <tr><th>{{ __('Retour prévu au plus tard le', 'assetsign') }}</th><td><strong>{{ loan_until }}</strong></td></tr>
</table>
<p class="legal-text">{{ __('Le matériel ci-dessus est prêté pour une durée limitée. Le bénéficiaire s\'engage à le restituer au service informatique au plus tard à cette date, avec les accessoires remis.', 'assetsign') }}</p>
{% endif %}

{% include '@assetsign/pdf/_damage_views.html.twig' %}

{% if include_content %}
<h2>{{ __('Conditions générales', 'assetsign') }}</h2>
<div class="legal-text">{{ contract_safe_html|raw }}</div>
{% endif %}

{% if include_charter and (charter_safe_html or charter_url) %}
<h2>{{ __('Charte informatique', 'assetsign') }}</h2>
{% if charter_safe_html %}
<div class="legal-text">{{ charter_safe_html|raw }}</div>
{% endif %}
{% if charter_url %}
<p class="legal-text">{{ __('Charte informatique complète :', 'assetsign') }} <a href="{{ charter_url|e('html_attr') }}">{{ charter_url }}</a></p>
{% endif %}
{% endif %}

{% if enable_observations and observations %}
<h2>{{ __('Observations', 'assetsign') }}</h2>
{# Pas de |raw ici volontairement : contrairement au contrat/charte (rediges par
   un administrateur de confiance via l'editeur riche du gabarit), ce champ est
   saisi librement par n'importe quel technicien ayant le droit de modification
   sur la fiche — une population moins maitrisee, l'echappement automatique de
   Twig s'applique donc normalement. "white-space: pre-line" (plutot qu'un
   filtre nl2br, absent de Twig par defaut) rend les sauts de ligne saisis par
   l'utilisateur sans avoir a produire du HTML depuis du texte brut. #}
<p class="legal-text" style="white-space: pre-line;">{{ observations }}</p>
{% endif %}

{% if beneficiary_comment|default('') %}
<h2>{{ __('Remarque du bénéficiaire', 'assetsign') }}</h2>
{# Pas de |raw : saisi librement par le beneficiaire lui-meme depuis la page
   de signature, echappement automatique de Twig applique normalement. #}
<p class="legal-text" style="white-space: pre-line;">{{ beneficiary_comment }}</p>
{% endif %}

<div class="signature-zone">
    {% if signature_image|default(false) %}
        <p>{{ __('Document signé électroniquement le %1$s à %2$s', 'assetsign')|format(signed_at|date('d/m/Y'), signed_at|date('H:i')) }}</p>
        <img src="{{ signature_image }}" class="signature-img">
        <p class="proof">
            {# E-mail entre parentheses seulement s'il existe : sinon "()" vide pour tout signataire
               sans adresse e-mail - cas courant depuis les issues #150/#152. #}
            {% set signer_mail = signer_email|default(user.email|default('')) %}
            {{ __('Signataire : %s', 'assetsign')|format(signer_name|default(beneficiary_name)) }}{% if signer_mail is not empty %} ({{ signer_mail }}){% endif %}
        </p>
        {% if witness_name|default('') is not empty %}
        {# Signature sur place (issue #152) : recueillie sur l'ecran d'un technicien, qui atteste
           de l'identite du signataire. Texte fixe en francais, comme le reste du PDF archive. #}
        <p class="proof">{{ __('Signature recueillie sur place, en présence de : %s', 'assetsign')|format(witness_name) }}</p>
        {% endif %}
        {% if delegated_users_id %}
        {# Delegation de signature (issue #115) : delegated_users_id>0 sur une
           fiche SIGNEE est ici une preuve suffisante qu'il s'agissait bien
           d'une signature deleguee — cf. Assetsign::delegateSignatureTo(),
           qui invalide systematiquement l'ancien jeton (celui du beneficiaire
           d'origine) des la delegation : seul le nouveau lien, envoye au
           delegue, peut aboutir a une signature. #}
        <p class="proof">
            {{ __('Signature déléguée par %1$s le %2$s', 'assetsign')|format(delegated_by_name|default(beneficiary_name), delegation_date|date('d/m/Y')) }}{% if delegation_reason %} — {{ __('motif : %s', 'assetsign')|format(delegation_reason) }}{% endif %}
        </p>
        {% endif %}
    {% elseif beneficiary_is_external|default(false) %}
        {# Beneficiaire externe : aucune signature electronique possible (pas
           de compte GLPI pour se connecter), le document genere EST le
           document final des sa creation — pas de ligne de signature vide qui
           laisserait croire qu'une signature reste a recueillir. #}
        <p>{{ __('Fait le %s', 'assetsign')|format(_now) }}</p>
    {% else %}
        <p>{{ __('Fait le %s', 'assetsign')|format(_now) }}</p>
        <p>{{ __('Signature de l\'utilisateur :', 'assetsign') }} ______________________________</p>
    {% endif %}
</div>

{% if cosigner is defined and cosigner %}
{# Signatures multiples (issue #143) : second bloc de signature, uniquement
   present sur le PDF final produit par SignatureStamper::applyCosignature()
   une fois la contre-signature du responsable hierarchique obtenue — jamais
   sur le PDF intermediaire signe par le seul beneficiaire (document_id_signed),
   ni sur une fiche qui ne requiert pas de contre-signature. #}
<div class="signature-zone">
    <p>{{ __('Contre-signé électroniquement le %1$s à %2$s', 'assetsign')|format(cosigner.signed_at|date('d/m/Y'), cosigner.signed_at|date('H:i')) }}</p>
    <img src="{{ cosigner.signature_image }}" class="signature-img">
    <p class="proof">
        {{ __('Responsable hiérarchique : %s', 'assetsign')|format(cosigner.signer_name) }}{% if cosigner.signer_email is not empty %} ({{ cosigner.signer_email }}){% endif %}
    </p>
</div>
{% endif %}

{% if qr_data_uri %}
<div class="qr-block"><img src="{{ qr_data_uri }}" alt=""></div>
{% endif %}

<div class="footer">{{ __('Attribution #%d — Document généré par GLPI (plugin assetsign)', 'assetsign')|format(assetsign.id) }}</div>

</body>
</html>
