{% set _now = "now"|date('d/m/Y') %}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>{{ document_title }}</title>
{% include '@remise/pdf/_pdf_style.html.twig' %}
</head>
<body>

{% if logo_data_uri %}
<div class="header-logo"><img src="{{ logo_data_uri }}" alt=""></div>
{% endif %}

<h1>{{ page_title }}</h1>
<p class="meta">Établie le {{ remise.date_creation|date('d/m/Y') }} — Référence remise n°{{ remise.id }}</p>

<h2>Bénéficiaire{% if beneficiary_is_external %} (externe, sans compte GLPI){% endif %}</h2>
<table class="info-table">
    <tr><th>Nom</th><td>{{ (user.firstname ~ ' ' ~ user.realname)|trim }}</td></tr>
    <tr><th>{{ beneficiary_is_external ? 'Contact' : 'E-mail' }}</th><td>{{ user.email }}</td></tr>
</table>

<h2>{{ material_heading }}</h2>
<table class="info-table">
    <tr><th>Type</th><td>{{ itemtype }}</td></tr>
    <tr><th>Nom GLPI</th><td>{{ item.name }}</td></tr>
    {% if item.manufacturer_name is defined and item.manufacturer_name %}
    <tr><th>Marque</th><td>{{ item.manufacturer_name }}</td></tr>
    {% endif %}
    {% if item.model_name is defined and item.model_name %}
    <tr><th>Modèle</th><td>{{ item.model_name }}</td></tr>
    {% endif %}
    <tr><th>N° de série</th><td>{{ item.serial|default('-') }}</td></tr>
    <tr><th>N° d'inventaire</th><td>{{ item.otherserial|default('-') }}</td></tr>
</table>

{% if accessories|length %}
<h2>Accessoires remis</h2>
<ul class="accessories">
    {% for a in accessories %}<li>{{ a.name }} &times; {{ a.quantity }}{% if a.comment %} — {{ a.comment }}{% endif %}</li>{% endfor %}
</ul>
{% endif %}

{% if vente_price is not null %}
<h2>Détails de la vente</h2>
<table class="info-table">
    <tr><th>Prix</th><td>{{ vente_price|number_format(2, ',', ' ') }} €</td></tr>
    <tr><th>Date de vente</th><td>{{ vente_sale_date|default('-') }}</td></tr>
</table>
{% endif %}

{% include '@remise/pdf/_damage_views.html.twig' %}

{% if include_content %}
<h2>Conditions générales</h2>
<div class="legal-text">{{ contract|raw }}</div>
{% endif %}

{% if include_charter and (charter or charter_url) %}
<h2>Charte informatique</h2>
{% if charter %}
<div class="legal-text">{{ charter|raw }}</div>
{% endif %}
{% if charter_url %}
<p class="legal-text">Charte informatique complète : <a href="{{ charter_url|e('html_attr') }}">{{ charter_url }}</a></p>
{% endif %}
{% endif %}

{% if enable_observations and observations %}
<h2>Observations</h2>
{# Pas de |raw ici volontairement : contrairement au contrat/charte (rediges par
   un administrateur de confiance via l'editeur riche du gabarit), ce champ est
   saisi librement par n'importe quel technicien ayant le droit de modification
   sur la fiche — une population moins maitrisee, l'echappement automatique de
   Twig s'applique donc normalement. "white-space: pre-line" (plutot qu'un
   filtre nl2br, absent de Twig par defaut) rend les sauts de ligne saisis par
   l'utilisateur sans avoir a produire du HTML depuis du texte brut. #}
<p class="legal-text" style="white-space: pre-line;">{{ observations }}</p>
{% endif %}

{% if beneficiary_comment %}
<h2>Remarque du bénéficiaire</h2>
{# Pas de |raw : saisi librement par le beneficiaire lui-meme depuis la page
   de signature, echappement automatique de Twig applique normalement. #}
<p class="legal-text" style="white-space: pre-line;">{{ beneficiary_comment }}</p>
{% endif %}

<div class="signature-zone">
    {% if signature_image %}
        <p>Document signé électroniquement le {{ signed_at|date('d/m/Y à H:i') }}</p>
        <img src="{{ signature_image }}" class="signature-img">
        <p class="proof">
            Signataire : {{ (user.firstname ~ ' ' ~ user.realname)|trim }} ({{ user.email }})
        </p>
    {% elseif beneficiary_is_external %}
        {# Beneficiaire externe : aucune signature electronique possible (pas
           de compte GLPI pour se connecter), le document genere EST le
           document final des sa creation — pas de ligne de signature vide qui
           laisserait croire qu'une signature reste a recueillir. #}
        <p>Fait le {{ _now }}</p>
    {% else %}
        <p>Fait le {{ _now }}</p>
        <p>Signature de l'utilisateur : ______________________________</p>
    {% endif %}
</div>

<div class="footer">Remise #{{ remise.id }} — Document généré par GLPI (plugin remise)</div>

</body>
</html>
