<div class="card">
  <div class="card-body">
    {% if remises|length == 0 %}
      <p>{{ __('Aucune remise enregistrée pour ce matériel.', 'remise') }}</p>
    {% else %}
      <table class="table table-striped">
        <thead>
          <tr>
            <th>{{ __('Statut', 'remise') }}</th>
            <th>{{ __('Créée le', 'remise') }}</th>
            <th>{{ __('Signée le', 'remise') }}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for r in remises %}
          <tr>
            <td>{{ statuses[r.status] }}</td>
            <td>{{ r.date_creation }}</td>
            <td>{{ r.date_signed|default('-') }}</td>
            <td><a href="{{ config('root_doc') }}/plugins/remise/front/remise.form.php?id={{ r.id }}">{{ __('Voir', 'remise') }}</a></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}

    {% if can_create_manual %}
      <hr>
      <form method="post" action="{{ config('root_doc') }}/plugins/remise/front/remise.form.php" class="row g-2 align-items-end" id="remise-manual-form">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="itemtype" value="{{ item.getType() }}">
        <input type="hidden" name="items_id" value="{{ item.getID() }}">
        <div class="col-auto">
          <label class="form-label">{{ __('Type', 'remise') }}</label>
          <select name="type" class="form-select" id="remise-manual-type">
            {% for value, label in manual_types %}
              <option value="{{ value }}">{{ label }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-auto">
          <label class="form-label">{{ __('Destinataire', 'remise') }}</label>
          {{ call('User::dropdown', [{'name': 'users_id'}]) }}
        </div>
        <div class="col-auto remise-manual-vente-field" style="display: none;">
          <label class="form-label">{{ __('Prix', 'remise') }}</label>
          <input type="number" name="price" step="0.01" min="0" class="form-control" style="width: 110px;">
        </div>
        <div class="col-auto remise-manual-vente-field" style="display: none;">
          <label class="form-label">{{ __('Date de vente', 'remise') }}</label>
          <input type="date" name="sale_date" class="form-control">
        </div>
        <div class="col-auto">
          <button type="submit" name="create_manual" class="btn btn-secondary">{{ __('Créer la fiche', 'remise') }}</button>
        </div>
      </form>
      <script>
        (function () {
          var typeSelect = document.getElementById('remise-manual-type');
          var venteFields = document.querySelectorAll('#remise-manual-form .remise-manual-vente-field');
          function toggleVenteFields() {
            var isVente = typeSelect.value === '{{ type_vente }}';
            venteFields.forEach(function (el) { el.style.display = isVente ? '' : 'none'; });
          }
          typeSelect.addEventListener('change', toggleVenteFields);
          toggleVenteFields();
        })();
      </script>
    {% endif %}
  </div>
</div>
