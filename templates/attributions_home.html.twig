{# Issue #282 : en-tête de la liste des attributions (compteurs cliquables, nouvelle attribution). #}
<div class="row row-cards mb-3">
  {% for c in counters %}
    <div class="col-6 col-lg-3">
      <a href="{{ c.url }}" class="card card-sm card-link text-decoration-none h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <span class="avatar {{ c.color }}"><i class="{{ c.icon }} fs-2"></i></span>
          <div>
            <div class="h2 mb-0">{{ c.count }}</div>
            <div class="text-secondary small">{{ c.label }}</div>
          </div>
        </div>
      </a>
    </div>
  {% endfor %}
</div>

{% if can_assign %}
  <div class="card mb-3" style="border-left: 4px solid var(--tblr-primary);">
    <div class="card-header">
      <h3 class="card-title"><i class="ti ti-file-plus me-2"></i>{{ __('Nouvelle attribution', 'assetsign') }}</h3>
    </div>
    <div class="card-body">
      <p class="text-secondary small">{{ __('Choisissez le destinataire et le matériel : la feuille d\'attribution est préparée comme lors d\'une affectation depuis la fiche du matériel.', 'assetsign') }}</p>
      <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/assign_user_asset.php" class="row g-2 align-items-end">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <div class="col-md-4">
          <label class="form-label">{{ __('Destinataire', 'assetsign') }}</label>
          {{ user_html|raw }}
        </div>
        <div class="col-md-3">
          <label class="form-label">{{ __('Type de matériel', 'assetsign') }}</label>
          {{ itemtype_html|raw }}
        </div>
        <div class="col-md-3">
          <label class="form-label">{{ __('Matériel', 'assetsign') }}</label>
          {{ item_html|raw }}
        </div>
        <div class="col-md-2">
          <button type="submit" name="assign" class="btn btn-primary w-100"><i class="ti ti-user-check me-1"></i>{{ __('Assigner', 'assetsign') }}</button>
        </div>
      </form>
    </div>
  </div>
{% endif %}
