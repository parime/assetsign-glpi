{% import '@assetsign/components/_badge_colors.html.twig' as badge_colors %}
{% if can_backfill %}
  <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/passport_backfill.php" class="mb-2">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="users_id" value="{{ users_id }}">
    <button type="submit" class="btn btn-sm btn-outline-secondary">
      <i class="ti ti-history"></i> {{ __('Forcer la recherche dans l\'historique', 'assetsign') }}
    </button>
  </form>
{% endif %}

<div class="passport-summary mb-4">
  <h4>{{ __('Compte', 'assetsign') }}</h4>
  <p class="text-muted">
    {{ __('Entrée', 'assetsign') }} :
    {{ account.start ? account.start|formatted_date : __('inconnue', 'assetsign') }}
    →
    {% if account.end %}
      {{ account.is_deleted ? __('compte supprimé le', 'assetsign') : __('compte désactivé le', 'assetsign') }}
      {{ account.end|formatted_date }}
    {% else %}
      {{ __('compte actif', 'assetsign') }}
    {% endif %}
  </p>
</div>

<h4>{{ __('Historique', 'assetsign') }}</h4>
{% if events|length %}
  <div class="passport-timeline">
    {% for event in events %}
      <div class="passport-timeline-item">
        <div class="passport-timeline-marker">
          {% if loop.first %}
            <span class="passport-timeline-dot"></span>
          {% else %}
            <i class="ti ti-circle-check passport-timeline-check"></i>
          {% endif %}
        </div>
        <div class="passport-timeline-body">
          <div class="passport-timeline-date text-muted small">{{ event.date|relative_datetime }}</div>
          <div class="passport-timeline-content">
            <strong data-assetsign-event="{{ event.key|default(event.event_type|default('')) }}">{{ event.type_label }}</strong>
            -
            {% if event.device_name %}
              {{ event.device_name }}
            {% else %}
              <span class="text-muted" data-assetsign-device-purged="1">{{ __('matériel supprimé', 'assetsign') }}</span>
            {% endif %}
            {% if event.device_serial %}
              <span class="text-muted small">(S/N {{ event.device_serial }})</span>
            {% endif %}
            {% if event.checklist_summary is defined %}
              <div class="mt-1">
                <span data-assetsign-badge="checklist" class="badge {{ badge_colors.classes(event.checklist_summary.color) }}">
                  <i class="ti ti-checklist"></i> {{ event.checklist_summary.done }}/{{ event.checklist_summary.total }} {{ __('contrôles qualité', 'assetsign') }}
                </span>
              </div>
            {% endif %}
            {% if event.kit_summary is defined %}
              <div class="mt-1">
                <span data-assetsign-badge="kit" class="badge {{ badge_colors.classes(event.kit_summary.color) }}" title="{{ event.kit_summary.kit_name }}">
                  <i class="ti ti-package"></i> {{ event.kit_summary.returned_count }}/{{ event.kit_summary.expected_total }} {{ __('accessoires du kit restitués', 'assetsign') }}
                </span>
                {% if event.kit_summary.missing_names|length %}
                  <div class="text-muted small">{{ __('Accessoire(s) manquant(s) :', 'assetsign') }} {{ event.kit_summary.missing_names|join(', ') }}</div>
                {% endif %}
              </div>
            {% endif %}
            {% if event.source_url %}
              <div><a href="{{ event.source_url }}">{{ __('Voir la fiche', 'assetsign') }}</a></div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
{% else %}
  <p class="text-muted" data-assetsign-block="timeline-empty">{{ __('Aucun événement enregistré pour le moment.', 'assetsign') }}</p>
{% endif %}
