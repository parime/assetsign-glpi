{% if can_backfill %}
  <form method="post" action="{{ config('root_doc') }}/plugins/remise/front/passport_backfill.php" class="mb-2">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="users_id" value="{{ users_id }}">
    <button type="submit" class="btn btn-sm btn-outline-secondary">
      <i class="ti ti-history"></i> {{ __('Forcer la recherche dans l\'historique', 'remise') }}
    </button>
  </form>
{% endif %}

<div class="passport-summary mb-4">
  <h4>{{ __('Compte', 'remise') }}</h4>
  <p class="text-muted">
    {{ __('Entrée', 'remise') }} :
    {{ account.start ? account.start|formatted_date : __('inconnue', 'remise') }}
    →
    {% if account.end %}
      {{ account.is_deleted ? __('compte supprimé le', 'remise') : __('compte désactivé le', 'remise') }}
      {{ account.end|formatted_date }}
    {% else %}
      {{ __('compte actif', 'remise') }}
    {% endif %}
  </p>
</div>

<h4>{{ __('Historique', 'remise') }}</h4>
{% if events|length %}
  <div class="passport-timeline">
    {% for event in events %}
      <div class="passport-timeline-item">
        <div class="passport-timeline-marker">
          {% if loop.first %}
            <span class="passport-timeline-dot"></span>
          {% else %}
            <i class="ti ti-circle-check passport-timeline-check"></i>
          {% endif %}
        </div>
        <div class="passport-timeline-body">
          <div class="passport-timeline-date text-muted small">{{ event.date|relative_datetime }}</div>
          <div class="passport-timeline-content">
            <strong>{{ event.type_label }}</strong>
            —
            {% if event.device_name %}
              {{ event.device_name }}
            {% else %}
              <span class="text-muted">{{ __('matériel supprimé', 'remise') }}</span>
            {% endif %}
            {% if event.device_serial %}
              <span class="text-muted small">(S/N {{ event.device_serial }})</span>
            {% endif %}
            {% if event.source_url %}
              <div><a href="{{ event.source_url }}">{{ __('Voir la fiche', 'remise') }}</a></div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
{% else %}
  <p class="text-muted">{{ __('Aucun événement enregistré pour le moment.', 'remise') }}</p>
{% endif %}
