<div class="card mb-3">
  <div class="card-header">{{ __('Nouvelle fiche de maintenance', 'assetsign') }}</div>
  <div class="card-body">
    <form method="post" action="{{ config('root_doc') }}/plugins/assetsign/front/maintenance.form.php" class="row g-3">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">

      <div class="col-md-4">
        <label class="form-label">{{ __('Type de matériel', 'assetsign') }}</label>
        {{ itemtype_dropdown_html|raw }}
      </div>
      <div class="col-md-4">
        <label class="form-label">{{ __('Matériel', 'assetsign') }}</label><br>
        {{ item_dropdown_html|raw }}
      </div>

      <div class="col-12">
        {% if checklist_items|length == 0 %}
          <p class="text-muted">{{ __('Aucun point de contrôle configuré (Configuration > Intitulés > Points de contrôle de maintenance).', 'assetsign') }}</p>
        {% else %}
          {% for id, checklistItem in checklist_items %}
            <div class="mb-2">
              {% if checklistItem.type == 0 %}
                <div class="form-check">
                  <input type="checkbox" name="checklist[{{ id }}]" value="1" class="form-check-input" id="new_checklist_{{ id }}">
                  <label class="form-check-label" for="new_checklist_{{ id }}">{{ checklistItem.name }}</label>
                </div>
              {% elseif checklistItem.type == 1 %}
                <label class="form-label" for="new_checklist_{{ id }}">{{ checklistItem.name }}</label>
                <input type="text" name="checklist[{{ id }}]" class="form-control" id="new_checklist_{{ id }}">
              {% elseif checklistItem.type == 2 %}
                <label class="form-label" for="new_checklist_{{ id }}">{{ checklistItem.name }}</label>
                <select name="checklist[{{ id }}]" class="form-select" id="new_checklist_{{ id }}">
                  <option value="">-----</option>
                  {% for opt in checklistItem.options %}
                    <option value="{{ opt }}">{{ opt }}</option>
                  {% endfor %}
                </select>
              {% endif %}
            </div>
          {% endfor %}
        {% endif %}
      </div>

      <div class="col-12">
        <label class="form-label">{{ __('Commentaire', 'assetsign') }}</label>
        <textarea name="comment" class="form-control" rows="3"></textarea>
      </div>

      <div class="col-12">
        {% include '@assetsign/damage_annotation_edit.html.twig' %}
      </div>

      <div class="col-12">
        {% include '@assetsign/technician_signature_edit.html.twig' %}
      </div>

      <div class="col-12">
        <button type="submit" name="create" class="btn btn-primary">{{ __('Créer la fiche', 'assetsign') }}</button>
      </div>
    </form>
  </div>
</div>
