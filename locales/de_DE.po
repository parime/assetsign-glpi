msgstr "Rückgabe"

msgid "Envoie les relances de signature dues"
msgstr "Sendet fällige Unterschrifts-Erinnerungen"

msgid "Marque comme expirées les remises hors délai"
msgstr "Markiert Übergaben nach Fristablauf als abgelaufen"

msgid "Nouvelle remise de matériel"
msgstr "Neue Geräteübergabe"

msgid "Relance de signature"
msgstr "Unterschrifts-Erinnerung"

