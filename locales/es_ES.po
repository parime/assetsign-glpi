msgstr "donación"

msgid "vente"
msgstr "venta"

msgid "Ce document a déjà été traité."
msgstr "Este documento ya ha sido procesado."

msgid "Ce document ne correspond pas à votre compte utilisateur."
msgstr "Este documento no corresponde a su cuenta de usuario."

msgid "Ce lien de signature a expiré."
msgstr "Este enlace de firma ha caducado."

msgid "Ce lien de signature n'est plus valide."
msgstr "Este enlace de firma ya no es válido."

msgid "Ce type de fiche ne peut pas être créé manuellement."
msgstr "Este tipo de ficha no puede crearse manualmente."

msgid "Cette attribution ne peut plus être relancée (déjà signée ou expirée)."
msgstr "A esta atribución ya no se le puede enviar un recordatorio (ya firmada o caducada)."

msgid "Format de signature invalide."
msgstr "Formato de firma no válido."

msgid "Le bénéficiaire (utilisateur GLPI) est obligatoire."
msgstr "El beneficiario (usuario GLPI) es obligatorio."

msgid "Le nom du bénéficiaire externe est obligatoire."
msgstr "El nombre del beneficiario externo es obligatorio."

msgid "Lien de signature inconnu."
msgstr "Enlace de firma desconocido."

msgid "Matériel introuvable."
msgstr "Equipo no encontrado."

msgid "Attribution introuvable."
msgstr "Atribución no encontrada."

msgid "Signature illisible."
msgstr "Firma ilegible."

msgid "Signature manquante."
msgstr "Falta la firma."

msgid "Signature trop petite, merci de recommencer."
msgstr "Firma demasiado pequeña, inténtelo de nuevo."

msgid "Signature vide ou trop peu tracée, merci de signer à nouveau."
msgstr "Firma vacía o insuficientemente trazada, vuelva a firmar."

msgid "Trop de tentatives, lien désactivé par sécurité."
msgstr "Demasiados intentos, enlace desactivado por seguridad."

msgid "Type de matériel invalide : %s"
msgstr "Tipo de equipo no válido: %s"

msgid "Vous devez être connecté pour accéder à ce document."
msgstr "Debe iniciar sesión para acceder a este documento."

msgid "Échec de la création de la fiche."
msgstr "Error al crear la ficha."

msgid "Variables disponibles, remplacées automatiquement sur le PDF :"
msgstr "Variables disponibles, sustituidas automáticamente en el PDF:"

msgid "Assigner un matériel à cet utilisateur"
msgstr "Asignar un equipo a este usuario"

msgid "L'affectation déclenche automatiquement la création d'une attribution, comme depuis la fiche du matériel."
msgstr "La asignación desencadena automáticamente la creación de una atribución, igual que desde la ficha del equipo."

msgid "Assigner"
msgstr "Asignar"

msgid "Matériel assigné."
msgstr "Equipo asignado."

msgid "Envoyer un e-mail de test"
msgstr "Enviar un correo de prueba"

msgid "Envoie un e-mail à votre propre adresse GLPI, pour vérifier que l'envoi fonctionne."
msgstr "Envía un correo a su propia dirección GLPI, para comprobar que el envío funciona."

msgid "E-mail de test envoyé."
msgstr "Correo de prueba enviado."

msgid "Votre compte GLPI n'a pas d'adresse e-mail enregistrée."
msgstr "Su cuenta GLPI no tiene una dirección de correo registrada."

msgid "Le serveur de messagerie a refusé l'envoi."
msgstr "El servidor de correo ha rechazado el envío."

msgid "E-mail de test — Assetsign & signature"
msgstr "Correo de prueba — Entrega y firma"

msgid "Cet e-mail confirme que la configuration d'envoi du plugin Assetsign & signature fonctionne."
msgstr "Este correo confirma que la configuración de envío del plugin Entrega y firma funciona."

msgid "Afficher un QR code sur les fiches PDF"
msgstr "Mostrar un código QR en las fichas PDF"

msgid "Le QR code renvoie vers la fiche correspondante dans GLPI — pratique pour la retrouver depuis un contrôle physique du matériel."
msgstr "El código QR remite a la ficha correspondiente en GLPI — práctico para localizarla durante un control físico del equipo."

msgid "Symbole monétaire"
msgstr "Símbolo de moneda"

msgid "Affiché après le prix sur la fiche PDF (ex: €, $, CHF)."
msgstr "Se muestra después del precio en la ficha PDF (ej: €, $, CHF)."

msgid "Version du plugin"
msgstr "Versión del plugin"

msgid "Version installée"
msgstr "Versión instalada"

msgid "Dernière version sur GitHub"
msgstr "Última versión en GitHub"

msgid "Texte du filigrane sur l'aperçu"
msgstr "Texto de la marca de agua en la vista previa"

msgid "Opacité du filigrane (%)"
msgstr "Opacidad de la marca de agua (%)"

msgid "Affiché uniquement sur l'aperçu en direct (jamais sur le vrai PDF), pour éviter toute confusion entre les deux."
msgstr "Se muestra solo en la vista previa en directo (nunca en el PDF real), para evitar cualquier confusión entre ambos."
