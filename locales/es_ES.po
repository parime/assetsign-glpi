msgstr "Ficha creada."

msgid "Autoriser la création de fiches de don de matériel"
msgstr "Permitir la creación de fichas de donación de equipo"

msgid "Ajoute un bouton « Créer une fiche de don » sur l'onglet Attribution de chaque matériel géré par le plugin."
msgstr "Añade un botón «Crear una ficha de donación» en la pestaña Atribución de cada equipo gestionado por el plugin."

msgid "Vente"
msgstr "Venta"

msgid "Prix"
msgstr "Precio"

msgid "Date de vente"
msgstr "Fecha de venta"

msgid "Autoriser la création de fiches de vente de matériel"
msgstr "Permitir la creación de fichas de venta de equipo"

msgid "Ajoute un bouton « Créer une fiche de vente » (avec prix et date) sur l'onglet Attribution de chaque matériel géré par le plugin."
msgstr "Añade un botón «Crear una ficha de venta» (con precio y fecha) en la pestaña Atribución de cada equipo gestionado por el plugin."

msgid "État des lieux visuel"
msgstr "Estado del equipo visual"

msgid "État des lieux visuel (annotation de dommages)"
msgstr "Estado del equipo visual (anotación de daños)"

msgid "Permet de repérer des dommages sur 3 vues génériques (arrière, avant, dessous) : reportés sur le PDF pour les fiches signées, et affichés directement sur la fiche pour les fiches de maintenance."
msgstr "Permite señalar daños en 3 vistas genéricas (trasera, delantera, inferior): se reflejan en el PDF para las fichas firmadas, y se muestran directamente en la ficha para las fichas de mantenimiento."

msgid "Cliquez sur une vue pour y déposer un repère de dommage ; cliquez sur un repère existant pour le décrire ou le supprimer, glissez-le pour le repositionner."
msgstr "Haga clic en una vista para colocar una marca de daño; haga clic en una marca existente para describirla o eliminarla, arrástrela para reposicionarla."

msgid "Description"
msgstr "Descripción"

msgid "Gravité"
msgstr "Gravedad"

msgid "Mineure"
msgstr "Leve"

msgid "Majeure"
msgstr "Grave"

