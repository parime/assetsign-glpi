msgstr "Descargar (firmado)"

msgid "Télécharger (non signé)"
msgstr "Descargar (sin firmar)"

msgid "Demande annulée."
msgstr "Solicitud cancelada."

msgid "Retour à l'accueil GLPI"
msgstr "Volver al inicio de GLPI"

msgid "Exemple : petite rayure sur le capot, sans gravité."
msgstr "Ejemplo: pequeño rasguño en la carcasa, sin gravedad."

