msgstr "Technician signature"

#: templates/technician_signature_edit.html.twig
msgid "Signez ci-dessous avant de créer la fiche."
msgstr "Sign below before creating the form."

#: templates/technician_signature_edit.html.twig
msgid "Merci de signer avant de créer la fiche."
msgstr "Please sign before creating the form."

#: templates/passport_tab.html.twig
msgid "Modèle"
msgstr "Model"

#: templates/passport_tab.html.twig
