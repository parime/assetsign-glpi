#: templates/passport_tab.html.twig
msgid "Valeur résiduelle (saisie manuelle)"
msgstr "Residual value (manual entry)"

#: templates/passport_tab.html.twig
msgid "Valeur résiduelle (estimée)"
msgstr "Residual value (estimated)"

#: templates/passport_tab.html.twig
msgid "Valeur résiduelle manuelle"
msgstr "Manual residual value"

#: templates/passport_tab.html.twig
msgid "Revenir au calcul automatique"
msgstr "Return to automatic calculation"

#: templates/passport_tab.html.twig
msgid "Une valeur saisie ici l'emporte toujours sur le calcul automatique."
msgstr ""
"A value entered here always takes precedence over the automatic calculation."

#: templates/passport_tab.html.twig
msgid "de dégradation"
msgstr "degradation"

#: templates/passport_tab.html.twig
msgid "poids"
msgstr "weight"

#: templates/passport_tab.html.twig templates/passport_user_tab.html.twig
msgid "Forcer la recherche dans l'historique"
msgstr "Force a search in the history"

#: templates/passport_tab.html.twig
msgid "Imprimer une étiquette QR code"
msgstr "Print a QR code label"

#: templates/passport_tab.html.twig
msgid "Vies du matériel"
msgstr "Equipment's lifecycles"

#: templates/passport_tab.html.twig
