msgid ""
"%1$s a signé la restitution de son matériel le %2$s. Le document signé est "
"joint au départ."
msgstr ""
"%1$s podpisał(a) zwrot swojego sprzętu dnia %2$s. Podpisany dokument jest "
"załączony do odejścia."

msgid ""
"Le départ a été annulé dans assetsign : les fiches de restitution en attente "
"sont annulées."
msgstr ""
"Odejście zostało anulowane w assetsign: oczekujące formularze zwrotu zostały "
"anulowane."

msgid ""
"Jour du départ : plus aucun matériel n'est affecté à la personne dans GLPI."
msgstr "Dzień odejścia: tej osobie nie przypisano już w GLPI żadnego sprzętu."

