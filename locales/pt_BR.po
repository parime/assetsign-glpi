#, php-format
msgid ""
"La feuille n° %1$d (%2$s) pour %3$s « %4$s » a été signée. Le document signé "
"est joint au ticket."
msgstr ""
"O termo nº %1$d (%2$s) referente a %3$s “%4$s” foi assinado. O documento "
"assinado está anexado ao chamado."

msgid ""
"Le ticket n'a pas pu être résolu automatiquement après la signature (un champ"
" obligatoire du ticket n'est sans doute pas renseigné, comme la catégorie) : "
"résolvez-le manuellement."
msgstr ""
"Não foi possível solucionar o chamado automaticamente após a assinatura "
"(provavelmente um campo obrigatório do chamado está vazio, como a categoria):"
" solucione-o manualmente."

msgid "Feuille rattachée au ticket."
msgstr "Termo vinculado ao chamado."

msgid "Feuille détachée du ticket."
msgstr "Termo desvinculado do chamado."

msgid ""
"Feuille préparée en brouillon et rattachée au ticket : complétez-la puis "
"envoyez-la."
msgstr ""
"Termo preparado como rascunho e vinculado ao chamado: complete-o e depois "
"envie-o."

msgid "Compléter et envoyer"
msgstr "Completar e enviar"

msgid "Aucune feuille de remise rattachée à ce ticket."
msgstr "Nenhum termo de entrega vinculado a este chamado."

msgid "Remettre du matériel au demandeur"
msgstr "Entregar equipamento ao requerente"

