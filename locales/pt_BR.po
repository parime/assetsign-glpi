msgstr "Voltar à lista"

msgid "Saisissez au moins deux caractères du nom, du n° de série ou du n° d'inventaire."
msgstr "Digite pelo menos dois caracteres do nome, do n.º de série ou do n.º de inventário."

msgid "Vendre le matériel, avec son prix et sa date de vente."
msgstr "Vender o equipamento, com o preço e a data de venda."

