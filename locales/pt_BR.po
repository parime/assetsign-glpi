msgstr "Ficha %1$s criada pelo AssetSign, referência %2$s"

msgid "Les réglages de référence précédents sont conservés."
msgstr "As configurações de referência anteriores são mantidas."

#, php-format
msgid "Préfixe refusé : %d caractères au plus, lettres sans accent, chiffres, tiret ou souligné, en commençant par une lettre ou un chiffre."
msgstr "Prefixo recusado: no máximo %d caracteres, letras sem acento, dígitos, hífen ou sublinhado, começando por uma letra ou um dígito."

#, php-format
msgid "Format de référence refusé : %d caractères au plus."
msgstr "Formato de referência recusado: no máximo %d caracteres."

#, php-format
msgid "Format de référence refusé : marqueur inconnu. Marqueurs admis : %s."
msgstr "Formato de referência recusado: marcador desconhecido. Marcadores permitidos: %s."

msgid "Format de référence refusé : il doit contenir {seq} ou {aleatoire}."
msgstr "Formato de referência recusado: ele deve conter {seq} ou {aleatoire}."

msgid "Format de référence refusé : pour recommencer à 1 chaque année, le format doit contenir {annee}."
msgstr "Formato de referência recusado: para recomeçar em 1 a cada ano, o formato deve conter {annee}."

msgid "Format de référence refusé : en dehors des marqueurs, seuls les lettres sans accent, les chiffres, le tiret et le souligné sont admis."
msgstr "Formato de referência recusado: fora dos marcadores, apenas letras sem acento, dígitos, hífen e sublinhado são permitidos."

msgid "Référence de document"
msgstr "Referência do documento"

