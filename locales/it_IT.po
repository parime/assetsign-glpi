msgstr "Scheda creata."

msgid "Autoriser la création de fiches de don de matériel"
msgstr "Consentire la creazione di schede di donazione di dispositivi"

msgid "Ajoute un bouton « Créer une fiche de don » sur l'onglet Remise de chaque matériel géré par le plugin."
msgstr "Aggiunge un pulsante «Crea una scheda di donazione» nella scheda Consegna di ogni dispositivo gestito dal plugin."

msgid "Vente"
msgstr "Vendita"

msgid "Prix"
msgstr "Prezzo"

msgid "Date de vente"
msgstr "Data di vendita"

msgid "Autoriser la création de fiches de vente de matériel"
msgstr "Consentire la creazione di schede di vendita di dispositivi"

msgid "Ajoute un bouton « Créer une fiche de vente » (avec prix et date) sur l'onglet Remise de chaque matériel géré par le plugin."
msgstr "Aggiunge un pulsante «Crea una scheda di vendita» (con prezzo e data) nella scheda Consegna di ogni dispositivo gestito dal plugin."

msgid "État des lieux visuel"
msgstr "Stato visivo del dispositivo"

msgid "État des lieux visuel (annotation de dommages)"
msgstr "Stato visivo del dispositivo (annotazione danni)"

msgid "Permet de repérer des dommages sur 3 vues génériques (arrière, avant, dessous) : reportés sur le PDF pour les fiches signées, et affichés directement sur la fiche pour les fiches de maintenance."
msgstr "Permette di segnalare danni su 3 viste generiche (retro, fronte, sotto): riportati sul PDF per le schede firmate, e mostrati direttamente sulla scheda per le schede di manutenzione."

msgid "Cliquez sur une vue pour y déposer un repère de dommage ; cliquez sur un repère existant pour le décrire ou le supprimer, glissez-le pour le repositionner."
msgstr "Fare clic su una vista per posizionare un indicatore di danno; fare clic su un indicatore esistente per descriverlo o eliminarlo, trascinarlo per riposizionarlo."

msgid "Description"
msgstr "Descrizione"

msgid "Gravité"
msgstr "Gravità"

msgid "Mineure"
msgstr "Minore"

msgid "Majeure"
msgstr "Maggiore"

msgid "Cette fiche ne peut plus être modifiée."
msgstr "Questa scheda non può più essere modificata."

msgid "Dessous"
msgstr "Sotto"

