msgid "vente"
msgstr "vendita"

msgid "Ce document a déjà été traité."
msgstr "Questo documento è già stato elaborato."

msgid "Ce document ne correspond pas à votre compte utilisateur."
msgstr "Questo documento non corrisponde al vostro account utente."

msgid "Ce lien de signature a expiré."
msgstr "Questo link di firma è scaduto."

msgid "Ce lien de signature n'est plus valide."
msgstr "Questo link di firma non è più valido."

msgid "Ce type de fiche ne peut pas être créé manuellement."
msgstr "Questo tipo di scheda non può essere creato manualmente."

msgid "Cette remise ne peut plus être relancée (déjà signée ou expirée)."
msgstr "Questa consegna non può più essere sollecitata (già firmata o scaduta)."

msgid "Format de signature invalide."
msgstr "Formato di firma non valido."

msgid "Le bénéficiaire (utilisateur GLPI) est obligatoire."
msgstr "Il beneficiario (utente GLPI) è obbligatorio."

msgid "Le nom du bénéficiaire externe est obligatoire."
msgstr "Il nome del beneficiario esterno è obbligatorio."

msgid "Lien de signature inconnu."
msgstr "Link di firma sconosciuto."

msgid "Matériel introuvable."
msgstr "Dispositivo non trovato."

msgid "Remise introuvable."
msgstr "Consegna non trovata."

msgid "Signature illisible."
msgstr "Firma illeggibile."

msgid "Signature manquante."
msgstr "Firma mancante."

msgid "Signature trop petite, merci de recommencer."
msgstr "Firma troppo piccola, riprovare."

msgid "Signature vide ou trop peu tracée, merci de signer à nouveau."
msgstr "Firma vuota o tracciata in modo insufficiente, firmare nuovamente."

msgid "Trop de tentatives, lien désactivé par sécurité."
msgstr "Troppi tentativi, link disattivato per sicurezza."

msgid "Type de matériel invalide : %s"
msgstr "Tipo di dispositivo non valido: %s"

msgid "Vous devez être connecté pour accéder à ce document."
msgstr "È necessario essere connessi per accedere a questo documento."

msgid "Échec de la création de la fiche."
msgstr "Creazione della scheda non riuscita."

msgid "Variables disponibles, remplacées automatiquement sur le PDF :"
msgstr "Variabili disponibili, sostituite automaticamente sul PDF:"

msgid "Assigner un matériel à cet utilisateur"
msgstr "Assegna un dispositivo a questo utente"

msgid "L'affectation déclenche automatiquement la création d'une remise, comme depuis la fiche du matériel."
msgstr "L'assegnazione attiva automaticamente la creazione di una consegna, come dalla scheda del dispositivo."

msgid "Assigner"
msgstr "Assegna"

msgid "Matériel assigné."
msgstr "Dispositivo assegnato."

msgid "Envoyer un e-mail de test"
msgstr "Invia un'e-mail di prova"

msgid "Envoie un e-mail à votre propre adresse GLPI, pour vérifier que l'envoi fonctionne."
msgstr "Invia un'e-mail al proprio indirizzo GLPI, per verificare che l'invio funzioni."

msgid "E-mail de test envoyé."
msgstr "E-mail di prova inviata."

msgid "Votre compte GLPI n'a pas d'adresse e-mail enregistrée."
msgstr "Il vostro account GLPI non ha un indirizzo e-mail registrato."

msgid "Le serveur de messagerie a refusé l'envoi."
msgstr "Il server di posta ha rifiutato l'invio."

msgid "E-mail de test — Remise & signature"
msgstr "E-mail di prova — Consegna e firma"

msgid "Cet e-mail confirme que la configuration d'envoi du plugin Remise & signature fonctionne."
msgstr "Questa e-mail conferma che la configurazione di invio del plugin Consegna e firma funziona."

msgid "Afficher un QR code sur les fiches PDF"
msgstr "Mostra un codice QR sulle schede PDF"

msgid "Le QR code renvoie vers la fiche correspondante dans GLPI — pratique pour la retrouver depuis un contrôle physique du matériel."
msgstr "Il codice QR rimanda alla scheda corrispondente in GLPI — comodo per ritrovarla durante un controllo fisico del dispositivo."

msgid "Symbole de devise"
msgstr "Simbolo di valuta"

msgid "Affiché après le prix sur la fiche PDF (ex: €, $, CHF)."
msgstr "Mostrato dopo il prezzo sulla scheda PDF (es: €, $, CHF)."
