{
    "name": "parime/remise-glpi",
    "description": "Gestion des remises de materiel avec signature electronique et tracabilite pour GLPI",
    "type": "glpi-plugin",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Vincent GUILLOTTE"
        }
    ],
    "require": {
        "php": ">=8.3",
        "dompdf/dompdf": "^3.0"
    },
    "require-dev": {
        "glpi-project/coding-standard": "^0.9.0",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "GlpiPlugin\\Remise\\": "src/GlpiPlugin/Remise/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GlpiPlugin\\Remise\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
