parameters:
    level: 5
    paths:
        - src
        - front
        - hook.php
        - setup.php
    bootstrapFiles:
        - .phpstan-bootstrap.php
    ignoreErrors:
        -
            # Les methodes de hook GLPI (getTabNameForItem, displayTabContentForItem,
            # processMassiveActionsForOneItemtype) typent obligatoirement leur
            # parametre a la classe parente (CommonGLPI/CommonDBTM) pour respecter
            # la signature exacte imposee par le coeur GLPI - alors meme que ce
            # plugin ne les enregistre (Plugin::registerClass) que pour des
            # itemtypes concrets qui possedent reellement ces methodes. Faux
            # positif garanti par construction, jamais atteignable avec un autre
            # type a l'execution.
            message: '#Call to an undefined method (CommonGLPI|CommonDBTM)::(getID|sendReminderNow|cancelRequest)\(\)#'
            paths:
                - src/GlpiPlugin/Assetsign/Assetsign.php
                - src/GlpiPlugin/Assetsign/Config.php
                - src/GlpiPlugin/Assetsign/Maintenance.php

        -
            # GLPI_VERSION est un vrai define() du coeur GLPI, resolu ici par le bootstrap au tres
            # reel autoload de l'instance qui tourne pendant l'analyse (11.0.9 dans ce conteneur) -
            # PHPStan la traite donc comme une constante litterale FIGEE et juge la comparaison a
            # PLUGIN_ASSETSIGN_MAX_GLPI ('11.9.99') toujours fausse. Faux positif garanti : sur une
            # vraie installation GLPI 12+, exactement le cas que cette ligne existe pour intercepter,
            # GLPI_VERSION vaudrait autre chose et la comparaison serait vraie - confirme en direct
            # contre un conteneur GLPI 12.0.0-rc2 reel (installation refusee proprement grace a
            # cette ligne, plutot que le plantage fatal qu'elle corrige).
            identifier: if.alwaysFalse
            path: setup.php
