parameters:
    level: 5
    paths:
        - src
        - front
        - hook.php
        - setup.php
    bootstrapFiles:
        - .phpstan-bootstrap.php
    # Traits de compatibilite (cf. src/GlpiPlugin/Assetsign/Compat/) : charges par un
    # require dynamique que PHPStan ne suit pas. L'analyse tourne contre un vrai coeur
    # GLPI 11, donc seule la variante 11 est decouverte (la variante 12 redeclarerait
    # les memes symboles).
    scanDirectories:
        - compat/glpi11
    ignoreErrors:
        -
            # Les methodes de hook GLPI (getTabNameForItem, displayTabContentForItem,
            # processMassiveActionsForOneItemtype) typent obligatoirement leur
            # parametre a la classe parente (CommonGLPI/CommonDBTM) pour respecter
            # la signature exacte imposee par le coeur GLPI - alors meme que ce
            # plugin ne les enregistre (Plugin::registerClass) que pour des
            # itemtypes concrets qui possedent reellement ces methodes. Faux
            # positif garanti par construction, jamais atteignable avec un autre
            # type a l'execution.
            message: '#Call to an undefined method (CommonGLPI|CommonDBTM)::(getID|sendReminderNow|cancelRequest)\(\)#'
            paths:
                - src/GlpiPlugin/Assetsign/Assetsign.php
                - src/GlpiPlugin/Assetsign/Config.php
                - src/GlpiPlugin/Assetsign/Maintenance.php

        -
            # GLPI_VERSION est un vrai define() du coeur GLPI, resolu ici par le bootstrap au tres
            # reel autoload de l'instance qui tourne pendant l'analyse (11.0.9 dans ce conteneur) -
            # PHPStan la traite donc comme une constante litterale FIGEE et juge la comparaison a
            # PLUGIN_ASSETSIGN_MAX_GLPI ('12.99.99') toujours fausse. Faux positif garanti : sur une
            # vraie installation d'une future version majeure non verifiee, exactement le cas que
            # cette ligne existe pour intercepter, GLPI_VERSION vaudrait autre chose et la
            # comparaison serait vraie.
            identifier: if.alwaysFalse
            path: setup.php
        -
            # Meme faux positif que ci-dessus : GLPI_VERSION figee a 11.0.9 pendant l'analyse, la
            # detection de GLPI 12 (Compat\GlpiVersion::isAtLeast12()) parait donc toujours fausse
            # - elle est pourtant vraie sur une vraie instance GLPI 12 (verifie en direct).
            identifier: booleanAnd.rightAlwaysFalse
            path: src/GlpiPlugin/Assetsign/Compat/GlpiVersion.php
